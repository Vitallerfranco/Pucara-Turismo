---
interface Props {
  scrolled?: boolean;
}

const { scrolled = false } = Astro.props;
---

<header 
  class:list={[
    "fixed top-0 left-0 right-0 z-50 h-18 flex items-center transition-all duration-300",
    scrolled 
      ? "bg-white/95 backdrop-blur-md shadow-sm border-b border-slate-100" 
      : "bg-gradient-to-b from-black/20 to-transparent"
  ]}
>
  <div class="container-gutter w-full flex items-center justify-between">
    {/* Logo */}
    <a href="/Pucara-Turismo/" class="flex items-center hover:opacity-80 transition-opacity">
  <img src="/Pucara-Turismo/logo.png" alt="Pucará Turismo" class="h-12 w-auto" />
</a>

    {/* Navigation */}
    <nav class="hidden md:flex items-center gap-8">
      <a 
        href="/Pucara-Turismo/destinos"
        class:list={[
          "text-sm font-medium transition-colors",
          scrolled ? "text-slate-700 hover:text-orange-500" : "text-white/85 hover:text-orange-300"
        ]}
      >
        Destinos
      </a>
      <a 
        href="/Pucara-Turismo/paquetes"
        class:list={[
          "text-sm font-medium transition-colors",
          scrolled ? "text-slate-700 hover:text-orange-500" : "text-white/85 hover:text-orange-300"
        ]}
      >
        Paquetes
      </a>
      <a 
        href="/Pucara-Turismo/#faq"
        class:list={[
          "text-sm font-medium transition-colors",
          scrolled ? "text-slate-700 hover:text-orange-500" : "text-white/85 hover:text-orange-300"
        ]}
      >
        Preguntas
      </a>
      <a 
        href="/Pucara-Turismo/#sobre"
        class:list={[
          "text-sm font-medium transition-colors",
          scrolled ? "text-slate-700 hover:text-orange-500" : "text-white/85 hover:text-orange-300"
        ]}
      >
        Nosotros
      </a>
    </nav>

    {/* CTA Button */}
    <a 
      href="https://wa.me/5491150000000?text=Hola%20Pucará%20Turismo,%20quiero%20consultar%20disponibilidad"
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-primary btn-sm"
    >
      <span>💬 Consultar</span>
    </a>
  </div>
</header>

<style>
  header {
    padding-left: var(--gutter);
    padding-right: var(--gutter);
  }
</style>

