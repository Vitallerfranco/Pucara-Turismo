---
interface Props {
  scrolled?: boolean;
}

const { scrolled = false } = Astro.props;
---

<header 
  class:list={[
    "fixed top-0 left-0 right-0 z-50 h-18 flex items-center transition-all duration-300",
    scrolled 
      ? "bg-white/95 backdrop-blur-md shadow-sm border-b border-slate-100" 
      : "bg-gradient-to-b from-black/20 to-transparent"
  ]}
>
  <div class="container-gutter w-full flex items-center justify-between">
    {/* Logo */}
    <a href="/" class="flex items-center gap-2 hover:opacity-80 transition-opacity">
      <div class="w-10 h-10 bg-orange-500 rounded-full flex items-center justify-center">
        <span class="text-white font-bold text-xl">🏔️</span>
      </div>
      <span class:list={[
        "font-montserrat font-800 text-xl tracking-tight",
        scrolled ? "text-black" : "text-white"
      ]}>
        Pucará
      </span>
    </a>

    {/* Navigation */}
    <nav class="hidden md:flex items-center gap-8">
      <a 
        href="/destinos"
        class:list={[
          "text-sm font-medium transition-colors",
          scrolled ? "text-slate-700 hover:text-orange-500" : "text-white/85 hover:text-orange-300"
        ]}
      >
        Destinos
      </a>
      <a 
        href="/paquetes"
        class:list={[
          "text-sm font-medium transition-colors",
          scrolled ? "text-slate-700 hover:text-orange-500" : "text-white/85 hover:text-orange-300"
        ]}
      >
        Paquetes
      </a>
      <a 
        href="/#faq"
        class:list={[
          "text-sm font-medium transition-colors",
          scrolled ? "text-slate-700 hover:text-orange-500" : "text-white/85 hover:text-orange-300"
        ]}
      >
        Preguntas
      </a>
      <a 
        href="/#sobre"
        class:list={[
          "text-sm font-medium transition-colors",
          scrolled ? "text-slate-700 hover:text-orange-500" : "text-white/85 hover:text-orange-300"
        ]}
      >
        Nosotros
      </a>
    </nav>

    {/* CTA Button */}
    <a 
      href="https://wa.me/5491150000000?text=Hola%20Pucará%20Turismo,%20quiero%20consultar%20disponibilidad"
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-primary btn-sm"
    >
      <span>💬 Consultar</span>
    </a>
  </div>
</header>

<style>
  header {
    padding-left: var(--gutter);
    padding-right: var(--gutter);
  }
</style>
