---
const path = Astro.url.pathname;
const active = (base: string) => path === base || path === base + '/' || path.startsWith(base + '/');
const WA = '5491134952847';
---

<header class="cabecera">
  <div class="cabecera-caja">

    <a href="/" class="marca" aria-label="Pucará Turismo, ir al inicio">
      <img src="/isologopucara.png" alt="Pucará Turismo" width="250" height="125" />
    </a>

    <nav class="nav-escritorio" aria-label="Principal">
      <a href="/paquetes/" class="nav-link" aria-current={active('/paquetes') ? 'page' : undefined}>Viajes</a>
      <a href="/resenas/" class="nav-link" aria-current={active('/resenas') ? 'page' : undefined}>Reseñas</a>
      <a href="/faq/" class="nav-link" aria-current={active('/faq') ? 'page' : undefined}>Preguntas</a>
      <a href="/contacto/" class="nav-link" aria-current={active('/contacto') ? 'page' : undefined}>Contacto</a>
    </nav>

    <div class="cabecera-acciones">
      <a href={`https://wa.me/${WA}`} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm wa-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.5 14.4c-.3-.2-1.7-.9-2-1-.3-.1-.5-.1-.7.2-.2.3-.7 1-.9 1.1-.2.2-.3.2-.6.1-.3-.2-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.5c.1-.2.2-.3.3-.5 0-.2 0-.4 0-.5 0-.2-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.4s1.1 2.8 1.2 3c.2.2 2.1 3.2 5.1 4.4.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.7-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.3-.6-.4z"/>
          <path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3.1.8.8-3-.2-.3A8.2 8.2 0 1 1 12 20.2z"/>
        </svg>
        Consultar
      </a>
      <button id="menu-toggle" class="hamburguesa" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
        <span id="bar1"></span>
        <span id="bar2"></span>
        <span id="bar3"></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu">
    <nav class="nav-movil" aria-label="Principal (celular)">
      <a href="/paquetes/">Viajes</a>
      <a href="/resenas/">Reseñas</a>
      <a href="/faq/">Preguntas</a>
      <a href="/contacto/">Contacto</a>
      <a href={`https://wa.me/${WA}`} target="_blank" rel="noopener noreferrer" class="btn btn-primary nav-movil-wa">
        Consultar por WhatsApp
      </a>
    </nav>
  </div>
</header>

<style>
  .cabecera {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 50;
    background: rgba(255,255,255,0.9);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--linea);
  }
  .cabecera-caja {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 1.25rem;
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  @media (min-width: 768px) { .cabecera-caja { padding: 0 2rem; } }

  .marca { display: flex; align-items: center; flex: none; }
  .marca img { height: 42px; width: auto; }

  .nav-escritorio { display: none; align-items: center; gap: 2rem; }
  @media (min-width: 900px) { .nav-escritorio { display: flex; } }

  .nav-link {
    position: relative;
    color: var(--tinta-2);
    font-size: 0.925rem;
    font-weight: 500;
    padding: 0.4rem 0;
  }
  .nav-link:hover { color: var(--tinta); }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: -2px;
    height: 2px;
    background: var(--naranja-fuerte);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.22s ease;
  }
  .nav-link:hover::after,
  .nav-link[aria-current="page"]::after { transform: scaleX(1); }
  .nav-link[aria-current="page"] { color: var(--tinta); font-weight: 600; }

  .cabecera-acciones { display: flex; align-items: center; gap: 0.6rem; }
  .wa-btn { display: none; }
  @media (min-width: 560px) { .wa-btn { display: inline-flex; } }

  .hamburguesa {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px; height: 40px;
    padding: 0 9px;
    background: none;
    border: 1px solid var(--linea);
    border-radius: var(--radio-ch);
    cursor: pointer;
  }
  @media (min-width: 900px) { .hamburguesa { display: none; } }
  .hamburguesa span {
    display: block;
    height: 1.5px;
    width: 100%;
    background: var(--tinta);
    transform-origin: center;
    transition: transform 0.28s ease, opacity 0.18s ease;
  }
  .hamburguesa.is-open #bar1 { transform: translateY(6.5px) rotate(45deg); }
  .hamburguesa.is-open #bar2 { opacity: 0; }
  .hamburguesa.is-open #bar3 { transform: translateY(-6.5px) rotate(-45deg); }

  #mobile-menu {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    background: var(--papel);
    transition: max-height 0.3s ease, opacity 0.3s ease;
  }
  #mobile-menu.open { max-height: 380px; opacity: 1; border-top: 1px solid var(--linea); }
  @media (min-width: 900px) { #mobile-menu { display: none; } }

  .nav-movil { display: flex; flex-direction: column; padding: 0.5rem 1.25rem 1.25rem; }
  .nav-movil a {
    color: var(--tinta);
    font-size: 1rem;
    font-weight: 500;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--linea);
  }
  .nav-movil-wa { margin-top: 1rem; border-bottom: none !important; color: #fff !important; }

  @media (prefers-reduced-motion: reduce) {
    #mobile-menu, .hamburguesa span, .nav-link::after { transition: none; }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  const setMenu = (open: boolean) => {
    menu?.classList.toggle('open', open);
    toggle?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
  };

  toggle?.addEventListener('click', () => {
    setMenu(!menu?.classList.contains('open'));
  });

  menu?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => setMenu(false));
  });
</script>
