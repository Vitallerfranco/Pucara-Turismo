---
---

<footer style="background: #0e0e0e; border-top: 1px solid rgba(255,255,255,0.06); color: rgba(255,255,255,0.75);" class="py-16 md:py-20">
  <div class="container-gutter">

    {/* Main grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-14">

      {/* Brand */}
      <div>
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
          <img
            src="/isologopucara.png"
            alt="Pucará Turismo"
            style="height:48px;width:auto;object-fit:contain;"
            onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
          />
          <div style="background:#f97316;border-radius:10px;width:40px;height:40px;display:none;align-items:center;justify-content:center;">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8 3L2 21h20L14 3z"/><path d="M12 8l-2 5h4z"/>
            </svg>
          </div>
        </div>
        <p style="font-size: 0.82rem; color: rgba(255,255,255,0.35); line-height: 1.75; margin-bottom: 1.25rem; max-width: 260px;">
          Somos una agencia de turismo con más de 15 años organizando viajes grupales por Argentina. Nos especializamos en escapadas de fin de semana, vacaciones de invierno y experiencias en termas, playas y montaña — con todo incluido y salidas desde zona oeste del Gran Buenos Aires.
        </p>

        {/* Social buttons */}
        <div class="flex gap-3">
          <a href="https://www.instagram.com/pucaraturismo.ok/" target="_blank" rel="noopener noreferrer"
            style="width:40px;height:40px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:10px;display:flex;align-items:center;justify-content:center;transition:all 0.2s ease;color:rgba(255,255,255,0.6);"
            onmouseover="this.style.background='#f97316';this.style.borderColor='#f97316';this.style.color='white'"
            onmouseout="this.style.background='rgba(255,255,255,0.05)';this.style.borderColor='rgba(255,255,255,0.1)';this.style.color='rgba(255,255,255,0.6)'"
            title="Instagram">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/>
            </svg>
          </a>
          <a href="https://www.facebook.com/Pucaraturismo" target="_blank" rel="noopener noreferrer"
            style="width:40px;height:40px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:10px;display:flex;align-items:center;justify-content:center;transition:all 0.2s ease;color:rgba(255,255,255,0.6);"
            onmouseover="this.style.background='#f97316';this.style.borderColor='#f97316';this.style.color='white'"
            onmouseout="this.style.background='rgba(255,255,255,0.05)';this.style.borderColor='rgba(255,255,255,0.1)';this.style.color='rgba(255,255,255,0.6)'"
            title="Facebook">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
            </svg>
          </a>
          <a href="https://wa.me/5491134952847" target="_blank" rel="noopener noreferrer"
            style="width:40px;height:40px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:10px;display:flex;align-items:center;justify-content:center;transition:all 0.2s ease;color:rgba(255,255,255,0.6);"
            onmouseover="this.style.background='#f97316';this.style.borderColor='#f97316';this.style.color='white'"
            onmouseout="this.style.background='rgba(255,255,255,0.05)';this.style.borderColor='rgba(255,255,255,0.1)';this.style.color='rgba(255,255,255,0.6)'"
            title="WhatsApp">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
            </svg>
          </a>
        </div>
      </div>

      {/* Destinations */}
      <div>
        <h4 style="font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; color: rgba(255,255,255,0.35); margin-bottom: 20px;">DESTINOS</h4>
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px;">
          {[
            { href: '/Pucara-Turismo/destinos/mar-del-plata', label: 'Mar del Plata' },
            { href: '/Pucara-Turismo/destinos/colon-entre-rios', label: 'Colón + Termas' },
            { href: '/Pucara-Turismo/destinos/rio-hondo', label: 'Termas de Río Hondo' },
            { href: '/Pucara-Turismo/destinos/san-bernardo', label: 'San Bernardo' },
            { href: '/Pucara-Turismo/destinos/la-falda', label: 'La Falda, Córdoba' },
            { href: '/Pucara-Turismo/destinos/mendoza', label: 'Uspallata, Mendoza' },
          ].map(link => (
            <li key={link.href}>
              <a href={link.href}
                style="font-size: 0.875rem; color: rgba(255,255,255,0.45); transition: color 0.2s ease; text-decoration: none;"
                onmouseover="this.style.color='#fb923c'"
                onmouseout="this.style.color='rgba(255,255,255,0.45)'"
              >{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      {/* Info */}
      <div>
        <h4 style="font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; color: rgba(255,255,255,0.35); margin-bottom: 20px;">INFORMACIÓN</h4>
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px;">
          {[
            { href: '/Pucara-Turismo/paquetes', label: 'Ver todos los paquetes' },
            { href: '/Pucara-Turismo/#faq', label: 'Preguntas Frecuentes' },
            { href: '/Pucara-Turismo/#sobre', label: 'Sobre Nosotros' },
            { href: '/Pucara-Turismo/contacto', label: 'Contacto' },
          ].map(link => (
            <li key={link.href}>
              <a href={link.href}
                style="font-size: 0.875rem; color: rgba(255,255,255,0.45); transition: color 0.2s ease; text-decoration: none;"
                onmouseover="this.style.color='#fb923c'"
                onmouseout="this.style.color='rgba(255,255,255,0.45)'"
              >{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      {/* Contact */}
      <div>
        <h4 style="font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; color: rgba(255,255,255,0.35); margin-bottom: 20px;">CONTACTO</h4>
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 16px;">
          <li>
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.3)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
              </svg>
              <span style="font-size:0.68rem;color:rgba(255,255,255,0.3);font-weight:600;letter-spacing:0.06em;text-transform:uppercase;">WhatsApp</span>
            </div>
            <a href="https://wa.me/5491134952847" style="font-size:0.875rem;color:#fb923c;font-weight:600;text-decoration:none;transition:color 0.2s;"
              onmouseover="this.style.color='#f97316'"
              onmouseout="this.style.color='#fb923c'">
              +54 9 11 3495-2847
            </a>
          </li>
          <li>
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.3)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
              </svg>
              <span style="font-size:0.68rem;color:rgba(255,255,255,0.3);font-weight:600;letter-spacing:0.06em;text-transform:uppercase;">Email</span>
            </div>
            <a href="mailto:turismopucara@hotmail.com" style="font-size:0.875rem;color:#fb923c;font-weight:600;text-decoration:none;transition:color 0.2s;"
              onmouseover="this.style.color='#f97316'"
              onmouseout="this.style.color='#fb923c'">
              turismopucara@hotmail.com
            </a>
          </li>
          <li>
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.3)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
              <span style="font-size:0.68rem;color:rgba(255,255,255,0.3);font-weight:600;letter-spacing:0.06em;text-transform:uppercase;">Atención</span>
            </div>
            <p style="font-size:0.875rem;color:rgba(255,255,255,0.6);margin:0;">Lun–Vie: 9:00 a 19:00 hs</p>
          </li>
        </ul>
      </div>
    </div>

    {/* Divider */}
    <div style="border-top: 1px solid rgba(255,255,255,0.06); margin-bottom: 24px;"></div>

    {/* Bottom bar */}
    <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px;">
      <p style="font-size:0.78rem;color:rgba(255,255,255,0.3);margin:0;">
        &copy; 2026 Pucará Turismo. Todos los derechos reservados.
      </p>
      <div style="display:flex;gap:20px;">
        <a href="/Pucara-Turismo/legal/terminos"
          style="font-size:0.78rem;color:rgba(255,255,255,0.3);text-decoration:none;transition:color 0.2s;"
          onmouseover="this.style.color='#fb923c'"
          onmouseout="this.style.color='rgba(255,255,255,0.3)'">Términos y Condiciones</a>
        <a href="/Pucara-Turismo/legal/privacidad"
          style="font-size:0.78rem;color:rgba(255,255,255,0.3);text-decoration:none;transition:color 0.2s;"
          onmouseover="this.style.color='#fb923c'"
          onmouseout="this.style.color='rgba(255,255,255,0.3)'">Privacidad</a>
      </div>
      <p style="font-size:0.78rem;color:rgba(255,255,255,0.2);margin:0;">
        Desarrollado por <span style="color:rgba(255,255,255,0.4);font-weight:600;">VitaDev</span>
      </p>
    </div>

    {/* Trust badges */}
    <div style="border-top: 1px solid rgba(255,255,255,0.06); margin-top: 24px; padding-top: 24px; display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:32px;">
      <div style="display:flex;align-items:center;gap:8px;color:rgba(255,255,255,0.3);font-size:0.78rem;">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        Pago seguro
      </div>
      <div style="display:flex;align-items:center;gap:8px;color:rgba(255,255,255,0.3);font-size:0.78rem;">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        +15 años de experiencia
      </div>
      <div style="display:flex;align-items:center;gap:8px;color:rgba(255,255,255,0.3);font-size:0.78rem;">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        Salidas desde zona oeste
      </div>
      <div style="display:flex;align-items:center;gap:8px;color:rgba(255,255,255,0.3);font-size:0.78rem;">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
        </svg>
        Todo incluido
      </div>
    </div>

  </div>
</footer>