---
const WA = '5491134952847';

// Los destinos linkean al listado filtrado, no a un paquete puntual:
// un paquete se da de baja cuando pasa la fecha y el link quedaria roto.
const destinos = [
  { destino: 'colon-entre-rios', label: 'Colón y Termas' },
  { destino: 'mar-del-plata', label: 'Mar del Plata' },
  { destino: 'san-bernardo', label: 'San Bernardo' },
  { destino: 'las-grutas', label: 'Las Grutas' },
  { destino: 'federacion-entre-rios', label: 'Federación' },
  { destino: 'tandil', label: 'Tandil' },
];

const info = [
  { href: '/paquetes/', label: 'Todos los viajes' },
  { href: '/resenas/', label: 'Reseñas de viajeros' },
  { href: '/faq/', label: 'Preguntas frecuentes' },
  { href: '/contacto/', label: 'Contacto' },
];
---

<footer class="pie">
  <div class="container-gutter pie-caja">

    <section class="boletin">
      <div class="boletin-texto">
        <h3>Enterate de las nuevas salidas</h3>
        <p>Dejanos tu email y te avisamos cuando se confirma un viaje o sale una promo.</p>
      </div>
      <form
        id="nl-form"
        action="https://assets.mailerlite.com/jsonp/2621768/forms/198028793608144042/subscribe"
        method="post"
        target="ml_nl_iframe"
        class="boletin-form"
      >
        <input type="email" name="fields[email]" required placeholder="Tu email" aria-label="Tu email" />
        <input type="hidden" name="ml-submit" value="1" />
        <input type="hidden" name="anticsrf" value="true" />
        <button type="submit" class="btn btn-primary">Suscribirme</button>
        <p id="nl-ok" class="boletin-ok">¡Listo! Ya estás en la lista.</p>
      </form>
      <iframe name="ml_nl_iframe" style="display:none;" title="MailerLite"></iframe>
    </section>

    <div class="pie-grilla">

      <div class="pie-marca">
        <img src="/isologopucara.png" alt="Pucará Turismo" width="250" height="125" />
        <p>
          Agencia de turismo con más de 15 años organizando viajes grupales por Argentina:
          termas, playa y sierra, con todo incluido y salidas desde el oeste del Gran Buenos Aires.
        </p>
        <div class="pie-redes">
          <a href="https://www.instagram.com/pucaraturismo.ok/" target="_blank" rel="noopener noreferrer" aria-label="Instagram de Pucará Turismo">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/>
            </svg>
          </a>
          <a href="https://www.facebook.com/Pucaraturismo" target="_blank" rel="noopener noreferrer" aria-label="Facebook de Pucará Turismo">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
            </svg>
          </a>
          <a href={`https://wa.me/${WA}`} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp de Pucará Turismo">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
            </svg>
          </a>
        </div>
      </div>

      <nav class="pie-columna" aria-label="Destinos">
        <h4>Destinos</h4>
        <ul>
          {destinos.map((d) => (
            <li><a href={`/paquetes/?destino=${d.destino}`}>{d.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="pie-columna" aria-label="Información">
        <h4>Información</h4>
        <ul>
          {info.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="pie-columna pie-contacto">
        <h4>Contacto</h4>
        <ul>
          <li>
            <span class="pie-rotulo">WhatsApp</span>
            <a href={`https://wa.me/${WA}`} class="pie-dato">+54 9 11 3495-2847</a>
          </li>
          <li>
            <span class="pie-rotulo">Email</span>
            <a href="mailto:info@pucaraturismo.com.ar" class="pie-dato">info@pucaraturismo.com.ar</a>
          </li>
          <li>
            <span class="pie-rotulo">Atención</span>
            <span class="pie-dato pie-dato-plano">Lunes a viernes, 9 a 19 hs</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="pie-abajo">
      <p>© 2026 Pucará Turismo · HAT Travel SRL · Legajo 15157</p>
      <div class="pie-legales">
        <a href="/legal/terminos/">Términos y condiciones</a>
        <a href="/legal/privacidad/">Privacidad</a>
      </div>
      <p class="pie-autor">Desarrollado por <span>VitaDev</span></p>
    </div>

  </div>
</footer>

<style>
  .pie {
    background: var(--fondo);
    border-top: 1px solid var(--linea);
    padding: 3.5rem 0 2rem;
    color: var(--tinta-2);
  }
  @media (min-width: 768px) { .pie { padding: 4.5rem 0 2rem; } }
  .pie-caja { max-width: 1180px; margin: 0 auto; }

  /* ── Boletin ── */
  .boletin {
    background: var(--papel);
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    padding: 1.5rem;
    margin-bottom: 3rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }
  .boletin-texto { flex: 1; min-width: 240px; }
  .boletin-texto h3 { font-size: 1.1rem; margin: 0 0 0.25rem; }
  .boletin-texto p { font-size: 0.875rem; margin: 0; color: var(--tinta-2); }
  .boletin-form { display: flex; gap: 0.5rem; flex-wrap: wrap; min-width: 280px; flex: 1; max-width: 440px; }
  .boletin-form input[type="email"] { flex: 1; min-width: 170px; padding: 0.7rem 0.9rem; font-size: 0.9rem; }
  .boletin-form .btn { white-space: nowrap; }
  .boletin-ok { display: none; width: 100%; color: var(--verde); font-size: 0.85rem; margin: 0.25rem 0 0; }

  /* ── Grilla ── */
  .pie-grilla {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin-bottom: 2.5rem;
  }
  @media (min-width: 640px) { .pie-grilla { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .pie-grilla { grid-template-columns: 1.4fr 1fr 1fr 1.1fr; gap: 2rem; } }

  .pie-marca img { height: 46px; width: auto; margin-bottom: 1rem; }
  .pie-marca p { font-size: 0.85rem; line-height: 1.7; max-width: 300px; margin-bottom: 1.1rem; }

  .pie-redes { display: flex; gap: 0.6rem; }
  .pie-redes a {
    width: 40px; height: 40px;
    display: grid; place-items: center;
    background: var(--papel);
    border: 1px solid var(--linea);
    border-radius: var(--radio-ch);
    color: var(--tinta-2);
    transition: border-color 0.18s ease, color 0.18s ease;
  }
  .pie-redes a:hover { border-color: var(--naranja-fuerte); color: var(--naranja-fuerte); }

  .pie-columna h4 {
    font-size: 0.92rem;
    font-weight: 650;
    color: var(--tinta);
    margin-bottom: 0.9rem;
  }
  .pie-columna ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.6rem; }
  .pie-columna a { font-size: 0.875rem; color: var(--tinta-2); }
  .pie-columna a:hover { color: var(--naranja-tinta); }

  .pie-contacto ul { gap: 1rem; }
  .pie-rotulo { display: block; font-size: 0.75rem; color: var(--tinta-3); margin-bottom: 0.1rem; }
  .pie-dato { font-size: 0.9rem; font-weight: 600; color: var(--tinta); }
  a.pie-dato:hover { color: var(--naranja-tinta); }
  .pie-dato-plano { font-weight: 400; color: var(--tinta-2); }

  /* ── Abajo ── */
  .pie-abajo {
    border-top: 1px solid var(--linea);
    padding-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }
  .pie-abajo p { font-size: 0.8rem; margin: 0; color: var(--tinta-3); }
  .pie-legales { display: flex; gap: 1.25rem; }
  .pie-legales a { font-size: 0.8rem; color: var(--tinta-3); }
  .pie-legales a:hover { color: var(--tinta); }
  .pie-autor span { color: var(--tinta-2); font-weight: 600; }
</style>

<script is:inline>
  (function () {
    var f = document.getElementById('nl-form');
    if (!f) return;
    f.addEventListener('submit', function () {
      setTimeout(function () {
        var ok = document.getElementById('nl-ok');
        if (ok) ok.style.display = 'block';
        var inp = f.querySelector('input[type=email]');
        if (inp) inp.value = '';
        if (typeof window.gtag === 'function') window.gtag('event', 'newsletter_signup', { lugar: 'footer' });
      }, 300);
    });
  })();
</script>
