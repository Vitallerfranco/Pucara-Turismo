---
---

<footer style="background: #0e0e0e; border-top: 1px solid rgba(255,255,255,0.06); color: rgba(255,255,255,0.75);" class="py-16 md:py-20">
  <div class="container-gutter">

    {/* Newsletter */}
    <div style="background:linear-gradient(135deg,rgba(249,115,22,0.12),rgba(249,115,22,0.03));border:1px solid rgba(249,115,22,0.25);border-radius:16px;padding:28px 24px;margin-bottom:56px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:20px;">
      <div style="flex:1;min-width:240px;">
        <h3 style="color:#fff;font-size:1.15rem;font-weight:700;margin:0 0 6px;">Enterate de las nuevas salidas y promos</h3>
        <p style="color:rgba(255,255,255,0.6);font-size:0.85rem;margin:0;">Dejanos tu email y te avisamos cuando se confirma un viaje o hay una oferta.</p>
      </div>
      <form id="nl-form" action="https://assets.mailerlite.com/jsonp/2621768/forms/198028793608144042/subscribe" method="post" target="ml_nl_iframe" style="display:flex;gap:8px;flex-wrap:wrap;min-width:280px;flex:1;max-width:460px;">
        <input type="email" name="fields[email]" required placeholder="Tu email" aria-label="Tu email"
          style="flex:1;min-width:180px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.15);border-radius:9px;padding:0.7rem 1rem;color:#fff;font-size:0.9rem;outline:none;box-sizing:border-box;" />
        <input type="hidden" name="ml-submit" value="1" />
        <input type="hidden" name="anticsrf" value="true" />
        <button type="submit" style="background:#f97316;color:#fff;font-weight:700;border:none;border-radius:9px;padding:0.7rem 1.4rem;font-size:0.9rem;cursor:pointer;white-space:nowrap;">Suscribirme</button>
        <p id="nl-ok" style="display:none;width:100%;color:#25d366;font-size:0.85rem;margin:4px 0 0;">¡Listo! Ya estás en la lista. Gracias por suscribirte.</p>
      </form>
      <iframe name="ml_nl_iframe" style="display:none;" title="MailerLite"></iframe>
    </div>

    {/* Main grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-14">

      {/* Brand */}
      <div>
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
          <img
            src="/isologopucara.png"
            alt="Pucará Turismo"
            style="height:48px;width:auto;object-fit:contain;"
          />
        </div>
        <p style="font-size: 0.82rem; color: rgba(255,255,255,0.6); line-height: 1.75; margin-bottom: 1.25rem; max-width: 260px;">
          Somos una agencia de turismo con más de 15 años organizando viajes grupales por Argentina. Nos especializamos en escapadas de fin de semana, vacaciones de invierno y experiencias en termas, playas y montaña — con todo incluido y salidas desde zona oeste del Gran Buenos Aires.
        </p>

        {/* Social buttons */}
        <div class="flex gap-3">
          <a href="https://www.instagram.com/pucaraturismo.ok/" target="_blank" rel="noopener noreferrer"
            style="width:40px;height:40px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:10px;display:flex;align-items:center;justify-content:center;transition:all 0.2s ease;color:rgba(255,255,255,0.6);"
            onmouseover="this.style.background='#f97316';this.style.borderColor='#f97316';this.style.color='white'"
            onmouseout="this.style.background='rgba(255,255,255,0.05)';this.style.borderColor='rgba(255,255,255,0.1)';this.style.color='rgba(255,255,255,0.6)'"
            title="Instagram">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/>
            </svg>
          </a>
          <a href="https://www.facebook.com/Pucaraturismo" target="_blank" rel="noopener noreferrer"
            style="width:40px;height:40px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:10px;display:flex;align-items:center;justify-content:center;transition:all 0.2s ease;color:rgba(255,255,255,0.6);"
            onmouseover="this.style.background='#f97316';this.style.borderColor='#f97316';this.style.color='white'"
            onmouseout="this.style.background='rgba(255,255,255,0.05)';this.style.borderColor='rgba(255,255,255,0.1)';this.style.color='rgba(255,255,255,0.6)'"
            title="Facebook">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
            </svg>
          </a>
          <a href="https://wa.me/5491134952847" target="_blank" rel="noopener noreferrer"
            style="width:40px;height:40px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:10px;display:flex;align-items:center;justify-content:center;transition:all 0.2s ease;color:rgba(255,255,255,0.6);"
            onmouseover="this.style.background='#f97316';this.style.borderColor='#f97316';this.style.color='white'"
            onmouseout="this.style.background='rgba(255,255,255,0.05)';this.style.borderColor='rgba(255,255,255,0.1)';this.style.color='rgba(255,255,255,0.6)'"
            title="WhatsApp">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
            </svg>
          </a>
        </div>
      </div>

      {/* Destinations */}
      <div>
        <h4 style="font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; color: rgba(255,255,255,0.6); margin-bottom: 20px;">DESTINOS</h4>
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px;">
          {[
            { href: '/paquetes/mar-del-plata-riazor-19sep', label: 'Mar del Plata' },
            { href: '/paquetes/colon-san-jose-termas-rio-2d1n-24oct', label: 'Colón + Termas' },
            { href: '/paquetes/rio-hondo-hebron-promo-16sep', label: 'Termas de Río Hondo' },
            { href: '/paquetes/san-bernardo-hostal-del-sol-19sep', label: 'San Bernardo' },
            { href: '/paquetes/las-grutas-hotel-mareas-26nov', label: 'Las Grutas' },
            { href: '/paquetes/tandil-full-day-19sep', label: 'Tandil' },
          ].map(link => (
            <li key={link.href}>
              <a href={link.href}
                style="font-size: 0.875rem; color: rgba(255,255,255,0.6); transition: color 0.2s ease; text-decoration: none;"
                onmouseover="this.style.color='#fb923c'"
                onmouseout="this.style.color='rgba(255,255,255,0.6)'"
              >{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      {/* Info */}
      <div>
        <h4 style="font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; color: rgba(255,255,255,0.6); margin-bottom: 20px;">INFORMACIÓN</h4>
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px;">
          {[
            { href: '/paquetes', label: 'Ver todos los paquetes' },
            { href: '/#faq', label: 'Preguntas Frecuentes' },
            { href: '/#sobre', label: 'Sobre Nosotros' },
            { href: '/contacto', label: 'Contacto' },
          ].map(link => (
            <li key={link.href}>
              <a href={link.href}
                style="font-size: 0.875rem; color: rgba(255,255,255,0.6); transition: color 0.2s ease; text-decoration: none;"
                onmouseover="this.style.color='#fb923c'"
                onmouseout="this.style.color='rgba(255,255,255,0.6)'"
              >{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      {/* Contact */}
      <div>
        <h4 style="font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; color: rgba(255,255,255,0.6); margin-bottom: 20px;">CONTACTO</h4>
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 16px;">
          <li>
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.6)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
              </svg>
              <span style="font-size:0.68rem;color:rgba(255,255,255,0.6);font-weight:600;letter-spacing:0.06em;text-transform:uppercase;">WhatsApp</span>
            </div>
            <a href="https://wa.me/5491134952847" style="font-size:0.875rem;color:#fb923c;font-weight:600;text-decoration:none;transition:color 0.2s;"
              onmouseover="this.style.color='#f97316'"
              onmouseout="this.style.color='#fb923c'">
              +54 9 11 3495-2847
            </a>
          </li>
          <li>
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.6)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
              </svg>
              <span style="font-size:0.68rem;color:rgba(255,255,255,0.6);font-weight:600;letter-spacing:0.06em;text-transform:uppercase;">Email</span>
            </div>
            <a href="mailto:info@pucaraturismo.com.ar" style="font-size:0.875rem;color:#fb923c;font-weight:600;text-decoration:none;transition:color 0.2s;"
              onmouseover="this.style.color='#f97316'"
              onmouseout="this.style.color='#fb923c'">
              info@pucaraturismo.com.ar
            </a>
          </li>
          <li>
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.6)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
              <span style="font-size:0.68rem;color:rgba(255,255,255,0.6);font-weight:600;letter-spacing:0.06em;text-transform:uppercase;">Atención</span>
            </div>
            <p style="font-size:0.875rem;color:rgba(255,255,255,0.6);margin:0;">Lun–Vie: 9:00 a 19:00 hs</p>
          </li>
        </ul>
      </div>
    </div>

    {/* Divider */}
    <div style="border-top: 1px solid rgba(255,255,255,0.06); margin-bottom: 24px;"></div>

    {/* Bottom bar */}
    <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px;">
      <p style="font-size:0.78rem;color:rgba(255,255,255,0.6);margin:0;">
        &copy; 2026 Pucará Turismo. Todos los derechos reservados.
      </p>
      <div style="display:flex;gap:20px;">
        <a href="/legal/terminos"
          style="font-size:0.78rem;color:rgba(255,255,255,0.6);text-decoration:none;transition:color 0.2s;"
          onmouseover="this.style.color='#fb923c'"
          onmouseout="this.style.color='rgba(255,255,255,0.6)'">Términos y Condiciones</a>
        <a href="/legal/privacidad"
          style="font-size:0.78rem;color:rgba(255,255,255,0.6);text-decoration:none;transition:color 0.2s;"
          onmouseover="this.style.color='#fb923c'"
          onmouseout="this.style.color='rgba(255,255,255,0.6)'">Privacidad</a>
      </div>
      <p style="font-size:0.78rem;color:rgba(255,255,255,0.2);margin:0;">
        Desarrollado por <span style="color:rgba(255,255,255,0.6);font-weight:600;">VitaDev</span>
      </p>
    </div>

    {/* Trust badges */}
    <div style="border-top: 1px solid rgba(255,255,255,0.06); margin-top: 24px; padding-top: 24px; display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:32px;">
      <div style="display:flex;align-items:center;gap:8px;color:rgba(255,255,255,0.6);font-size:0.78rem;">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        Pago seguro
      </div>
      <div style="display:flex;align-items:center;gap:8px;color:rgba(255,255,255,0.6);font-size:0.78rem;">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        +15 años de experiencia
      </div>
      <div style="display:flex;align-items:center;gap:8px;color:rgba(255,255,255,0.6);font-size:0.78rem;">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        Salidas desde zona oeste
      </div>
      <div style="display:flex;align-items:center;gap:8px;color:rgba(255,255,255,0.6);font-size:0.78rem;">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
        </svg>
        Todo incluido
      </div>
    </div>

  </div>
</footer>

<script is:inline>
  (function () {
    var f = document.getElementById('nl-form');
    if (!f) return;
    f.addEventListener('submit', function () {
      setTimeout(function () {
        var ok = document.getElementById('nl-ok');
        if (ok) ok.style.display = 'block';
        var inp = f.querySelector('input[type=email]');
        if (inp) inp.value = '';
        if (typeof window.gtag === 'function') window.gtag('event', 'newsletter_signup', { lugar: 'footer' });
      }, 300);
    });
  })();
</script>