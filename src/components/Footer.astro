---
---

<footer class="bg-slate-900 text-slate-100 py-16 md:py-20">
  <div class="container-gutter">
    {/* Main footer content */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-12">
      {/* Brand */}
      <div>
        <div class="flex items-center gap-2 mb-4">
          <div class="w-10 h-10 bg-orange-500 rounded-full flex items-center justify-center">
            <span class="text-white font-bold text-xl">🏔️</span>
          </div>
          <h3 class="font-bold text-lg">Pucará Turismo</h3>
        </div>
        <p class="text-sm text-slate-400 mb-6">
          Expertos en viajes al norte argentino. Más de 15 años organizando experiencias inolvidables.
        </p>
        <div class="flex gap-4">
          <a href="#" class="w-10 h-10 bg-slate-800 hover:bg-orange-500 rounded-full flex items-center justify-center transition-colors" title="Instagram">
            <span>📱</span>
          </a>
          <a href="#" class="w-10 h-10 bg-slate-800 hover:bg-orange-500 rounded-full flex items-center justify-center transition-colors" title="Facebook">
            <span>👥</span>
          </a>
          <a href="#" class="w-10 h-10 bg-slate-800 hover:bg-orange-500 rounded-full flex items-center justify-center transition-colors" title="WhatsApp">
            <span>💬</span>
          </a>
        </div>
      </div>

      {/* Destinations */}
      <div>
        <h4 class="font-bold mb-4 text-white">Destinos</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/destinos/jujuy-salinas" class="text-slate-400 hover:text-orange-400 transition-colors">Salinas Grandes</a></li>
          <li><a href="/destinos/jujuy-purmamarca" class="text-slate-400 hover:text-orange-400 transition-colors">Purmamarca</a></li>
          <li><a href="/destinos/misiones-iguazu" class="text-slate-400 hover:text-orange-400 transition-colors">Iguazú</a></li>
          <li><a href="/destinos/mendoza" class="text-slate-400 hover:text-orange-400 transition-colors">Mendoza</a></li>
          <li><a href="/destinos/cordoba" class="text-slate-400 hover:text-orange-400 transition-colors">Córdoba</a></li>
        </ul>
      </div>

      {/* Quick links */}
      <div>
        <h4 class="font-bold mb-4 text-white">Información</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/#faq" class="text-slate-400 hover:text-orange-400 transition-colors">Preguntas Frecuentes</a></li>
          <li><a href="/#sobre" class="text-slate-400 hover:text-orange-400 transition-colors">Sobre Nosotros</a></li>
          <li><a href="/blog" class="text-slate-400 hover:text-orange-400 transition-colors">Blog de Viajes</a></li>
          <li><a href="/contacto" class="text-slate-400 hover:text-orange-400 transition-colors">Contacto</a></li>
        </ul>
      </div>

      {/* Contact */}
      <div>
        <h4 class="font-bold mb-4 text-white">Contacto</h4>
        <ul class="space-y-3 text-sm">
          <li>
            <p class="text-slate-400 mb-1">WhatsApp</p>
            <a href="https://wa.me/5491150000000" class="text-orange-400 hover:text-orange-300 font-semibold transition-colors">
              +54 9 11 5000-0000
            </a>
          </li>
          <li>
            <p class="text-slate-400 mb-1">Email</p>
            <a href="mailto:info@pucaraturismo.com" class="text-orange-400 hover:text-orange-300 font-semibold transition-colors">
              info@pucaraturismo.com
            </a>
          </li>
          <li>
            <p class="text-slate-400 mb-1">Atención</p>
            <p class="text-slate-300">L-V: 9:00-18:00 hs</p>
          </li>
        </ul>
      </div>
    </div>

    {/* Divider */}
    <div class="border-t border-slate-800 mb-8"></div>

    {/* Bottom footer */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-sm text-slate-400">
      <div>
        <p>&copy; 2024 Pucará Turismo. Todos los derechos reservados.</p>
      </div>
      <div class="flex justify-center gap-6">
        <a href="/legal/terminos" class="hover:text-orange-400 transition-colors">Términos y Condiciones</a>
        <a href="/legal/privacidad" class="hover:text-orange-400 transition-colors">Política de Privacidad</a>
      </div>
      <div class="text-right md:text-left">
        <p>Diseñado con ❤️ en Buenos Aires</p>
      </div>
    </div>

    {/* Trust badges */}
    <div class="mt-12 pt-8 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-center gap-8 text-xs text-slate-400">
      <div class="flex items-center gap-2">
        <span>🛡️</span>
        <span>Pago seguro</span>
      </div>
      <div class="flex items-center gap-2">
        <span>✅</span>
        <span>Certificado por ATTA</span>
      </div>
      <div class="flex items-center gap-2">
        <span>🌍</span>
        <span>Asociado IATA</span>
      </div>
    </div>
  </div>
</footer>
