---
export interface Props {
  nombre: string;
  label: string;
  tipo?: 'text' | 'email' | 'tel' | 'number' | 'date';
  placeholder?: string;
  requerido?: boolean;
  valor?: string;
  error?: string;
  ayuda?: string;
  minimo?: number;
  maximo?: number;
}

const {
  nombre,
  label,
  tipo = 'text',
  placeholder,
  requerido = false,
  valor = '',
  error,
  ayuda,
  minimo,
  maximo
} = Astro.props;
---

<div class="input-group">
  <label for={nombre} class="input-label">
    {label}
    {requerido && <span class="input-requerido">*</span>}
  </label>

  <input
    id={nombre}
    name={nombre}
    type={tipo}
    value={valor}
    placeholder={placeholder}
    required={requerido}
    min={minimo}
    max={maximo}
    class={`input-field ${error ? 'input-error' : ''}`}
  />

  {ayuda && <p class="input-ayuda">{ayuda}</p>}
  {error && (
    <p class="input-mensaje-error">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"/>
        <line x1="12" y1="8" x2="12" y2="12"/>
        <line x1="12" y1="16" x2="12.01" y2="16"/>
      </svg>
      {error}
    </p>
  )}
</div>

<style>
  @reference "../styles/globals.css";

  .input-group {
    @apply flex flex-col gap-1.5 mb-5;
  }

  .input-label {
    @apply text-xs font-medium text-white/50 uppercase tracking-widest;
  }

  .input-requerido {
    @apply text-orange-400 ml-0.5;
  }

  .input-field {
    @apply w-full px-4 py-3 rounded-lg border border-white/10 bg-white/5 text-white placeholder-white/20
           focus:border-orange-500/60 focus:outline-none focus:ring-2 focus:ring-orange-500/15
           transition-all duration-200 text-sm;
  }

  .input-field:disabled {
    @apply opacity-30 cursor-not-allowed;
  }

  .input-field.input-error {
    @apply border-red-500/50 focus:ring-red-500/15;
  }

  .input-ayuda {
    @apply text-xs text-white/25 leading-relaxed;
  }

  .input-mensaje-error {
    @apply flex items-center gap-1.5 text-xs text-red-400 font-medium;
  }
</style>