---
import type { Paquete } from '@/types';
import { formatPrice, getWhatsappLink } from '@/lib/utils';

interface Props {
  paquete: Paquete;
  whatsappPhone?: string;
}

const { paquete, whatsappPhone = '5491150000000' } = Astro.props;
const precioTotal = paquete.precioBase + paquete.gastosAdmin;
const cuposLibres = Math.max(0, paquete.cuposPorSalida - 8);
const cuposCritico = cuposLibres <= 3;

const whatsappMsg = `Hola, quiero reservar:\n📌 ${paquete.titulo}\n📅 ${paquete.proximaSalida}\n👥 Pasajeros: (a confirmar)\n💰 ${formatPrice(precioTotal)} por persona\n\n¿Disponibilidad y próximos pasos?`;

const visibleIncluye = paquete.incluye.slice(0, 3);
const extrasCount = paquete.incluye.length - 3;
const duracionLabel = paquete.tipo === 'full_day'
  ? 'Full Day'
  : `${paquete.duracionDias}d/${paquete.duracionNoches}n`;
---

<article class="paquete-card">
  <!-- Imagen -->
  <div class="card-img-wrap">
    <img
      src={paquete.imagenPrincipal}
      alt={paquete.titulo}
      class="card-img"
      loading="lazy"
    />

    <!-- Badge urgencia -->
    {cuposCritico && (
      <div class="badge-urgencia">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
        </svg>
        ÚLTIMAS {cuposLibres} PLAZAS
      </div>
    )}

    <!-- Rating -->
    <div class="badge-rating">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="#e8622a" aria-hidden="true">
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
      </svg>
      {paquete.rating}
      <span class="rating-reviews">({paquete.reviews})</span>
    </div>

    <!-- Acento inferior naranja -->
    <div class="card-img-accent" aria-hidden="true"></div>
  </div>

  <!-- Contenido -->
  <div class="card-body">

    <!-- Duración -->
    <p class="card-duracion">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
      </svg>
      {duracionLabel}
    </p>

    <!-- Título -->
    <h3 class="card-titulo">{paquete.titulo}</h3>

    <!-- Descripción -->
    <p class="card-desc">{paquete.descripcionCorta}</p>

    <!-- Incluye -->
    <div class="card-incluye">
      {visibleIncluye.map((item) => (
        <span class="badge-incluye">
          <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          {item}
        </span>
      ))}
      {extrasCount > 0 && (
        <span class="badge-extras">+{extrasCount} más</span>
      )}
    </div>

    <div class="card-sep" aria-hidden="true"></div>

    <!-- Precio -->
    <div class="card-precio">
      <p class="precio-label">PRECIO POR PERSONA</p>
      <div class="precio-row">
        <span class="precio-monto">{formatPrice(paquete.precioBase)}</span>
        <span class="precio-gastos">+ {formatPrice(paquete.gastosAdmin)} gastos</span>
      </div>
    </div>

    <!-- Botones -->
    <div class="card-btns">
      <a
        href={`/Pucara-Turismo/paquetes/${paquete.slug}/`}
        class="btn-ver"
      >
        Ver detalles
      </a>
      <a
        href={`https://wa.me/${whatsappPhone}?text=${encodeURIComponent(whatsappMsg)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-reservar"
      >
        Reservar
      </a>
    </div>
  </div>
</article>

<style>
  .paquete-card {
    background: #141414;
    border: 1px solid #1f1f1f;
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .paquete-card:hover {
    border-color: #2e2e2e;
    transform: translateY(-2px);
  }

  /* ── Imagen ── */
  .card-img-wrap {
    position: relative;
    aspect-ratio: 16/9;
    overflow: hidden;
    background: #111;
  }
  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s ease;
  }
  .paquete-card:hover .card-img {
    transform: scale(1.05);
  }
  .card-img-accent {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: #e8622a;
  }

  /* badges sobre imagen */
  .badge-urgencia {
    position: absolute;
    top: 12px;
    left: 12px;
    background: #dc2626;
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 5px 10px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .badge-rating {
    position: absolute;
    top: 12px;
    right: 12px;
    background: rgba(255,255,255,0.95);
    color: #1a1a1a;
    font-size: 11px;
    font-weight: 600;
    padding: 5px 10px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .rating-reviews {
    color: #888;
    font-weight: 400;
  }

  /* ── Body ── */
  .card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 18px 20px 20px;
  }
  .card-duracion {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    font-weight: 600;
    color: #e8622a;
    margin: 0 0 8px;
  }
  .card-titulo {
    font-size: 17px;
    font-weight: 700;
    color: #fff;
    line-height: 1.3;
    margin: 0 0 8px;
  }
  .card-desc {
    font-size: 13px;
    color: #777;
    line-height: 1.6;
    margin: 0 0 14px;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── Incluye ── */
  .card-incluye {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-bottom: 16px;
  }
  .badge-incluye {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: #1c1c1c;
    border: 1px solid #272727;
    color: #bbb;
    font-size: 11px;
    padding: 3px 8px;
    border-radius: 6px;
  }
  .badge-incluye svg { color: #e8622a; }
  .badge-extras {
    display: inline-flex;
    align-items: center;
    background: #1c1c1c;
    border: 1px solid #272727;
    color: #555;
    font-size: 11px;
    padding: 3px 8px;
    border-radius: 6px;
  }

  /* ── Separador ── */
  .card-sep {
    height: 1px;
    background: #1e1e1e;
    margin-bottom: 14px;
  }

  /* ── Precio ── */
  .card-precio { margin-bottom: 16px; }
  .precio-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.09em;
    color: #444;
    margin: 0 0 5px;
  }
  .precio-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }
  .precio-monto {
    font-size: 22px;
    font-weight: 700;
    color: #e8622a;
  }
  .precio-gastos {
    font-size: 12px;
    color: #555;
  }

  /* ── Botones ── */
  .card-btns {
    display: flex;
    gap: 8px;
  }
  .btn-ver,
  .btn-reservar {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 9px 14px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }
  .btn-ver {
    background: #1c1c1c;
    border: 1px solid #272727;
    color: #bbb;
  }
  .btn-ver:hover { background: #242424; color: #fff; }
  .btn-reservar {
    background: #e8622a;
    border: 1px solid #e8622a;
    color: #fff;
  }
  .btn-reservar:hover { background: #cf5523; }
</style>
