---
import type { Paquete } from '@/types';
import { formatPrice, webpSrcset } from '@/lib/utils';
import { partesTitulo, duracionLabel, fechaLarga, transporte, diasHasta } from '@/lib/viaje';

interface Props {
  paquete: Paquete;
  whatsappPhone?: string;
  /** La primera tarjeta de la página carga su foto sin diferir. */
  prioridad?: boolean;
}

const { paquete, whatsappPhone = '5491134952847', prioridad = false } = Astro.props;

const { titular, subtitulo, cuando } = partesTitulo(paquete.titulo);
const duracion = duracionLabel(paquete);
const comoViaja = transporte(paquete.incluye);
const precioTotal = paquete.precioBase + paquete.gastosAdmin;
const faltan = diasHasta(paquete.proximaSalida);
const salePronto = faltan >= 0 && faltan <= 14;

const whatsappMsg = `Hola, me interesa este viaje:\n\n${paquete.titulo}\nSalida: ${fechaLarga(paquete.proximaSalida)}\nPrecio: ${formatPrice(paquete.precioBase)} + ${formatPrice(paquete.gastosAdmin)} de gastos por persona\n\n¿Me pasás disponibilidad?`;
const whatsappHref = `https://wa.me/${whatsappPhone}?text=${encodeURIComponent(whatsappMsg)}`;

const cardWebp = webpSrcset(paquete.imagenPrincipal);
const detalleHref = `/paquetes/${paquete.slug}/`;
---

<article class="viaje">

  <div class="viaje-foto">
    <picture style="display:contents">
      {cardWebp && (
        <source
          type="image/webp"
          srcset={cardWebp}
          sizes="(max-width:640px) 86vw, (max-width:1100px) 45vw, 360px"
        />
      )}
      <img
        src={paquete.imagenPrincipal}
        alt={titular}
        width="1200"
        height="900"
        loading={prioridad ? 'eager' : 'lazy'}
        fetchpriority={prioridad ? 'high' : undefined}
        decoding="async"
      />
    </picture>

    <div class="viaje-sellos">
      <span class="sello">{duracion}</span>
      {comoViaja && <span class="sello">{comoViaja}</span>}
    </div>

    {salePronto && <span class="sello sello-pronto">Sale en {faltan === 0 ? 'el día' : `${faltan} ${faltan === 1 ? 'día' : 'días'}`}</span>}
  </div>

  <div class="viaje-cuerpo">
    <h3 class="viaje-titular">
      <a href={detalleHref}>{titular}</a>
    </h3>
    {subtitulo && <p class="viaje-subtitulo">{subtitulo}</p>}

    <div class="viaje-precio">
      <span class="precio-desde">desde</span>
      <div class="precio-fila">
        <strong>{formatPrice(paquete.precioBase)}</strong>
        <span>por persona</span>
      </div>
      <p class="precio-letra">+ {formatPrice(paquete.gastosAdmin)} de gastos administrativos</p>
    </div>

    <p class="viaje-cuando">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/>
      </svg>
      {cuando ? `Sale el ${cuando.toLowerCase()}` : `Sale el ${fechaLarga(paquete.proximaSalida)}`}
    </p>

    <a
      href={whatsappHref}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-primary viaje-wa"
      data-ga="reservar_tarjeta"
    >
      <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3.1.8.8-3-.2-.3A8.2 8.2 0 1 1 12 20.2z"/>
        <path d="M17.5 14.4c-.3-.2-1.7-.9-2-1-.3-.1-.5-.1-.7.2-.2.3-.7 1-.9 1.1-.2.2-.3.2-.6.1-.3-.2-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.5c.1-.2.2-.3.3-.5 0-.2 0-.4 0-.5 0-.2-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.4s1.1 2.8 1.2 3c.2.2 2.1 3.2 5.1 4.4.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.7-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.3-.6-.4z"/>
      </svg>
      Consultar por WhatsApp
    </a>
  </div>
</article>

<style>
  .viaje {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--papel);
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    overflow: hidden;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .viaje:hover { border-color: var(--linea-fuerte); transform: translateY(-2px); }

  /* ── Foto ── */
  .viaje-foto {
    position: relative;
    aspect-ratio: 4 / 3;
    background: var(--fondo);
    overflow: hidden;
  }
  .viaje-foto img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .viaje:hover .viaje-foto img { transform: scale(1.04); }

  .viaje-sellos {
    position: absolute;
    left: 10px; bottom: 10px;
    display: flex; gap: 6px; flex-wrap: wrap;
  }
  .sello {
    background: rgba(255,255,255,0.94);
    color: var(--tinta);
    font-size: 0.74rem;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    border-radius: 100px;
    backdrop-filter: blur(4px);
    white-space: nowrap;
  }
  .sello-pronto {
    position: absolute;
    top: 10px; left: 10px;
    background: var(--naranja-fuerte);
    color: #fff;
  }

  /* ── Cuerpo ── */
  .viaje-cuerpo {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 1.1rem 1.15rem 1.15rem;
  }

  .viaje-titular {
    font-size: 1.3rem;
    line-height: 1.12;
    letter-spacing: -0.03em;
    font-weight: 700;
    margin: 0;
    color: var(--tinta);
    text-wrap: balance;
  }
  /* El titulo cubre toda la tarjeta, asi se puede hacer click en cualquier lado */
  .viaje-titular a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .viaje:hover .viaje-titular { color: var(--naranja-tinta); }

  .viaje-subtitulo {
    font-size: 0.875rem;
    color: var(--tinta-2);
    margin: 0.3rem 0 0;
    line-height: 1.4;
  }

  /* ── Precio: lo que el cliente viene a buscar ── */
  .viaje-precio { margin-top: auto; padding-top: 1.1rem; }
  .precio-desde {
    display: block;
    font-size: 0.8rem;
    color: var(--tinta-3);
    line-height: 1;
    margin-bottom: 0.15rem;
  }
  .precio-fila { display: flex; align-items: baseline; gap: 0.45rem; flex-wrap: wrap; }
  .precio-fila strong {
    font-size: 1.85rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--tinta);
    line-height: 1.05;
  }
  .precio-fila span { font-size: 0.85rem; color: var(--tinta-2); }
  .precio-letra { font-size: 0.78rem; color: var(--tinta-3); margin: 0.2rem 0 0; }

  .viaje-cuando {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--tinta-2);
    margin: 0.85rem 0 0;
    padding-top: 0.85rem;
    border-top: 1px solid var(--linea);
  }
  .viaje-cuando svg { flex: none; color: var(--tinta-3); }

  .viaje-wa {
    position: relative;
    z-index: 1;
    margin-top: 0.85rem;
    width: 100%;
    padding: 0.7rem 1rem;
    font-size: 0.9rem;
  }
</style>
