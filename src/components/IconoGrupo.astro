---
/**
 * El sellito que acompaña al título de cada bloque del listado.
 * Micrófono para recitales, copa para fin de año, sol para verano.
 */
interface Props {
  tipo: 'micro' | 'copa' | 'sol' | null;
}
const { tipo } = Astro.props;
---

{tipo === 'micro' && (
  <span class="sello-grupo sello-micro" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <rect x="9" y="2" width="6" height="11" rx="3"/>
      <path d="M5 10v1a7 7 0 0 0 14 0v-1"/>
      <line x1="12" y1="18" x2="12" y2="22"/>
      <line x1="8" y1="22" x2="16" y2="22"/>
    </svg>
  </span>
)}

{tipo === 'copa' && (
  <span class="sello-grupo sello-copa" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M7 3h10l-.7 6.2a4.4 4.4 0 0 1-8.6 0z"/>
      <line x1="12" y1="13" x2="12" y2="20"/>
      <line x1="8.5" y1="20" x2="15.5" y2="20"/>
    </svg>
  </span>
)}

{tipo === 'sol' && (
  <span class="sello-grupo sello-sol" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="4.2"/>
      <path d="M12 2v2M12 20v2M4.2 4.2l1.5 1.5M18.3 18.3l1.5 1.5M2 12h2M20 12h2M4.2 19.8l1.5-1.5M18.3 5.7l1.5-1.5"/>
    </svg>
  </span>
)}

<style>
  .sello-grupo {
    width: 34px; height: 34px;
    flex: none;
    display: grid;
    place-items: center;
    border-radius: 10px;
    border: 1px solid;
  }
  .sello-micro { background: #f3eefc; border-color: #e2d6f7; color: #6b3fa0; }
  .sello-copa  { background: var(--naranja-suave); border-color: #f8dcc6; color: var(--naranja-tinta); }
  .sello-sol   { background: #fff8e3; border-color: #f7e7b4; color: #9a6b09; }
</style>
