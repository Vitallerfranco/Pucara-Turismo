---
---

<section class="relative w-full h-screen min-h-[800px] overflow-hidden flex items-center justify-center">
  {/* Background image with overlay */}
  <div class="absolute inset-0 z-0">
    <img 
      src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1920&h=1080&fit=crop"
      alt="Hero background"
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/20 to-black/40"></div>
  </div>

  {/* Content */}
  <div class="relative z-10 container-gutter text-center text-white max-w-3xl mx-auto">
    <div class="mb-6 inline-block px-4 py-2 bg-orange-500/20 border border-orange-400/30 rounded-full backdrop-blur">
      <span class="text-sm font-semibold text-orange-200">✨ +15 años organizando viajes memorables</span>
    </div>

    <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold mb-6 leading-tight">
      El Mejor Viaje al<br />
      <span class="text-orange-300">Norte Argentino</span>
    </h1>

    <p class="text-lg md:text-xl text-white/90 mb-8 max-w-2xl mx-auto leading-relaxed">
      Salinas Grandes, Jujuy, Salta, Mendoza... Sin estrés. Con expertos. 
      <br />
      <strong>Respuesta en WhatsApp en menos de 5 minutos.</strong>
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <a 
        href="#recomendador"
        class="btn btn-primary btn-lg"
      >
        🎯 Descubre tu viaje perfecto
      </a>
      <a 
        href="https://wa.me/5491150000000?text=Hola%20Pucará%20Turismo,%20quiero%20consultar%20disponibilidad"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-outline btn-lg"
      >
        💬 Hablar con Sonia
      </a>
    </div>

    {/* Urgency badge */}
    <div class="mt-12 pt-8 border-t border-white/20">
      <p class="text-sm text-orange-200 font-semibold mb-4">
        🔥 Últimas 3 salidas este mes - Se agota rápido
      </p>
      <div class="flex justify-center gap-6 flex-wrap">
        <div class="text-center">
          <div class="text-2xl font-bold">+8,000</div>
          <p class="text-white/70 text-sm">Viajeros satisfechos</p>
        </div>
        <div class="text-center">
          <div class="text-2xl font-bold">100%</div>
          <p class="text-white/70 text-sm">Con guía y coordinador</p>
        </div>
        <div class="text-center">
          <div class="text-2xl font-bold">4.9/5</div>
          <p class="text-white/70 text-sm">Rating promedio</p>
        </div>
      </div>
    </div>
  </div>

  {/* Scroll indicator */}
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 animate-bounce">
    <div class="w-6 h-10 border-2 border-white rounded-full flex items-center justify-center">
      <div class="w-1 h-2 bg-white rounded-full animate-pulse"></div>
    </div>
  </div>
</section>

<style>
  @media (max-height: 600px) {
    section {
     min-height: 0;
    }
  }
</style>

