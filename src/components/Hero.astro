<section class="relative w-full min-h-screen flex items-center justify-center overflow-hidden bg-[#0e0e0e]">

  {/* Línea decorativa sutil */}
  <div class="absolute inset-0 z-0 pointer-events-none">
    <div style="position:absolute; top:0; left:50%; transform:translateX(-50%); width:1px; height:100%; background:linear-gradient(to bottom, transparent, rgba(255,152,0,0.12), transparent);"></div>
    <div style="position:absolute; top:50%; left:0; width:100%; height:1px; background:linear-gradient(to right, transparent, rgba(255,152,0,0.08), transparent);"></div>
  </div>

  {/* Content */}
  <div class="relative z-10 container-gutter text-center text-white max-w-3xl mx-auto py-24 px-6">

    {/* Badge */}
    <div class="mb-10 inline-flex items-center gap-2 px-4 py-2 border border-white/10 rounded-full">
      <!-- Icono estrella simple -->
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="text-orange-400">
        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
      </svg>
      <span class="text-xs font-medium text-white/50 tracking-widest uppercase">+15 años organizando viajes memorables</span>
    </div>

    {/* H1 */}
    <h1 class="text-5xl sm:text-6xl md:text-7xl font-bold mb-6 leading-[1.1] tracking-tight">
      Tu próxima aventura empieza acá<br />
      <span style="color:#f97316;">con Pucará Turismo</span>
    </h1>

    <p class="text-base sm:text-lg text-white/40 mb-4 max-w-xl mx-auto leading-relaxed font-light">
      Paquetes grupales desde zona oeste del GBA.<br />
      Mar del Plata, Colón, Termas, Sierras y más.
    </p>
    <p class="text-sm text-white/60 mb-12 font-medium">
      Consultá disponibilidad por WhatsApp.
    </p>

    {/* Botones */}
    <div class="flex flex-col sm:flex-row gap-3 justify-center items-center mb-20">
      <a
        href="/Pucara-Turismo/paquetes"
        class="inline-flex items-center gap-2.5 px-6 py-3.5 bg-orange-500 hover:bg-orange-400 text-white text-sm font-semibold rounded-lg transition-colors duration-200"
      >
        <!-- Icono calendario -->
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
          <line x1="16" y1="2" x2="16" y2="6"/>
          <line x1="8" y1="2" x2="8" y2="6"/>
          <line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
        Ver paquetes disponibles
      </a>
      <a
        href="https://wa.me/5491134952847?text=Hola%20Pucará%20Turismo,%20quiero%20consultar%20disponibilidad"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 px-6 py-3.5 border border-white/15 hover:border-white/30 text-white/70 hover:text-white text-sm font-semibold rounded-lg transition-all duration-200"
      >
        <!-- Icono mensaje -->
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
        Consultar por WhatsApp
      </a>
    </div>

    {/* Stats */}
    <div class="pt-10 border-t border-white/8">
      <div class="flex justify-center gap-12 sm:gap-20 flex-wrap">
        <div class="text-center">
          <div class="text-3xl font-bold text-orange-400 mb-1 tabular-nums">15</div>
          <p class="text-white/30 text-xs tracking-wide uppercase">Años de experiencia</p>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-orange-400 mb-1">HAT</div>
          <p class="text-white/30 text-xs tracking-wide uppercase">Travel SRL · Leg. 15157</p>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-orange-400 mb-1">100%</div>
          <p class="text-white/30 text-xs tracking-wide uppercase">Viajes coordinados</p>
        </div>
      </div>
    </div>
  </div>

  {/* Scroll indicator */}
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10">
    <div class="w-5 h-9 border border-white/20 rounded-full flex items-start justify-center pt-1.5">
      <div class="w-0.5 h-2 bg-white/30 rounded-full animate-bounce"></div>
    </div>
  </div>

</section>
