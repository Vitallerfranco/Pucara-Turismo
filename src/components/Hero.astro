---
import type { Paquete } from '@/types';
import { formatPrice, webpSrcset } from '@/lib/utils';
import { partesTitulo, duracionLabel, fechaLarga } from '@/lib/viaje';

interface Props {
  destacado: Paquete;
  whatsappPhone?: string;
}

const { destacado, whatsappPhone = '5491134952847' } = Astro.props;

const { titular, subtitulo } = partesTitulo(destacado.titulo);
const duracion = duracionLabel(destacado);
const foto = webpSrcset(destacado.imagenPrincipal);
const href = `/paquetes/${destacado.slug}/`;
---

<section class="hero">
  <div class="hero-caja">

    <div class="hero-texto">
      <h1>
        Viajes grupales con todo incluido,
        saliendo del oeste del Gran&nbsp;Buenos&nbsp;Aires
      </h1>
      <p class="hero-bajada">
        Bus, hotel, comidas y coordinador en un solo precio. Termas, playa y sierra,
        con fecha confirmada y punto de subida cerca de tu casa.
      </p>

      <div class="hero-botones">
        <a href="/paquetes/" class="btn btn-primary btn-lg">Ver paquetes y precios</a>
        <a
          href={`https://wa.me/${whatsappPhone}?text=${encodeURIComponent('Hola, quiero consultar por los próximos viajes.')}`}
          target="_blank" rel="noopener noreferrer"
          class="btn btn-secondary btn-lg"
        >Escribinos por WhatsApp</a>
      </div>

      <ul class="hero-aval">
        <li>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <span><strong>4,8</strong> con más de 480 reseñas en Google</span>
        </li>
        <li>Más de 15 años organizando viajes</li>
        <li>HAT Travel SRL · Legajo 15157</li>
      </ul>
    </div>

    <a class="hero-foto" href={href} aria-label={`Ver el viaje a ${titular}`}>
      <picture style="display:contents">
        {foto && (
          <source type="image/webp" srcset={foto} sizes="(max-width: 980px) 92vw, 540px" />
        )}
        <img
          src={destacado.imagenPrincipal}
          alt={titular}
          width="1200" height="900"
          fetchpriority="high"
          decoding="async"
        />
      </picture>

      <div class="hero-etiqueta">
        <span class="hero-proxima">Próxima salida · {fechaLarga(destacado.proximaSalida)}</span>
        <strong class="hero-destino">{titular}</strong>
        <span class="hero-detalle">{subtitulo ? `${subtitulo} · ${duracion}` : duracion}</span>
        <span class="hero-precio">
          desde <strong>{formatPrice(destacado.precioBase)}</strong> por persona
        </span>
      </div>
    </a>

  </div>
</section>

<style>
  .hero { padding: 6.5rem 0 2.5rem; }
  @media (min-width: 980px) { .hero { padding: 9rem 0 4rem; } }

  .hero-caja {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 1.25rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.25rem;
    align-items: center;
  }
  @media (min-width: 768px) { .hero-caja { padding: 0 2rem; } }
  @media (min-width: 980px) {
    .hero-caja { grid-template-columns: 1fr 520px; gap: 3.5rem; }
  }

  .hero-texto h1 { margin-bottom: 1rem; max-width: 22ch; }
  .hero-bajada { font-size: 1.05rem; max-width: 48ch; margin-bottom: 1.75rem; }

  .hero-botones { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 1.75rem; }
  @media (max-width: 420px) { .hero-botones .btn { width: 100%; } }

  .hero-aval {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    font-size: 0.85rem;
    color: var(--tinta-2);
  }
  .hero-aval li { display: flex; align-items: center; gap: 0.35rem; }
  .hero-aval svg { color: var(--naranja); flex: none; }
  .hero-aval strong { color: var(--tinta); font-weight: 650; }

  /* ── La foto del proximo viaje, con el precio encima ── */
  .hero-foto {
    position: relative;
    display: block;
    border-radius: var(--radio);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--fondo);
  }
  @media (min-width: 980px) { .hero-foto { aspect-ratio: 5 / 4; } }

  .hero-foto img { width: 100%; height: 100%; object-fit: cover; }

  /* Velo oscuro solo abajo: el texto blanco necesita contraste garantizado */
  .hero-etiqueta {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: 4.5rem 1.25rem 1.25rem;
    background: linear-gradient(to top, rgba(10,11,13,0.92) 0%, rgba(10,11,13,0.72) 45%, rgba(10,11,13,0) 100%);
    color: #fff;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .hero-proxima { font-size: 0.8rem; font-weight: 600; color: #ffd2b0; }
  .hero-destino {
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: #fff;
  }
  .hero-detalle { font-size: 0.875rem; color: rgba(255,255,255,0.84); }
  .hero-precio { margin-top: 0.5rem; font-size: 0.9rem; color: rgba(255,255,255,0.84); }
  .hero-precio strong {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.035em;
    color: #fff;
  }

  .hero-foto::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radio);
    border: 1px solid rgba(0,0,0,0.07);
    pointer-events: none;
  }
</style>
