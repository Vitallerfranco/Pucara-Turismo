---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import '../styles/globals.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description = 'Pucará Turismo - Expertos en viajes al norte argentino',
  image = 'https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1200&h=630&fit=crop',
  type = 'website'
} = Astro.props;

const fullTitle = `${title} | Pucará Turismo`;
const siteUrl = 'https://pucaraturismo.com';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="keywords" content="viajes, norte argentino, turismo, aventura, salinas, iguazú, mendoza" />
  
  {/* Open Graph / Facebook */}
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />
  <meta property="og:site_name" content="Pucará Turismo" />
  <meta property="og:locale" content="es_AR" />

  {/* Twitter / X */}
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={canonicalUrl} />
  <meta property="twitter:title" content={fullTitle} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content={image} />

  {/* Canonical */}
  <link rel="canonical" href={canonicalUrl} />

  {/* SEO adicional */}
  <meta name="robots" content="index, follow" />
  <meta name="geo.region" content="AR-B" />
  <meta name="geo.placename" content="Ituzaingó, Buenos Aires" />
  <meta name="author" content="Pucará Turismo" />

  {/* JSON-LD LocalBusiness */}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "TravelAgency",
    "name": "Pucará Turismo",
    "description": "Agencia de turismo receptivo con más de 15 años organizando viajes grupales por Argentina. Salidas desde zona oeste del GBA.",
    "url": "https://pucaraturismo.com",
    "telephone": "+54-9-11-3495-2847",
    "email": "turismopucara@hotmail.com",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Cnel. Pablo Zufriategui 830",
      "addressLocality": "Ituzaingó",
      "addressRegion": "Buenos Aires",
      "postalCode": "B1714",
      "addressCountry": "AR"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": -34.658747,
      "longitude": -58.6667436
    },
    "openingHoursSpecification": [
      { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "09:00", "closes": "19:00" },
      { "@type": "OpeningHoursSpecification", "dayOfWeek": "Saturday", "opens": "09:00", "closes": "13:00" }
    ],
    "sameAs": [
      "https://www.instagram.com/pucaraturismo.ok/",
      "https://www.facebook.com/Pucaraturismo"
    ],
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.8",
      "reviewCount": "480"
    }
  })} />

  {/* Favicon */}
  <link rel="icon" type="image/png" href="/Pucara-Turismo/favicon.png" />
  <link rel="shortcut icon" href="/Pucara-Turismo/favicon.png" />

  {/* Fonts */}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800;900&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <title>{fullTitle}</title>

  {/* Preload critical resources */}
  <link rel="preload" as="image" href="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1920" />
</head>

<body>
  <Header />
  
  <main class="min-h-screen">
    <slot />
  </main>

  <Footer />

  <!-- Botón flotante WhatsApp -->
  <a
    href="https://wa.me/5491134952847?text=Hola%20Pucará%20Turismo%2C%20quiero%20consultar%20sobre%20un%20viaje"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Consultar por WhatsApp"
    id="wa-float"
    style="
      position: fixed;
      bottom: 28px;
      right: 28px;
      width: 56px;
      height: 56px;
      background: #25d366;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 20px rgba(37,211,102,0.4);
      z-index: 9998;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      opacity: 0;
      animation: wa-appear 0.4s ease 1.5s forwards;
    "
    onmouseover="this.style.transform='scale(1.1)';this.style.boxShadow='0 6px 28px rgba(37,211,102,0.55)'"
    onmouseout="this.style.transform='scale(1)';this.style.boxShadow='0 4px 20px rgba(37,211,102,0.4)'"
  >
    <svg width="26" height="26" viewBox="0 0 24 24" fill="white" xmlns="http://www.w3.org/2000/svg">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
  </a>

  {/* Scripts */}
  <script>
    // Header scroll effect
    const header = document.querySelector('header');

    window.addEventListener('scroll', () => {
      const scrollTop = window.scrollY;

      if (header) {
        if (scrollTop > 50) {
          header.setAttribute('data-scrolled', 'true');
        } else {
          header.removeAttribute('data-scrolled');
        }
      }
    });

    // Intersection Observer for animations
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -100px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animate-in');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    // Observe elements with data-animate attribute
    document.querySelectorAll('[data-animate]').forEach((el) => {
      observer.observe(el);
    });

    // Smooth scroll behavior for anchor links
    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener('click', function (e) {
        const href = this.getAttribute('href');
        if (href === '#') return;
        
        e.preventDefault();
        const target = document.querySelector(href);
        if (target) {
          target.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });
  </script>

  <!-- Popup promo mejorado -->
<div id="promo-overlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.88);z-index:9999;align-items:center;justify-content:center;padding:1rem;backdrop-filter:blur(4px);">
  <div style="background:#0d0d0d;border:1px solid rgba(249,115,22,0.4);border-radius:22px;max-width:460px;width:100%;overflow:hidden;position:relative;box-shadow:0 0 60px rgba(249,115,22,0.15);">

    <!-- Imagen con overlay fuerte -->
    <div style="position:relative;height:210px;overflow:hidden;">
      <img src="/Pucara-Turismo/la-falda-1.jpg" alt="La Falda Invierno" style="width:100%;height:100%;object-fit:cover;" />
      <div style="position:absolute;inset:0;background:linear-gradient(to bottom,rgba(0,0,0,0.3) 0%,rgba(13,13,13,0.97) 100%);"></div>

      <!-- Badge urgencia parpadeante -->
      <div style="position:absolute;top:14px;left:14px;display:flex;align-items:center;gap:6px;">
        <span id="popup-live-dot" style="width:8px;height:8px;background:#ef4444;border-radius:50%;display:inline-block;animation:blink 1.2s infinite;"></span>
        <span style="background:#ef4444;color:white;font-size:0.65rem;font-weight:800;padding:3px 10px;border-radius:20px;letter-spacing:0.1em;text-transform:uppercase;">¡Cupos limitados!</span>
      </div>

      <!-- Texto sobre imagen -->
      <div style="position:absolute;bottom:1rem;left:1.25rem;right:1.25rem;">
        <p style="color:rgba(255,255,255,0.6);font-size:0.72rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;margin:0 0 4px;">✈ Vacaciones de Invierno 2026</p>
        <h3 style="color:white;font-size:1.35rem;font-weight:900;margin:0 0 4px;line-height:1.2;">La Falda, Córdoba</h3>
        <div style="display:flex;align-items:center;gap:8px;">
          <span style="color:#f97316;font-weight:800;font-size:1.15rem;">desde $270.000</span>
          <span style="color:rgba(255,255,255,0.4);font-size:0.8rem;">por persona · 5 días</span>
        </div>
      </div>
    </div>

    <!-- Body -->
    <div style="padding:1.4rem 1.5rem 1.5rem;">

      <!-- Countdown -->
      <div style="background:rgba(249,115,22,0.08);border:1px solid rgba(249,115,22,0.2);border-radius:10px;padding:10px 14px;margin-bottom:14px;display:flex;align-items:center;justify-content:space-between;">
        <span style="font-size:0.78rem;color:rgba(255,255,255,0.5);">⏰ Oferta válida por:</span>
        <span id="popup-countdown" style="font-size:1rem;font-weight:800;color:#f97316;font-variant-numeric:tabular-nums;letter-spacing:0.05em;">15:00</span>
      </div>

      <p style="color:rgba(255,255,255,0.45);font-size:0.82rem;line-height:1.6;margin:0 0 14px;">
        Dejá tu nombre y consultá ahora por WhatsApp — te confirmamos disponibilidad y precio en minutos.
      </p>

      <div style="display:flex;flex-direction:column;gap:8px;">
        <input id="popup-nombre" type="text" placeholder="Tu nombre" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:9px;padding:0.75rem 1rem;color:white;font-size:0.875rem;outline:none;width:100%;box-sizing:border-box;transition:border-color 0.2s;" />

        <button id="popup-btn" style="background:linear-gradient(135deg,#f97316,#ea6c0a);color:white;font-weight:800;border:none;border-radius:9px;padding:0.95rem;font-size:0.95rem;cursor:pointer;transition:opacity 0.2s;display:flex;align-items:center;justify-content:center;gap:8px;letter-spacing:0.02em;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Quiero esta promo → WhatsApp
        </button>
      </div>

      <button id="popup-cerrar-texto" style="background:none;border:none;color:rgba(255,255,255,0.2);font-size:0.74rem;cursor:pointer;margin-top:12px;width:100%;text-align:center;padding:4px;">
        No gracias, no me interesan las promociones
      </button>
    </div>

    <!-- X -->
    <button id="popup-cerrar" style="position:absolute;top:12px;right:12px;background:rgba(0,0,0,0.6);border:1px solid rgba(255,255,255,0.1);color:rgba(255,255,255,0.7);width:30px;height:30px;border-radius:50%;font-size:14px;cursor:pointer;display:flex;align-items:center;justify-content:center;line-height:1;">✕</button>
  </div>
</div>

<style is:global>
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.2; }
  }
</style>

<script>
  if (!sessionStorage.getItem('popup-cerrado')) {
    setTimeout(() => {
      const overlay = document.getElementById('promo-overlay');
      if (overlay) {
        overlay.style.display = 'flex';
        startCountdown();
      }
    }, 3000);
  }

  function cerrarPopup() {
    const overlay = document.getElementById('promo-overlay');
    if (overlay) overlay.style.display = 'none';
    sessionStorage.setItem('popup-cerrado', '1');
  }

  function startCountdown() {
    let secs = 15 * 60; // 15 minutos
    const el = document.getElementById('popup-countdown');
    if (!el) return;
    const iv = setInterval(() => {
      secs--;
      if (secs <= 0) { clearInterval(iv); return; }
      const m = Math.floor(secs / 60).toString().padStart(2, '0');
      const s = (secs % 60).toString().padStart(2, '0');
      el.textContent = `${m}:${s}`;
      if (secs <= 120) el.style.color = '#ef4444';
    }, 1000);
  }

  document.getElementById('popup-cerrar')?.addEventListener('click', cerrarPopup);
  document.getElementById('popup-cerrar-texto')?.addEventListener('click', cerrarPopup);
  document.getElementById('promo-overlay')?.addEventListener('click', function(e) {
    if (e.target === this) cerrarPopup();
  });

  const nombreInput = document.getElementById('popup-nombre') as HTMLInputElement | null;
  document.getElementById('popup-nombre')?.addEventListener('focus', function(this: HTMLInputElement) {
    this.style.borderColor = 'rgba(249,115,22,0.5)';
  });

  document.getElementById('popup-btn')?.addEventListener('click', () => {
    const nombre = (document.getElementById('popup-nombre') as HTMLInputElement)?.value.trim();
    if (!nombre) {
      const inp = document.getElementById('popup-nombre') as HTMLInputElement;
      inp.style.borderColor = '#ef4444';
      inp.focus();
      return;
    }
    const msg = encodeURIComponent(`Hola Pucará Turismo! Me llamo ${nombre} y vi la promo de La Falda en su web. ¿Tienen lugar disponible? ¿Cuáles son los próximos pasos?`);
    window.open(`https://wa.me/5491134952847?text=${msg}`, '_blank');
    cerrarPopup();
  });
</script>
</body>
</html>

<style is:global>
  header[data-scrolled="true"] {
    background: rgba(14, 14, 14, 0.97);
    backdrop-filter: blur(16px);
    box-shadow: 0 1px 12px rgba(0,0,0,0.5);
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  @keyframes wa-appear {
    from { opacity: 0; transform: scale(0.8); }
    to   { opacity: 1; transform: scale(1); }
  }

  @keyframes slideInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  [data-animate].animate-in {
    animation: slideInUp 0.6s ease-out forwards;
  }

  @supports (scroll-behavior: smooth) {
    html {
      scroll-behavior: smooth;
    }
  }
</style>



