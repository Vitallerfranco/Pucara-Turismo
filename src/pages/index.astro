---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import PaqueteCard from '@/components/PaqueteCard.astro';
import Recomendador from '@/components/Recomendador.jsx';
import paquetesData from '@/data/paquetes.json';

const paquetesDestacados = paquetesData.paquetes.slice(0, 3);
const WA = "5491134952847";
---

<BaseLayout 
  title="Paquetes Turísticos desde Buenos Aires"
  description="Viajes grupales desde zona oeste de Buenos Aires. Mar del Plata, Colón, Río Hondo, San Bernardo y más. 15 años llevando gente de viaje."
>
  <Hero />

  {/* Recomendador widget */}
  <section id="recomendador" class="section-space bg-gradient-to-b from-slate-50 to-white">
    <div class="container-gutter max-w-3xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="mb-4">🎯 Encontrá tu viaje ideal</h2>
        <p class="text-slate-600 text-lg">
          Respondé unas preguntas y te recomendamos el paquete perfecto para vos.
        </p>
      </div>
      <Recomendador client:load />
    </div>
  </section>

  {/* Featured packages */}
  <section class="section-space bg-gradient-to-b from-white to-slate-50">
    <div class="container-gutter">
      <div class="text-center mb-12">
        <h2 class="mb-4">Paquetes destacados</h2>
        <p class="text-slate-600 text-lg max-w-2xl mx-auto">
          Nuestros viajes más populares. Salidas desde zona oeste con todo incluido.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
        {paquetesDestacados.map((paquete) => (
          <PaqueteCard paquete={paquete} whatsappPhone={WA} />
        ))}
      </div>

      <div class="text-center">
        <a href="/Pucara-Turismo/paquetes" class="btn btn-primary btn-lg">
          Ver todos los paquetes →
        </a>
      </div>
    </div>
  </section>

  {/* Why choose us */}
  <section id="sobre" class="section-space bg-white">
    <div class="container-gutter max-w-5xl">
      <h2 class="text-center mb-12">¿Por qué elegir Pucará Turismo?</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
        <div class="flex gap-4">
          <div class="flex-shrink-0 w-12 h-12 bg-orange-100 rounded-xl flex items-center justify-center text-2xl">
            🗓️
          </div>
          <div>
            <h3 class="font-bold mb-2">15 años de experiencia</h3>
            <p class="text-slate-600">Desde Ituzaingó llevamos gente de viaje por todo el país. Sabemos lo que funciona y lo que no.</p>
          </div>
        </div>

        <div class="flex gap-4">
          <div class="flex-shrink-0 w-12 h-12 bg-orange-100 rounded-xl flex items-center justify-center text-2xl">
            💬
          </div>
          <div>
            <h3 class="font-bold mb-2">Atención por WhatsApp</h3>
            <p class="text-slate-600">Nuestros vendedores te responden rápido. Antes de reservar, durante el viaje y cuando volvés.</p>
          </div>
        </div>

        <div class="flex gap-4">
          <div class="flex-shrink-0 w-12 h-12 bg-orange-100 rounded-xl flex items-center justify-center text-2xl">
            🚌
          </div>
          <div>
            <h3 class="font-bold mb-2">Salidas desde zona oeste</h3>
            <p class="text-slate-600">Partís desde Ituzaingó y alrededores. Sin traslados complicados ni puntos de encuentro lejanos.</p>
          </div>
        </div>

        <div class="flex gap-4">
          <div class="flex-shrink-0 w-12 h-12 bg-orange-100 rounded-xl flex items-center justify-center text-2xl">
            ✅
          </div>
          <div>
            <h3 class="font-bold mb-2">Todo incluido, sin sorpresas</h3>
            <p class="text-slate-600">Hotel, transporte, comidas y actividades en un solo precio. Sabés lo que pagás desde el primer día.</p>
          </div>
        </div>
      </div>

      <div class="divider"></div>

      <div class="bg-gradient-to-br from-orange-50 to-orange-100 rounded-2xl p-8 md:p-12 text-center">
        <h3 class="text-2xl font-bold mb-4">¿Tenés alguna duda?</h3>
        <p class="text-slate-700 mb-6">
          Escribinos por WhatsApp y uno de nuestros vendedores te ayuda a elegir el viaje ideal.
        </p>
        <a 
          href={`https://wa.me/${WA}?text=Hola%20Pucará%20Turismo,%20quiero%20consultar%20opciones%20de%20viaje`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary btn-lg"
        >
          💬 Consultar ahora
        </a>
      </div>
    </div>
  </section>

  {/* FAQ */}
  <section id="faq" class="section-space bg-slate-50">
    <div class="container-gutter max-w-3xl">
      <h2 class="text-center mb-12">Preguntas frecuentes</h2>

      <div class="space-y-4">
        <details class="group card p-6 cursor-pointer">
          <summary class="font-bold text-lg flex items-center gap-4">
            <span class="text-xl">+</span>
            ¿De dónde salen los viajes?
            <span class="ml-auto group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <div class="mt-4 text-slate-600 leading-relaxed">
            Todos nuestros viajes salen desde Ituzaingó, zona oeste del GBA. Consultanos por el punto de encuentro exacto según el paquete.
          </div>
        </details>

        <details class="group card p-6 cursor-pointer">
          <summary class="font-bold text-lg flex items-center gap-4">
            <span class="text-xl">+</span>
            ¿Cómo reservo un lugar?
            <span class="ml-auto group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <div class="mt-4 text-slate-600 leading-relaxed">
            Escribinos por WhatsApp o Instagram. Te confirmamos disponibilidad y te explicamos cómo abonar la seña para asegurar tu lugar.
          </div>
        </details>

        <details class="group card p-6 cursor-pointer">
          <summary class="font-bold text-lg flex items-center gap-4">
            <span class="text-xl">+</span>
            ¿Qué incluyen los paquetes?
            <span class="ml-auto group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <div class="mt-4 text-slate-600 leading-relaxed">
            Cada paquete detalla exactamente qué incluye: transporte, alojamiento, comidas y actividades. Revisá el detalle de cada viaje antes de reservar.
          </div>
        </details>

        <details class="group card p-6 cursor-pointer">
          <summary class="font-bold text-lg flex items-center gap-4">
            <span class="text-xl">+</span>
            ¿Puedo viajar solo/sola?
            <span class="ml-auto group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <div class="mt-4 text-slate-600 leading-relaxed">
            Sí, muchos de nuestros pasajeros viajan solos. Tenemos paquetes especiales para solos y solas como el de Colón. Los viajes grupales son ideales para conocer gente nueva.
          </div>
        </details>
      </div>

      <div class="mt-12 text-center">
        <p class="text-slate-600 mb-4">¿Más dudas?</p>
        <a 
          href={`https://wa.me/${WA}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
        >
          💬 Escribinos por WhatsApp
        </a>
      </div>
    </div>
  </section>

  {/* CTA Final */}
  <section class="section-space bg-gradient-to-r from-orange-500 via-orange-400 to-orange-600 text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-0 right-0 w-96 h-96 bg-white rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 left-0 w-96 h-96 bg-white rounded-full blur-3xl"></div>
    </div>

    <div class="container-gutter relative z-10 text-center max-w-3xl mx-auto">
      <h2 class="mb-4 text-4xl md:text-5xl">¿Te vas de viaje?</h2>
      <p class="text-xl mb-8 text-white/90">
        Consultá disponibilidad ahora. Los cupos se llenan rápido.
      </p>
      <a 
        href={`https://wa.me/${WA}?text=Hola%20Pucará%20Turismo,%20quiero%20consultar%20disponibilidad`}
        target="_blank"
        rel="noopener noreferrer"
        class="btn bg-white text-orange-600 hover:bg-slate-100 btn-lg"
      >
        💬 Consultar disponibilidad
      </a>
    </div>
  </section>
</BaseLayout>