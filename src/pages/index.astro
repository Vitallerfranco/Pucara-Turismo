---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import PaqueteCard from '@/components/PaqueteCard.astro';
import Recomendador from '@/components/Recomendador.tsx';
import paquetesData from '@/data/paquetes.json';

// Mostrar los 3 primeros con las fechas más próximas
const paquetesDestacados = [...paquetesData.paquetes]
  .sort((a, b) => new Date(a.proximaSalida).getTime() - new Date(b.proximaSalida).getTime())
  .slice(0, 3);
const WA = "5491134952847";
---

<BaseLayout 
  title="Paquetes Turísticos desde Buenos Aires"
  description="Viajes grupales desde zona oeste de Buenos Aires. Mar del Plata, Colón, Río Hondo, San Bernardo y más. 15 años llevando gente de viaje."
>
  <Hero />

  {/* Recomendador */}
  <section id="recomendador" class="section-space bg-[#0e0e0e] border-t border-white/6">
    <div class="container-gutter max-w-3xl mx-auto">
      <div class="text-center mb-14">
        <span class="inline-flex items-center gap-2 text-xs font-medium text-white/30 uppercase tracking-widest mb-4">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="text-orange-400">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
          Recomendador
        </span>
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">Encontrá tu viaje ideal</h2>
        <p class="text-white/40 text-base leading-relaxed max-w-xl mx-auto">
          Respondé unas preguntas y te recomendamos el paquete perfecto para vos.
        </p>
      </div>
      <Recomendador client:load />
    </div>
  </section>

  {/* Paquetes destacados */}
  <section class="section-space bg-[#0e0e0e] border-t border-white/6">
    <div class="container-gutter max-w-7xl mx-auto">
      <div class="text-center mb-14">
        <span class="inline-block text-xs font-medium text-white/30 uppercase tracking-widest mb-4">Paquetes</span>
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">Paquetes destacados</h2>
        <p class="text-white/40 text-base max-w-xl mx-auto leading-relaxed">
          Nuestros viajes más populares. Salidas desde zona oeste con todo incluido.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mb-12">
        {paquetesDestacados.map((paquete) => (
          <PaqueteCard paquete={paquete} whatsappPhone={WA} />
        ))}
      </div>

      <div class="text-center">
        <a href="/Pucara-Turismo/paquetes" class="inline-flex items-center gap-2 px-6 py-3 border border-white/15 hover:border-white/30 text-white/60 hover:text-white text-sm font-medium rounded-lg transition-all duration-200">
          Ver todos los paquetes
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  {/* Por qué elegirnos */}
  <section id="sobre" class="section-space bg-[#0e0e0e] border-t border-white/6">
    <div class="container-gutter max-w-5xl mx-auto">
      <div class="text-center mb-14">
        <span class="inline-block text-xs font-medium text-white/30 uppercase tracking-widest mb-4">Nosotros</span>
        <h2 class="text-3xl sm:text-4xl font-bold text-white">¿Por qué elegir Pucará Turismo?</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-white/6 rounded-2xl overflow-hidden border border-white/6">

        <div class="flex gap-5 p-8 bg-[#0e0e0e] hover:bg-white/3 transition-colors duration-200">
          <div class="flex-shrink-0 w-10 h-10 border border-white/10 rounded-lg flex items-center justify-center text-orange-400">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
              <line x1="16" y1="2" x2="16" y2="6"/>
              <line x1="8" y1="2" x2="8" y2="6"/>
              <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-white text-base mb-2">15 años de experiencia real</h3>
            <p class="text-white/35 text-sm leading-relaxed">Somos HAT Travel SRL, agencia habilitada (Leg. 15157). Organizamos viajes grupales desde hace más de 15 años. Sabemos exactamente lo que funciona.</p>
          </div>
        </div>

        <div class="flex gap-5 p-8 bg-[#0e0e0e] hover:bg-white/3 transition-colors duration-200">
          <div class="flex-shrink-0 w-10 h-10 border border-white/10 rounded-lg flex items-center justify-center text-orange-400">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-white text-base mb-2">Atención directa por WhatsApp</h3>
            <p class="text-white/35 text-sm leading-relaxed">Sin call centers ni formularios. Te responde una persona real en minutos. Antes, durante y después del viaje.</p>
          </div>
        </div>

        <div class="flex gap-5 p-8 bg-[#0e0e0e] hover:bg-white/3 transition-colors duration-200">
          <div class="flex-shrink-0 w-10 h-10 border border-white/10 rounded-lg flex items-center justify-center text-orange-400">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="3" width="15" height="13" rx="2"/>
              <path d="M16 8h4l3 3v5h-7V8z"/>
              <circle cx="5.5" cy="18.5" r="2.5"/>
              <circle cx="18.5" cy="18.5" r="2.5"/>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-white text-base mb-2">Múltiples puntos de subida en el GBA</h3>
            <p class="text-white/35 text-sm leading-relaxed">Tenemos puntos de subida en Liniers, Haedo, Morón, Ituzaingó, Castelar, Palermo, Once y más. Subís cerca de tu casa.</p>
          </div>
        </div>

        <div class="flex gap-5 p-8 bg-[#0e0e0e] hover:bg-white/3 transition-colors duration-200">
          <div class="flex-shrink-0 w-10 h-10 border border-white/10 rounded-lg flex items-center justify-center text-orange-400">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-white text-base mb-2">Precio claro, sin sorpresas</h3>
            <p class="text-white/35 text-sm leading-relaxed">Bus, hotel, comidas y coordinador en un solo precio. Lo que ves es lo que pagás. Nada oculto al llegar.</p>
          </div>
        </div>

      </div>

      {/* CTA inline */}
      <div class="mt-8 p-8 border border-white/8 rounded-2xl flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>
          <h3 class="text-white font-semibold text-lg mb-1">¿Tenés alguna duda?</h3>
          <p class="text-white/35 text-sm">Escribinos y te ayudamos a elegir el viaje ideal.</p>
        </div>
        <a 
          href={`https://wa.me/${WA}?text=Hola%20Pucará%20Turismo,%20quiero%20consultar%20opciones%20de%20viaje`}
          target="_blank"
          rel="noopener noreferrer"
          class="flex-shrink-0 inline-flex items-center gap-2 px-5 py-2.5 bg-orange-500 hover:bg-orange-400 text-white text-sm font-semibold rounded-lg transition-colors duration-200"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
          Consultar ahora
        </a>
      </div>
    </div>
  </section>

  {/* FAQ */}
  <section id="faq" class="section-space bg-[#0e0e0e] border-t border-white/6">
    <div class="container-gutter max-w-3xl mx-auto">
      <div class="text-center mb-14">
        <span class="inline-block text-xs font-medium text-white/30 uppercase tracking-widest mb-4">FAQ</span>
        <h2 class="text-3xl sm:text-4xl font-bold text-white">Preguntas frecuentes</h2>
      </div>

      <div class="divide-y divide-white/6 border border-white/6 rounded-2xl overflow-hidden">

        <details class="group">
          <summary class="flex items-center justify-between px-6 py-5 cursor-pointer text-white/70 hover:text-white transition-colors duration-200 list-none">
            <span class="font-medium text-sm">¿De dónde salen los viajes?</span>
            <svg class="w-4 h-4 text-white/30 group-open:rotate-180 transition-transform duration-200 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </summary>
          <div class="px-6 pb-5 text-white/35 text-sm leading-relaxed">
            Todos nuestros viajes salen desde Ituzaingó, zona oeste del GBA. Consultanos por el punto de encuentro exacto según el paquete.
          </div>
        </details>

        <details class="group">
          <summary class="flex items-center justify-between px-6 py-5 cursor-pointer text-white/70 hover:text-white transition-colors duration-200 list-none">
            <span class="font-medium text-sm">¿Cómo reservo un lugar?</span>
            <svg class="w-4 h-4 text-white/30 group-open:rotate-180 transition-transform duration-200 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </summary>
          <div class="px-6 pb-5 text-white/35 text-sm leading-relaxed">
            Escribinos por WhatsApp o Instagram. Te confirmamos disponibilidad y te explicamos cómo abonar la seña para asegurar tu lugar.
          </div>
        </details>

        <details class="group">
          <summary class="flex items-center justify-between px-6 py-5 cursor-pointer text-white/70 hover:text-white transition-colors duration-200 list-none">
            <span class="font-medium text-sm">¿Qué incluyen los paquetes?</span>
            <svg class="w-4 h-4 text-white/30 group-open:rotate-180 transition-transform duration-200 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </summary>
          <div class="px-6 pb-5 text-white/35 text-sm leading-relaxed">
            Cada paquete detalla exactamente qué incluye: transporte, alojamiento, comidas y actividades. Revisá el detalle de cada viaje antes de reservar.
          </div>
        </details>

        <details class="group">
          <summary class="flex items-center justify-between px-6 py-5 cursor-pointer text-white/70 hover:text-white transition-colors duration-200 list-none">
            <span class="font-medium text-sm">¿Puedo viajar solo/sola?</span>
            <svg class="w-4 h-4 text-white/30 group-open:rotate-180 transition-transform duration-200 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </summary>
          <div class="px-6 pb-5 text-white/35 text-sm leading-relaxed">
            Sí, muchos de nuestros pasajeros viajan solos. Tenemos paquetes especiales para solos y solas como el de Colón. Los viajes grupales son ideales para conocer gente nueva.
          </div>
        </details>

      </div>

      <div class="mt-10 text-center">
        <p class="text-white/30 text-sm mb-4">¿Más dudas?</p>
        <a 
          href={`https://wa.me/${WA}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 border border-white/12 hover:border-white/25 text-white/50 hover:text-white text-sm font-medium rounded-lg transition-all duration-200"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
          Escribinos por WhatsApp
        </a>
      </div>
    </div>
  </section>

  {/* CTA Final */}
  <section class="section-space bg-[#0e0e0e] border-t border-white/6">
    <div class="container-gutter max-w-3xl mx-auto text-center">
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white mb-4">¿Cuándo es tu próximo viaje?</h2>
      <p class="text-white/35 text-base mb-10 leading-relaxed">
        Tenemos salidas confirmadas para junio y julio. Los cupos son limitados — asegurá el tuyo antes de que se llenen.
      </p>
      <a 
        href={`https://wa.me/${WA}?text=Hola%20Pucará%20Turismo,%20quiero%20consultar%20disponibilidad`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 px-7 py-3.5 bg-orange-500 hover:bg-orange-400 text-white text-sm font-semibold rounded-lg transition-colors duration-200"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
        Consultar disponibilidad
      </a>
    </div>
  </section>

</BaseLayout>