---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import PaqueteCard from '@/components/PaqueteCard.astro';
import paquetesData from '@/data/paquetes.json';
import { partesTitulo, fechaLarga } from '@/lib/viaje';

const WA = '5491134952847';

const porFecha = [...paquetesData.paquetes].sort(
  (a, b) => new Date(a.proximaSalida).getTime() - new Date(b.proximaSalida).getTime()
);
const destacado = porFecha[0];
const proximas = porFecha.slice(1, 7);

// Un chip por destino, con el precio mas bajo de ese destino: el gancho es el precio
const destinos = Object.values(
  porFecha.reduce((acc: Record<string, { clave: string; label: string; desde: number }>, p) => {
    const clave = p.destino;
    if (!acc[clave]) acc[clave] = { clave, label: partesTitulo(p.titulo).titular, desde: p.precioBase };
    acc[clave].desde = Math.min(acc[clave].desde, p.precioBase);
    return acc;
  }, {})
).sort((a, b) => a.desde - b.desde);

const resenas = [
  {
    nombre: 'Monica Graciela Carballo',
    texto: 'Excelente viaje a Tilcara, muy recomendable. Cumplen con todo lo ofrecido. El hotel bárbaro, la comida de 10 y la coordinadora Sonia excelente. ¡¡¡Recomiendo Pucará Turismo!!!',
  },
  {
    nombre: 'Vanesa Bisquerra',
    texto: 'Hermosa experiencia viajando con Pucará. Hicimos Salta con excursiones a Jujuy y Tucumán. Nos sentimos muy cómodos y cuidados. Vinimos muy felices y conformes con todos los servicios.',
  },
  {
    nombre: 'Claudia — Aquí y Ahora',
    texto: '¡Fuimos a Tinogasta, 5 merecidas estrellas! El micro excelente, el hotel un lujo de limpieza y atención, la comida exquisita. ¡Y Sonia coordinando magistralmente! Gracias por un viaje inolvidable.',
  },
];

const razones = [
  {
    titulo: 'El precio es el precio',
    texto: 'Bus, hotel, comidas y coordinador en un solo número. Los gastos administrativos están a la vista en cada viaje. No aparece nada nuevo al llegar.',
  },
  {
    titulo: 'Subís cerca de tu casa',
    texto: 'Tenemos puntos de subida en Liniers, Haedo, Morón, Ituzaingó, Castelar, Palermo y Once. Coordinamos el tuyo cuando reservás.',
  },
  {
    titulo: 'Te atiende una persona',
    texto: 'Sin call center ni formularios. Escribís por WhatsApp y te responde alguien del equipo, antes, durante y después del viaje.',
  },
  {
    titulo: 'Agencia habilitada hace 15 años',
    texto: 'Somos HAT Travel SRL, legajo 15157. Más de 15 años armando viajes grupales por Argentina y más de 480 reseñas en Google que lo respaldan.',
  },
];

const preguntas = [
  {
    q: '¿De dónde salen los viajes?',
    a: 'Salimos del oeste del Gran Buenos Aires, con varios puntos de subida: Liniers, Haedo, Morón, Ituzaingó, Castelar, Palermo y Once. Al reservar coordinamos cuál te queda mejor.',
  },
  {
    q: '¿Cómo reservo un lugar?',
    a: 'Escribinos por WhatsApp con el viaje que te interesa. Te confirmamos si hay lugar y te explicamos cómo abonar la seña para dejarlo tomado.',
  },
  {
    q: '¿Qué incluye el precio?',
    a: 'Cada viaje lista exactamente qué incluye y qué no: transporte, alojamiento, comidas y excursiones. El precio que ves es por persona, y aparte van los gastos administrativos, que también están indicados.',
  },
  {
    q: '¿Puedo viajar solo o sola?',
    a: 'Sí, mucha gente viaja sola con nosotros. Si querés habitación para vos, el suplemento single es del 50% sobre el valor del paquete; si no, te ubicamos compartiendo con otros pasajeros.',
  },
  {
    q: '¿Viajan chicos?',
    a: 'Sí. Los menores de 4 años pagan solamente los gastos administrativos. De ahí en adelante abonan como un pasajero más.',
  },
];
---

<BaseLayout
  title="Viajes grupales desde Buenos Aires"
  description="Viajes grupales con bus, hotel y comidas incluidas desde el oeste del Gran Buenos Aires. Termas de Colón, Mar del Plata, Las Grutas, San Bernardo y más, con fecha y precio por persona."
>
  <Hero destacado={destacado} whatsappPhone={WA} />

  {/* ── Próximas salidas ─────────────────────────────────────────────── */}
  <section class="section-space franja">
    <div class="caja">
      <div class="cabecera-seccion">
        <div>
          <span class="antetitulo">Fechas confirmadas</span>
          <h2>Próximas salidas</h2>
          <p>Todas con lugar disponible al día de hoy. El precio es por persona.</p>
        </div>
        <a href="/paquetes/" class="btn btn-secondary">Ver las {porFecha.length} salidas</a>
      </div>

      <div class="fila-desliz">
        {proximas.map((p) => (
          <PaqueteCard paquete={p} whatsappPhone={WA} />
        ))}
      </div>
    </div>
  </section>

  {/* ── Destinos ─────────────────────────────────────────────────────── */}
  <section class="section-space">
    <div class="caja">
      <div class="cabecera-seccion">
        <div>
          <span class="antetitulo">A dónde vamos</span>
          <h2>Elegí por destino</h2>
          <p>El precio más bajo que tenemos hoy en cada lugar.</p>
        </div>
      </div>

      <ul class="destinos">
        {destinos.map((d) => (
          <li>
            <a href={`/paquetes/?destino=${d.clave}`}>
              <span class="destinos-nombre">{d.label}</span>
              <span class="destinos-precio">desde ${d.desde.toLocaleString('es-AR')}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ── Por qué ──────────────────────────────────────────────────────── */}
  <section id="sobre" class="section-space franja">
    <div class="caja">
      <div class="cabecera-seccion">
        <div>
          <span class="antetitulo">Cómo trabajamos</span>
          <h2>Por qué viajar con Pucará</h2>
        </div>
      </div>

      <div class="razones">
        {razones.map((r) => (
          <div class="razon">
            <h3>{r.titulo}</h3>
            <p>{r.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── Reseñas ──────────────────────────────────────────────────────── */}
  <section class="section-space">
    <div class="caja">
      <div class="cabecera-seccion">
        <div>
          <span class="antetitulo">Lo que dicen</span>
          <h2>Viajeros que ya fueron</h2>
          <p class="resenas-nota">
            <span class="estrellas" aria-hidden="true">
              {Array(5).fill(0).map(() => (
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              ))}
            </span>
            <strong>4,8</strong> sobre más de 480 reseñas en Google
          </p>
        </div>
        <a href="/resenas/" class="btn btn-secondary">Ver todas las reseñas</a>
      </div>

      <div class="resenas">
        {resenas.map((r) => (
          <figure class="resena">
            <blockquote>{r.texto}</blockquote>
            <figcaption>
              <span class="resena-inicial" aria-hidden="true">{r.nombre.charAt(0)}</span>
              {r.nombre}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  {/* ── Preguntas ────────────────────────────────────────────────────── */}
  <section id="faq" class="section-space franja">
    <div class="caja caja-angosta">
      <div class="cabecera-seccion">
        <div>
          <span class="antetitulo">Antes de reservar</span>
          <h2>Preguntas frecuentes</h2>
        </div>
      </div>

      <div class="preguntas">
        {preguntas.map((p) => (
          <details>
            <summary>
              {p.q}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </summary>
            <p>{p.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* ── Cierre ───────────────────────────────────────────────────────── */}
  <section class="section-space">
    <div class="caja">
      <div class="cierre">
        <div>
          <h2>La próxima sale el {fechaLarga(destacado.proximaSalida)}</h2>
          <p>Decinos cuántos son y te confirmamos lugar y punto de subida en el día.</p>
        </div>
        <a
          href={`https://wa.me/${WA}?text=${encodeURIComponent('Hola, quiero consultar disponibilidad para un viaje.')}`}
          target="_blank" rel="noopener noreferrer"
          class="btn btn-primary btn-lg"
        >Consultar disponibilidad</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .caja { max-width: 1180px; margin: 0 auto; padding: 0 1.25rem; }
  @media (min-width: 768px) { .caja { padding: 0 2rem; } }
  .caja-angosta { max-width: 780px; }

  /* ── Destinos ── */
  .destinos {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(215px, 1fr));
    gap: 0.75rem;
  }
  .destinos li { display: flex; }
  .destinos a {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.1rem;
    padding: 0.9rem 1.05rem;
    background: var(--papel);
    border: 1px solid var(--linea);
    border-radius: var(--radio-ch);
    transition: border-color 0.16s ease;
  }
  .destinos a:hover { border-color: var(--tinta); }
  .destinos-nombre { font-weight: 600; font-size: 0.95rem; color: var(--tinta); }
  .destinos-precio { font-size: 0.85rem; color: var(--tinta-2); }

  /* ── Razones: separadas por lineas, sin cajas ── */
  .razones {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid var(--linea);
  }
  @media (min-width: 760px) { .razones { grid-template-columns: 1fr 1fr; column-gap: 3rem; } }
  .razon { padding: 1.5rem 0; border-bottom: 1px solid var(--linea); }
  .razon h3 { margin-bottom: 0.35rem; }
  .razon p { margin: 0; font-size: 0.95rem; max-width: 46ch; }

  /* ── Reseñas ── */
  .resenas-nota {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
    font-size: 0.9rem;
    margin: 0.5rem 0 0;
  }
  .estrellas { display: inline-flex; gap: 1px; color: var(--naranja); }
  .resenas-nota strong { color: var(--tinta); }

  .resenas {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 760px) { .resenas { grid-template-columns: repeat(3, 1fr); } }

  .resena {
    margin: 0;
    padding: 1.4rem;
    background: var(--papel);
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    display: flex;
    flex-direction: column;
  }
  .resena blockquote {
    margin: 0 0 1.1rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--tinta);
    flex: 1;
  }
  .resena blockquote::before { content: '“'; }
  .resena blockquote::after { content: '”'; }
  .resena figcaption {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-top: 1rem;
    border-top: 1px solid var(--linea);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--tinta);
  }
  .resena-inicial {
    width: 32px; height: 32px;
    flex: none;
    border-radius: 50%;
    background: var(--naranja-suave);
    color: var(--naranja-fuerte);
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: 0.85rem;
  }

  /* ── Preguntas ── */
  .preguntas {
    border-top: 1px solid var(--linea);
  }
  .preguntas details { border-bottom: 1px solid var(--linea); }
  .preguntas summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 0;
    cursor: pointer;
    list-style: none;
    font-size: 1rem;
    font-weight: 600;
    color: var(--tinta);
  }
  .preguntas summary::-webkit-details-marker { display: none; }
  .preguntas summary svg { flex: none; color: var(--tinta-3); transition: transform 0.2s ease; }
  .preguntas details[open] summary svg { transform: rotate(180deg); }
  .preguntas p { margin: 0 0 1.1rem; font-size: 0.95rem; max-width: 62ch; }

  /* ── Cierre ── */
  .cierre {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding: 2rem;
    background: var(--papel);
    border: 1px solid var(--linea);
    border-radius: var(--radio);
  }
  .cierre h2 { margin-bottom: 0.3rem; }
  .cierre p { margin: 0; }
</style>
