---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PaqueteCard from '@/components/PaqueteCard.astro';
import paquetesData from '@/data/paquetes.json';
import { partesTitulo } from '@/lib/viaje';

const WA = '5491134952847';

const paquetes = [...paquetesData.paquetes].sort(
  (a, b) => new Date(a.proximaSalida).getTime() - new Date(b.proximaSalida).getTime()
);
const politicas = paquetesData.politicasGlobales;

// Los destinos salen de los viajes cargados: si el panel da de baja el ultimo
// viaje de un destino, el filtro desaparece solo.
const nombreDestino = (p: (typeof paquetes)[number]) => partesTitulo(p.titulo).titular;
const destinos = Object.values(
  paquetes.reduce((acc: Record<string, { clave: string; label: string; n: number }>, p) => {
    const clave = p.destino;
    if (!acc[clave]) acc[clave] = { clave, label: nombreDestino(p), n: 0 };
    acc[clave].n++;
    return acc;
  }, {})
).sort((a, b) => b.n - a.n);
---

<BaseLayout
  title="Todos nuestros viajes"
  description="Todas las salidas confirmadas de Pucará Turismo, con precio por persona y fecha. Termas, playa y sierra con bus, hotel y comidas incluidas desde el Gran Buenos Aires."
>

  <section class="lst-cabecera">
    <div class="lst-caja">
      <h1>Todos los paquetes</h1>
      <p class="lst-bajada">
        Cada viaje tiene su fecha y su precio por persona. Elegí el que te sirve y escribinos:
        te confirmamos lugar y punto de subida en el día.
      </p>
    </div>
  </section>

  <section class="lst-filtros-barra">
    <div class="lst-caja">
      <div class="lst-chips" role="group" aria-label="Filtrar por destino">
        <button type="button" class="chip activo" data-destino="">Todos</button>
        {destinos.map((d) => (
          <button type="button" class="chip" data-destino={d.clave}>{d.label}</button>
        ))}
      </div>

      <div class="lst-controles">
        <label class="lst-control">
          <span>Duración</span>
          <select id="f-duracion">
            <option value="">Todas</option>
            <option value="full_day">Full day</option>
            <option value="con_noches">Con noches</option>
          </select>
        </label>
        <label class="lst-control">
          <span>Ordenar por</span>
          <select id="f-orden">
            <option value="fecha">Próxima salida</option>
            <option value="precio-asc">Precio: menor primero</option>
            <option value="precio-desc">Precio: mayor primero</option>
          </select>
        </label>
      </div>

      <p class="lst-cuenta" id="lst-cuenta" aria-live="polite"></p>
    </div>
  </section>

  <section class="lst-cuerpo">
    <div class="lst-caja">
      <div class="lst-grilla" id="lst-grilla">
        {paquetes.map((paquete, i) => (
          <div
            class="lst-item"
            data-destino={paquete.destino}
            data-tipo={paquete.tipo === 'full_day' ? 'full_day' : 'con_noches'}
            data-precio={paquete.precioBase}
            data-fecha={paquete.proximaSalida}
          >
            <PaqueteCard paquete={paquete} whatsappPhone={WA} prioridad={i < 3} />
          </div>
        ))}
      </div>

      <div class="lst-vacio" id="lst-vacio" hidden>
        <h3>No hay paquetes con ese filtro</h3>
        <p>Probá con otro destino o escribinos y lo armamos a medida.</p>
        <a href={`https://wa.me/${WA}?text=${encodeURIComponent('Hola, busco un viaje que no veo en la web. ¿Me ayudan?')}`}
           target="_blank" rel="noopener noreferrer" class="btn btn-primary">Escribinos por WhatsApp</a>
      </div>
    </div>
  </section>

  <section class="section-space franja">
    <div class="lst-caja">
      <div class="lst-letra-chica">
        <h2>Lo que conviene saber antes de reservar</h2>
        <ul>
          <li><strong>Menores de 4 años</strong> pagan solo los gastos administrativos.</li>
          <li><strong>Habitación single:</strong> suma 50% sobre el valor del paquete.</li>
          <li><strong>Coche cama:</strong> $10.000 más por persona, según disponibilidad.</li>
          <li><strong>Puntos de subida:</strong> varios en el Gran Buenos Aires, se coordinan al reservar.</li>
          {politicas?.senia && <li><strong>Seña:</strong> {politicas.senia}</li>}
        </ul>
      </div>

      <div class="lst-medida">
        <div>
          <h3>¿No encontrás la fecha que necesitás?</h3>
          <p>Armamos salidas a medida para grupos, familias y egresados.</p>
        </div>
        <a
          href={`https://wa.me/${WA}?text=${encodeURIComponent('Hola, me gustaría armar un viaje a medida.')}`}
          target="_blank" rel="noopener noreferrer" class="btn btn-primary"
        >Consultar viaje a medida</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .lst-caja { max-width: 1180px; margin: 0 auto; padding: 0 1.25rem; }
  @media (min-width: 768px) { .lst-caja { padding: 0 2rem; } }

  /* ── Cabecera ── */
  .lst-cabecera { padding: 7rem 0 1.75rem; }
  @media (min-width: 768px) { .lst-cabecera { padding: 8.5rem 0 2rem; } }
  .lst-cabecera h1 { margin-bottom: 0.6rem; }
  .lst-bajada { font-size: 1.02rem; max-width: 56ch; margin: 0; }

  /* ── Barra de filtros ── */
  .lst-filtros-barra {
    position: sticky;
    top: 68px;
    z-index: 20;
    background: rgba(255,255,255,0.92);
    backdrop-filter: blur(12px);
    border-top: 1px solid var(--linea);
    border-bottom: 1px solid var(--linea);
    padding: 0.85rem 0;
  }

  .lst-chips {
    display: flex;
    gap: 0.45rem;
    overflow-x: auto;
    padding-bottom: 0.2rem;
    scrollbar-width: none;
  }
  .lst-chips::-webkit-scrollbar { display: none; }
  .chip {
    flex: none;
    background: var(--papel);
    border: 1px solid var(--linea-fuerte);
    border-radius: 100px;
    padding: 0.4rem 0.9rem;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--tinta-2);
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .chip:hover { border-color: var(--tinta-3); color: var(--tinta); }
  .chip.activo {
    background: var(--tinta);
    border-color: var(--tinta);
    color: #fff;
  }

  .lst-controles { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 0.7rem; }
  .lst-control { display: flex; align-items: center; gap: 0.45rem; font-size: 0.82rem; color: var(--tinta-3); }
  .lst-control select {
    padding: 0.4rem 0.6rem;
    font-size: 0.875rem;
    color: var(--tinta);
    min-width: 150px;
  }

  .lst-cuenta { font-size: 0.85rem; color: var(--tinta-3); margin: 0.7rem 0 0; }

  /* ── Grilla ── */
  .lst-cuerpo { padding: 2rem 0 3rem; }
  .lst-grilla {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 1.5rem;
  }
  @media (max-width: 640px) { .lst-grilla { grid-template-columns: 1fr; gap: 1.25rem; } }
  .lst-item[hidden] { display: none; }

  .lst-vacio { text-align: center; padding: 4rem 1rem; }
  .lst-vacio p { margin: 0 auto 1.25rem; }
  .lst-vacio[hidden] { display: none; }

  /* ── Letra chica ── */
  .lst-letra-chica { max-width: 60ch; margin-bottom: 2.5rem; }
  .lst-letra-chica ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.6rem; }
  .lst-letra-chica li {
    font-size: 0.92rem;
    color: var(--tinta-2);
    padding-left: 1.1rem;
    position: relative;
  }
  .lst-letra-chica li::before {
    content: '';
    position: absolute;
    left: 0; top: 0.62em;
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--naranja-fuerte);
  }
  .lst-letra-chica strong { color: var(--tinta); font-weight: 600; }

  .lst-medida {
    background: var(--papel);
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    padding: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  .lst-medida h3 { margin-bottom: 0.2rem; }
  .lst-medida p { margin: 0; font-size: 0.92rem; }
</style>

<script>
  const grilla = document.getElementById('lst-grilla');
  const vacio = document.getElementById('lst-vacio');
  const cuenta = document.getElementById('lst-cuenta');
  const selDuracion = document.getElementById('f-duracion') as HTMLSelectElement | null;
  const selOrden = document.getElementById('f-orden') as HTMLSelectElement | null;

  if (grilla && vacio && cuenta) {
    const items = Array.from(grilla.querySelectorAll<HTMLElement>('.lst-item'));
    let destino = '';

    // El pie y la home linkean con ?destino=, para entrar ya filtrado
    const pedido = new URLSearchParams(location.search).get('destino');
    if (pedido) destino = pedido;

    const aplicar = () => {
      const duracion = selDuracion?.value ?? '';
      const orden = selOrden?.value ?? 'fecha';
      let visibles = 0;

      for (const item of items) {
        const okDestino = !destino || item.dataset.destino === destino;
        const okDuracion = !duracion || item.dataset.tipo === duracion;
        const visible = okDestino && okDuracion;
        item.hidden = !visible;
        if (visible) visibles++;
      }

      // Reordenar con la propiedad order, sin tocar el DOM
      const ordenados = [...items].sort((a, b) => {
        if (orden === 'precio-asc') return Number(a.dataset.precio) - Number(b.dataset.precio);
        if (orden === 'precio-desc') return Number(b.dataset.precio) - Number(a.dataset.precio);
        return String(a.dataset.fecha).localeCompare(String(b.dataset.fecha));
      });
      ordenados.forEach((item, i) => { item.style.order = String(i); });

      vacio.hidden = visibles > 0;
      cuenta.textContent = visibles === 1 ? '1 paquete' : `${visibles} paquetes`;
    };

    document.querySelectorAll<HTMLButtonElement>('.chip').forEach((chip) => {
      if (chip.dataset.destino === destino) {
        document.querySelector('.chip.activo')?.classList.remove('activo');
        chip.classList.add('activo');
      }
      chip.addEventListener('click', () => {
        destino = chip.dataset.destino ?? '';
        document.querySelector('.chip.activo')?.classList.remove('activo');
        chip.classList.add('activo');
        aplicar();
      });
    });

    selDuracion?.addEventListener('change', aplicar);
    selOrden?.addEventListener('change', aplicar);
    aplicar();
  }
</script>
