---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PaqueteCard from '@/components/PaqueteCard.astro';
import IconoGrupo from '@/components/IconoGrupo.astro';
import paquetesData from '@/data/paquetes.json';
import { partesTitulo, agruparViajes } from '@/lib/viaje';

const WA = '5491134952847';

const paquetes = [...paquetesData.paquetes].sort(
  (a, b) => new Date(a.proximaSalida).getTime() - new Date(b.proximaSalida).getTime()
);
const politicas = paquetesData.politicasGlobales;

// Octubre, noviembre, diciembre… y después recitales, fin de año y verano 27
const grupos = agruparViajes(paquetes);

// Los destinos salen de los viajes cargados: si el panel da de baja el ultimo
// viaje de un destino, el filtro desaparece solo.
const nombreDestino = (p: (typeof paquetes)[number]) => partesTitulo(p.titulo).titular;
const destinos = Object.values(
  paquetes.reduce((acc: Record<string, { clave: string; label: string; n: number }>, p) => {
    const clave = p.destino;
    if (!acc[clave]) acc[clave] = { clave, label: nombreDestino(p), n: 0 };
    acc[clave].n++;
    return acc;
  }, {})
).sort((a, b) => b.n - a.n);

let indiceFoto = 0;
---

<BaseLayout
  title="Todos nuestros paquetes"
  description="Todas las salidas confirmadas de Pucará Turismo, con precio por persona y fecha. Termas, playa y sierra con bus, hotel y comidas incluidas desde el Gran Buenos Aires."
>

  <section class="lst-cabecera">
    <div class="lst-caja">
      <h1>Todos los paquetes</h1>
      <p class="lst-bajada">
        Cada viaje tiene su fecha y su precio por persona. Elegí el que te sirve y escribinos:
        te confirmamos lugar y punto de subida en el día.
      </p>
    </div>
  </section>

  <section class="lst-filtros-barra">
    <div class="lst-caja">
      <div class="lst-chips" role="group" aria-label="Filtrar por destino">
        <button type="button" class="chip activo" data-destino="">Todos</button>
        {destinos.map((d) => (
          <button type="button" class="chip" data-destino={d.clave}>{d.label}</button>
        ))}
      </div>

      <div class="lst-controles">
        <label class="lst-control">
          <span>Duración</span>
          <select id="f-duracion">
            <option value="">Todas</option>
            <option value="full_day">Full day</option>
            <option value="con_noches">Con noches</option>
          </select>
        </label>
        <p class="lst-cuenta" id="lst-cuenta" aria-live="polite"></p>
      </div>
    </div>
  </section>

  <section class="lst-cuerpo">
    <div class="lst-caja">
      {grupos.map((grupo) => (
        <section class="lst-grupo" data-grupo={grupo.clave}>
          <header class="lst-grupo-cabecera">
            <IconoGrupo tipo={grupo.icono} />
            <h2>{grupo.titulo}</h2>
            <span class="lst-grupo-cuenta" data-cuenta-grupo>
              {grupo.viajes.length} {grupo.viajes.length === 1 ? 'salida' : 'salidas'}
            </span>
          </header>

          <div class="lst-grilla">
            {grupo.viajes.map((paquete) => (
              <div
                class="lst-item"
                data-destino={paquete.destino}
                data-tipo={paquete.tipo === 'full_day' ? 'full_day' : 'con_noches'}
              >
                <PaqueteCard paquete={paquete} whatsappPhone={WA} prioridad={indiceFoto++ < 3} />
              </div>
            ))}
          </div>
        </section>
      ))}

      <div class="lst-vacio" id="lst-vacio" hidden>
        <h3>No hay paquetes con ese filtro</h3>
        <p>Probá con otro destino o escribinos y lo armamos a medida.</p>
        <a href={`https://wa.me/${WA}?text=${encodeURIComponent('Hola, busco un viaje que no veo en la web. ¿Me ayudan?')}`}
           target="_blank" rel="noopener noreferrer" class="btn btn-primary">Escribinos por WhatsApp</a>
      </div>
    </div>
  </section>

  <section class="section-space franja">
    <div class="lst-caja">
      <div class="lst-letra-chica">
        <h2>Lo que conviene saber antes de reservar</h2>
        <ul>
          <li><strong>Menores de 4 años</strong> pagan solo los gastos administrativos.</li>
          <li><strong>Habitación single:</strong> suma 50% sobre el valor del paquete.</li>
          <li><strong>Butaca cama:</strong> $10.000 más por persona, según disponibilidad.</li>
          <li><strong>Precios por persona</strong> en base doble, más los gastos administrativos que figuran en cada viaje.</li>
        </ul>
      </div>

      <div class="lst-paradas">
        <h2>Desde dónde salimos</h2>
        <p>Tenemos 8 puntos de subida repartidos en el Gran Buenos Aires. Cuando reservás coordinamos el que te queda más cerca.</p>
        <ol class="lst-paradas-lista">
          {['Cruce Varela', 'Rotonda Los Pinos', 'Rotonda Lavallol', 'Rotonda San Justo',
            'Ciudadela (Gral. Paz)', 'Morón (frente al Plaza Oeste)',
            'Moreno (Axion Ruta 23 y Acceso Oeste)', 'Tigre — Pacheco (Pdor. El Turista)'].map((p, i) => (
            <li><span>{i + 1}</span>{p}</li>
          ))}
        </ol>
        <p class="lst-paradas-nota">
          Los lugares de carga pueden sufrir modificaciones para un mejor servicio en el tiempo del recorrido.
        </p>
      </div>

      <div class="lst-medida">
        <div>
          <h3>¿No encontrás la fecha que necesitás?</h3>
          <p>Armamos salidas a medida para grupos, familias y egresados.</p>
        </div>
        <a
          href={`https://wa.me/${WA}?text=${encodeURIComponent('Hola, me gustaría armar un viaje a medida.')}`}
          target="_blank" rel="noopener noreferrer" class="btn btn-primary"
        >Consultar viaje a medida</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .lst-caja { max-width: 1180px; margin: 0 auto; padding: 0 1.25rem; }
  @media (min-width: 768px) { .lst-caja { padding: 0 2rem; } }

  /* ── Cabecera ── */
  .lst-cabecera { padding: 7rem 0 1.75rem; }
  @media (min-width: 768px) { .lst-cabecera { padding: 8.5rem 0 2rem; } }
  .lst-cabecera h1 { margin-bottom: 0.6rem; }
  .lst-bajada { font-size: 1.02rem; max-width: 56ch; margin: 0; }

  /* ── Barra de filtros ── */
  .lst-filtros-barra {
    position: sticky;
    top: 68px;
    z-index: 20;
    background: rgba(255,255,255,0.93);
    backdrop-filter: blur(12px);
    border-top: 1px solid var(--linea);
    border-bottom: 1px solid var(--linea);
    padding: 0.85rem 0;
  }

  .lst-chips {
    display: flex;
    gap: 0.45rem;
    overflow-x: auto;
    padding-bottom: 0.2rem;
    scrollbar-width: none;
  }
  .lst-chips::-webkit-scrollbar { display: none; }
  .chip {
    flex: none;
    background: var(--papel);
    border: 1px solid var(--linea-fuerte);
    border-radius: 100px;
    padding: 0.4rem 0.9rem;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--tinta-2);
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .chip:hover { border-color: var(--tinta-3); color: var(--tinta); }
  .chip.activo { background: var(--tinta); border-color: var(--tinta); color: #fff; }

  .lst-controles { display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; margin-top: 0.7rem; }
  .lst-control { display: flex; align-items: center; gap: 0.45rem; font-size: 0.82rem; color: var(--tinta-3); }
  .lst-control select { padding: 0.4rem 0.6rem; font-size: 0.875rem; color: var(--tinta); min-width: 150px; }
  .lst-cuenta { font-size: 0.85rem; color: var(--tinta-3); margin: 0; }

  /* ── Grupos ── */
  .lst-cuerpo { padding: 2.25rem 0 3rem; }
  .lst-grupo { margin-bottom: 3rem; }
  .lst-grupo:last-of-type { margin-bottom: 0; }
  .lst-grupo[hidden] { display: none; }

  .lst-grupo-cabecera {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 0.9rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--linea);
  }
  .lst-grupo-cabecera h2 {
    font-size: 1.35rem;
    margin: 0;
    flex: 1;
    letter-spacing: -0.03em;
  }
  .lst-grupo-cuenta { font-size: 0.85rem; color: var(--tinta-3); white-space: nowrap; }

  .lst-grilla {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 1.5rem;
  }
  @media (max-width: 640px) { .lst-grilla { grid-template-columns: 1fr; gap: 1.25rem; } }
  .lst-item[hidden] { display: none; }

  .lst-vacio { text-align: center; padding: 4rem 1rem; }
  .lst-vacio p { margin: 0 auto 1.25rem; }
  .lst-vacio[hidden] { display: none; }

  /* ── Letra chica y paradas ── */
  .lst-letra-chica { max-width: 60ch; margin-bottom: 2.5rem; }
  .lst-letra-chica ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.6rem; }
  .lst-letra-chica li {
    font-size: 0.92rem;
    color: var(--tinta-2);
    padding-left: 1.1rem;
    position: relative;
  }
  .lst-letra-chica li::before {
    content: '';
    position: absolute;
    left: 0; top: 0.62em;
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--naranja-fuerte);
  }
  .lst-letra-chica strong { color: var(--tinta); font-weight: 600; }

  .lst-paradas { margin-bottom: 2.5rem; }
  .lst-paradas > p { max-width: 60ch; }
  .lst-paradas-lista {
    list-style: none;
    padding: 0;
    margin: 1.1rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(255px, 1fr));
    gap: 0.6rem;
  }
  .lst-paradas-lista li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    background: var(--papel);
    border: 1px solid var(--linea);
    border-radius: var(--radio-ch);
    padding: 0.7rem 0.9rem;
    font-size: 0.92rem;
    color: var(--tinta);
  }
  .lst-paradas-lista span {
    width: 24px; height: 24px;
    flex: none;
    border-radius: 50%;
    background: var(--naranja-suave);
    color: var(--naranja-tinta);
    display: grid; place-items: center;
    font-size: 0.78rem; font-weight: 700;
  }
  .lst-paradas-nota { font-size: 0.82rem; color: var(--tinta-3); margin: 0.9rem 0 0; }

  .lst-medida {
    background: var(--papel);
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    padding: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  .lst-medida h3 { margin-bottom: 0.2rem; }
  .lst-medida p { margin: 0; font-size: 0.92rem; }
</style>

<script>
  const cuenta = document.getElementById('lst-cuenta');
  const vacio = document.getElementById('lst-vacio');
  const selDuracion = document.getElementById('f-duracion') as HTMLSelectElement | null;
  const grupos = Array.from(document.querySelectorAll<HTMLElement>('.lst-grupo'));

  if (cuenta && vacio && grupos.length) {
    let destino = new URLSearchParams(location.search).get('destino') ?? '';

    const aplicar = () => {
      const duracion = selDuracion?.value ?? '';
      let total = 0;

      for (const grupo of grupos) {
        let visiblesEnGrupo = 0;
        const items = grupo.querySelectorAll<HTMLElement>('.lst-item');

        for (const item of items) {
          const ok =
            (!destino || item.dataset.destino === destino) &&
            (!duracion || item.dataset.tipo === duracion);
          item.hidden = !ok;
          if (ok) visiblesEnGrupo++;
        }

        // Un bloque sin viajes visibles se esconde entero, con su título
        grupo.hidden = visiblesEnGrupo === 0;
        const marcador = grupo.querySelector('[data-cuenta-grupo]');
        if (marcador) marcador.textContent = `${visiblesEnGrupo} ${visiblesEnGrupo === 1 ? 'salida' : 'salidas'}`;
        total += visiblesEnGrupo;
      }

      vacio.hidden = total > 0;
      cuenta.textContent = total === 1 ? '1 paquete' : `${total} paquetes`;
    };

    document.querySelectorAll<HTMLButtonElement>('.chip').forEach((chip) => {
      if (chip.dataset.destino === destino) {
        document.querySelector('.chip.activo')?.classList.remove('activo');
        chip.classList.add('activo');
      }
      chip.addEventListener('click', () => {
        destino = chip.dataset.destino ?? '';
        document.querySelector('.chip.activo')?.classList.remove('activo');
        chip.classList.add('activo');
        aplicar();
      });
    });

    selDuracion?.addEventListener('change', aplicar);
    aplicar();
  }
</script>
