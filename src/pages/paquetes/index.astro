---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PaqueteCard from '@/components/PaqueteCard.astro';
import Filtros from '@/components/Filtros.tsx';
import paquetesData from '@/data/paquetes.json';

// Ordenar por fecha de salida más próxima
const paquetes = [...paquetesData.paquetes].sort(
  (a, b) => new Date(a.proximaSalida).getTime() - new Date(b.proximaSalida).getTime()
);
const politicas = paquetesData.politicasGlobales;
---

<BaseLayout
  title="Todos nuestros paquetes turísticos"
  description="Descubre todos nuestros paquetes de viajes. Filtra por duración, presupuesto y tipo de viaje."
>

  <!-- Header -->
  <section class="pk-header">
    <div class="pk-header-inner">
      <p class="pk-eyebrow">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
        </svg>
        Salidas desde zona oeste · Todo incluido
      </p>
      <h1 class="pk-title">Todos nuestros <span class="pk-accent">paquetes</span></h1>
      <p class="pk-sub">Salidas confirmadas para junio y julio 2026. Un paquete por fecha para que elijas exactamente cuándo querés viajar.</p>

      <!-- Políticas rápidas -->
      <div class="pk-politicas">
        <div class="pk-pol-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#f97316" stroke-width="2"><circle cx="9" cy="5" r="2"/><path d="M6 21v-4a3 3 0 0 1 6 0v4"/><circle cx="16" cy="8" r="1"/><path d="M14 21v-2a2 2 0 0 1 4 0v2"/></svg>
          Niños &lt;4 años: solo gastos adm.
        </div>
        <div class="pk-pol-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#f97316" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          Single: +50% sobre el paquete
        </div>
        <div class="pk-pol-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#f97316" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
          Coche cama: +$10.000 por persona
        </div>
        <div class="pk-pol-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#f97316" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          Múltiples puntos de subida en el GBA
        </div>
      </div>
    </div>
  </section>

  <!-- Filtros + Grid -->
  <section class="pk-body">
    <div class="pk-container">
      <div class="pk-layout">

        <!-- Sidebar filtros -->
        <aside class="pk-sidebar">
          <div class="pk-sidebar-sticky">
            <Filtros client:load />
          </div>
        </aside>

        <!-- Grid de cards -->
<div class="pk-main">
  <div class="pk-grid" id="paquetes-grid">
    {paquetes.map((paquete) => (
      <div class="paquete-wrapper" data-id={paquete.id}>
        <PaqueteCard paquete={paquete} whatsappPhone="5491134952847" />
      </div>
    ))}
  </div>

  <div id="no-results" class="pk-empty hidden">
     </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const grid = document.getElementById('paquetes-grid');
    const noResults = document.getElementById('no-results');

    if (!grid || !noResults) return;

    // Seleccionamos todas las cards generadas por Astro
    const cards = Array.from(grid.querySelectorAll('.paquete-wrapper')) as HTMLElement[];

    // Escuchamos el evento que emite nuestro componente React
    window.addEventListener('paquetes-filtrados', (e: Event) => {
      const customEvent = e as CustomEvent<string[] | number[]>;
      const sortedIds = customEvent.detail;
      let visibleCount = 0;

      cards.forEach((card) => {
        const id = card.getAttribute('data-id');
        
        // Buscamos la posición del ID de la card actual en el array ordenado por React
        const index = sortedIds.findIndex(sortedId => String(sortedId) === String(id));

        if (index !== -1) {
          card.style.display = ''; // Mostramos la card
          card.style.order = String(index); // Reordenamos la grilla usando flex/grid order
          visibleCount++;
        } else {
          card.style.display = 'none'; // Ocultamos la card si no pasa el filtro
        }
      });

      // Lógica para mostrar/ocultar el mensaje de "No hay resultados"
      if (visibleCount === 0) {
        grid.style.display = 'none';
        noResults.classList.remove('hidden');
      } else {
        grid.style.display = 'grid';
        noResults.classList.add('hidden');
      }
    });
  });
</script>

      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="pk-cta-section">
    <div class="pk-cta-inner">
      <div class="pk-cta-box">
        <div class="pk-cta-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
        </div>
        <div class="pk-cta-text">
          <h3>¿No encontrás lo que buscás?</h3>
          <p>Armamos viajes a medida. Contanos qué tenés en mente y lo hacemos posible.</p>
        </div>
        <a
          href="https://wa.me/5491134952847?text=Hola%2C%20me%20gustar%C3%ADa%20armar%20un%20viaje%20a%20medida"
          target="_blank"
          rel="noopener noreferrer"
          class="pk-cta-btn"
        >
          Consultar viaje personalizado
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Paleta dark ── */
  :root {
    --pk-bg: #0a0a0a;
    --pk-surface: #111111;
    --pk-border: #1e1e1e;
    --pk-orange: #e8622a;
    --pk-orange-hover: #cf5523;
    --pk-text: #ffffff;
    --pk-muted: #555555;
    --pk-subtle: #333333;
  }

  /* ── Header ── */
  .pk-header {
    background: var(--pk-bg);
    padding: 96px 24px 56px;
    border-bottom: 1px solid var(--pk-border);
  }
  .pk-header-inner {
    max-width: 1280px;
    margin: 0 auto;
  }
  .pk-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pk-muted);
    margin: 0 0 18px;
  }
  .pk-title {
    font-size: clamp(36px, 5vw, 60px);
    font-weight: 800;
    color: var(--pk-text);
    line-height: 1.1;
    margin: 0 0 14px;
  }
  .pk-accent { color: var(--pk-orange); }
  .pk-sub {
    font-size: 16px;
    color: var(--pk-muted);
    margin: 0 0 24px;
    max-width: 540px;
    line-height: 1.6;
  }
  .pk-politicas {
    display: flex; flex-wrap: wrap; gap: 10px; margin-top: 4px;
  }
  .pk-pol-item {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 12px; color: rgba(255,255,255,0.4); font-weight: 500;
    background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);
    border-radius: 20px; padding: 5px 12px;
  }

  /* ── Body layout ── */
  .pk-body {
    background: var(--pk-bg);
    padding: 40px 0 80px;
  }
  .pk-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .pk-layout {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 32px;
    align-items: start;
  }

  /* ── Sidebar ── */
  .pk-sidebar-sticky {
    position: sticky;
    top: 96px;
  }

  /* ── Grid ── */
  .pk-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 18px;
  }
  .pk-grid > * {
    animation: pk-fadeIn 0.3s ease-out forwards;
  }

  @keyframes pk-fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Sin resultados ── */
  .pk-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 80px 0;
    color: var(--pk-muted);
    text-align: center;
  }
  .pk-empty.hidden { display: none; }
  .pk-empty-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--pk-text);
    margin: 0;
  }
  .pk-empty-sub {
    font-size: 14px;
    color: var(--pk-muted);
    margin: 0;
  }
  .pk-wa-btn {
    margin-top: 8px;
    background: var(--pk-orange);
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    padding: 10px 20px;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.15s;
  }
  .pk-wa-btn:hover { background: var(--pk-orange-hover); }

  /* ── CTA ── */
  .pk-cta-section {
    background: var(--pk-bg);
    border-top: 1px solid var(--pk-border);
    padding: 48px 24px 64px;
  }
  .pk-cta-inner { max-width: 1280px; margin: 0 auto; }
  .pk-cta-box {
    background: var(--pk-surface);
    border: 1px solid var(--pk-border);
    border-radius: 14px;
    padding: 28px 32px;
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }
  .pk-cta-icon {
    width: 50px; height: 50px;
    background: #181818;
    border: 1px solid #252525;
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    color: var(--pk-orange);
    flex-shrink: 0;
  }
  .pk-cta-text { flex: 1; min-width: 180px; }
  .pk-cta-text h3 {
    font-size: 16px; font-weight: 600; color: var(--pk-text); margin: 0 0 5px;
  }
  .pk-cta-text p { font-size: 13px; color: var(--pk-muted); margin: 0; }
  .pk-cta-btn {
    display: inline-flex; align-items: center; gap: 6px;
    background: var(--pk-orange); color: #fff;
    font-size: 13px; font-weight: 600;
    padding: 10px 20px; border-radius: 8px;
    text-decoration: none; white-space: nowrap;
    transition: background 0.15s;
  }
  .pk-cta-btn:hover { background: var(--pk-orange-hover); }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .pk-layout {
      grid-template-columns: 1fr;
    }
    .pk-sidebar-sticky { position: static; }
    .pk-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .pk-grid { grid-template-columns: 1fr; }
    .pk-cta-box { flex-direction: column; align-items: flex-start; }
  }
</style>