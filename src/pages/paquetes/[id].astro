---
import BaseLayout from '@/layouts/BaseLayout.astro';
import paquetesData from '@/data/paquetes.json';

export function getStaticPaths() {
  return paquetesData.paquetes.map((paquete) => ({
    params: { id: paquete.slug },
    props: { paquete },
  }));
}

const { paquete } = Astro.props;
const WA = "5491134952847";
const msg = encodeURIComponent(`Hola Pucará Turismo, quiero consultar sobre el paquete: ${paquete.titulo}`);
---

<BaseLayout
  title={`${paquete.titulo} | Pucará Turismo`}
  description={paquete.descripcionCorta}
  image={paquete.imagenPrincipal}
>

<!-- Hero -->
<div class="relative w-full h-72 md:h-96 overflow-hidden">
  <img src={paquete.imagenPrincipal} alt={paquete.titulo} class="w-full h-full object-cover" />
  <div class="absolute inset-0" style="background:linear-gradient(to bottom,rgba(0,0,0,0.2),rgba(15,15,30,0.95));"></div>
  <div class="absolute inset-0 flex items-end p-6 md:p-10">
    <div>
      <a href="/Pucara-Turismo/paquetes" class="text-orange-400 text-sm mb-3 inline-flex items-center gap-1 hover:text-orange-300 transition-colors">
        ← Volver a paquetes
      </a>
      <h1 class="text-white text-3xl md:text-5xl font-bold">{paquete.titulo}</h1>
      <p class="text-white/60 mt-2 text-sm">{paquete.duracionDias} días · {paquete.duracionNoches} noches · Salida desde Ituzaingó</p>
    </div>
  </div>
</div>

<!-- Body -->
<div style="background:#0f0f1a; min-height:100vh; padding: 3rem 0;">
  <div class="container-gutter max-w-6xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

      <!-- Columna izquierda -->
      <div class="lg:col-span-2 space-y-6">

        <!-- Descripción -->
        <div style="background:#1a1a2e; border:1px solid rgba(255,152,0,0.15); border-radius:16px; padding:1.5rem;">
          <h2 style="color:white; font-size:1.25rem; font-weight:700; margin-bottom:1rem;">Sobre este viaje</h2>
          <p style="color:rgba(255,255,255,0.65); line-height:1.75;">{paquete.descripcionLarga}</p>
        </div>

        <!-- Incluye -->
        <div style="background:#1a1a2e; border:1px solid rgba(255,152,0,0.15); border-radius:16px; padding:1.5rem;">
          <h2 style="color:white; font-size:1.25rem; font-weight:700; margin-bottom:1rem;">¿Qué incluye?</h2>
          <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(140px,1fr)); gap:0.75rem;">
            {paquete.incluye.map((item: string) => (
              <div style="background:rgba(255,152,0,0.08); border:1px solid rgba(255,152,0,0.2); border-radius:10px; padding:0.6rem 0.9rem; display:flex; align-items:center; gap:0.5rem;">
                <span style="color:#f97316; font-size:0.8rem;">◆</span>
                <span style="color:rgba(255,255,255,0.8); font-size:0.85rem; text-transform:capitalize;">{item}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Itinerario -->
        {paquete.itinerario && paquete.itinerario.length > 0 && (
          <div style="background:#1a1a2e; border:1px solid rgba(255,152,0,0.15); border-radius:16px; padding:1.5rem;">
            <h2 style="color:white; font-size:1.25rem; font-weight:700; margin-bottom:1rem;">Itinerario</h2>
            <ol style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:0.75rem;">
              {paquete.itinerario.map((paso: string, i: number) => (
                <li style="display:flex; gap:0.75rem; align-items:flex-start;">
                  <span style="flex-shrink:0; width:26px; height:26px; background:#f97316; color:white; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:0.75rem; font-weight:700;">{i+1}</span>
                  <span style="color:rgba(255,255,255,0.7); padding-top:3px; line-height:1.5;">{paso}</span>
                </li>
              ))}
            </ol>
          </div>
        )}

        <!-- Formulario consulta -->
        <div style="background:#1a1a2e; border:1px solid rgba(255,152,0,0.3); border-radius:16px; padding:1.5rem;">
          <h2 style="color:white; font-size:1.25rem; font-weight:700; margin-bottom:0.5rem;">Consultá este paquete</h2>
          <p style="color:rgba(255,255,255,0.5); font-size:0.875rem; margin-bottom:1.25rem;">Completá tus datos y te contactamos por WhatsApp.</p>
          
          <div id="form-detalle" style="display:flex; flex-direction:column; gap:0.875rem;">
            <input id="f-nombre" type="text" placeholder="Tu nombre" style="background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12); border-radius:10px; padding:0.75rem 1rem; color:white; font-size:0.9rem; width:100%; outline:none;" />
            <input id="f-email" type="email" placeholder="Tu email" style="background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12); border-radius:10px; padding:0.75rem 1rem; color:white; font-size:0.9rem; width:100%; outline:none;" />
            <input id="f-tel" type="tel" placeholder="Tu WhatsApp (ej: 1134952847)" style="background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12); border-radius:10px; padding:0.75rem 1rem; color:white; font-size:0.9rem; width:100%; outline:none;" />
            <button id="btn-consultar" style="background:#f97316; color:white; font-weight:700; border:none; border-radius:10px; padding:0.875rem; font-size:0.95rem; cursor:pointer; transition:background 0.2s;">
              💬 Enviar consulta por WhatsApp
            </button>
          </div>
        </div>

      </div>

      <!-- Sidebar -->
      <div class="lg:col-span-1">
        <div style="background:#1a1a2e; border:1px solid rgba(255,152,0,0.25); border-radius:16px; padding:1.5rem; position:sticky; top:90px;">
          
          <!-- Precio -->
          <div style="text-align:center; padding-bottom:1.25rem; border-bottom:1px solid rgba(255,255,255,0.08); margin-bottom:1.25rem;">
            <p style="color:rgba(255,255,255,0.4); font-size:0.8rem; margin-bottom:0.25rem;">Precio por persona</p>
            <div id="precio-total" style="font-size:2.5rem; font-weight:900; color:#f97316;">${paquete.precioBase.toLocaleString('es-AR')}</div>
            <p style="color:rgba(255,255,255,0.3); font-size:0.75rem;">+ ${paquete.gastosAdmin.toLocaleString('es-AR')} gastos adm.</p>
          </div>

          <!-- Calculadora personas -->
          <div style="margin-bottom:1.25rem;">
            <label style="color:rgba(255,255,255,0.6); font-size:0.8rem; display:block; margin-bottom:0.5rem;">Cantidad de personas</label>
            <div style="display:flex; align-items:center; gap:0.75rem;">
              <button id="btn-menos" style="width:36px; height:36px; background:rgba(255,152,0,0.15); border:1px solid rgba(255,152,0,0.3); border-radius:8px; color:#f97316; font-size:1.25rem; cursor:pointer; display:flex; align-items:center; justify-content:center;">−</button>
              <span id="cant-personas" style="color:white; font-size:1.25rem; font-weight:700; min-width:30px; text-align:center;">1</span>
              <button id="btn-mas" style="width:36px; height:36px; background:rgba(255,152,0,0.15); border:1px solid rgba(255,152,0,0.3); border-radius:8px; color:#f97316; font-size:1.25rem; cursor:pointer; display:flex; align-items:center; justify-content:center;">+</button>
            </div>
            <p id="precio-grupo" style="color:rgba(255,255,255,0.4); font-size:0.8rem; margin-top:0.5rem;">Total grupo: <span style="color:#f97316; font-weight:700;">${paquete.precioBase.toLocaleString('es-AR')}</span></p>
          </div>

          <!-- Info -->
          <div style="display:flex; flex-direction:column; gap:0.6rem; margin-bottom:1.25rem;">
            <div style="display:flex; justify-content:space-between; font-size:0.85rem;">
              <span style="color:rgba(255,255,255,0.4);">Próxima salida</span>
              <span style="color:white; font-weight:600;">
                {new Date(paquete.proximaSalida + 'T12:00:00').toLocaleDateString('es-AR', {day:'numeric', month:'long'})}
              </span>
            </div>
            <div style="display:flex; justify-content:space-between; font-size:0.85rem;">
              <span style="color:rgba(255,255,255,0.4);">Cupos disponibles</span>
              <span style="color:#f97316; font-weight:600;">{paquete.cuposPorSalida} lugares</span>
            </div>
            <div style="display:flex; justify-content:space-between; font-size:0.85rem;">
              <span style="color:rgba(255,255,255,0.4);">Salida desde</span>
              <span style="color:white; font-weight:600;">Ituzaingó</span>
            </div>
          </div>

          
            id="btn-wa-sidebar"
            href={`https://wa.me/${WA}?text=${msg}`}
            target="_blank"
            rel="noopener noreferrer"
            style="display:block; background:#25d366; color:white; font-weight:700; text-align:center; padding:0.875rem; border-radius:10px; text-decoration:none; font-size:0.95rem;"
          >
            💬 Reservar por WhatsApp
          </a>
          <p style="color:rgba(255,255,255,0.3); font-size:0.75rem; text-align:center; margin-top:0.75rem;">Respondemos en minutos</p>
        </div>
      </div>

    </div>
  </div>
</div>

</BaseLayout>

<script define:vars={{ precioBase: paquete.precioBase, gastosAdmin: paquete.gastosAdmin, titulo: paquete.titulo, WA: "5491134952847" }}>
  let personas = 1;

  function formatARS(n) {
    return n.toLocaleString('es-AR');
  }

  function actualizar() {
    const total = precioBase * personas;
    document.getElementById('precio-total').textContent = '$' + formatARS(total);
    document.getElementById('cant-personas').textContent = personas;
    document.getElementById('precio-grupo').innerHTML = `Total grupo: <span style="color:#f97316;font-weight:700;">$${formatARS(total)}</span>`;
    
    const msgWA = encodeURIComponent(`Hola Pucará Turismo, quiero consultar sobre: ${titulo} para ${personas} persona${personas > 1 ? 's' : ''}`);
    document.getElementById('btn-wa-sidebar').href = `https://wa.me/${WA}?text=${msgWA}`;
  }

  document.getElementById('btn-menos').addEventListener('click', () => {
    if (personas > 1) { personas--; actualizar(); }
  });

  document.getElementById('btn-mas').addEventListener('click', () => {
    if (personas < 20) { personas++; actualizar(); }
  });

  document.getElementById('btn-consultar').addEventListener('click', () => {
    const nombre = document.getElementById('f-nombre').value.trim();
    const tel = document.getElementById('f-tel').value.trim();
    if (!nombre) { alert('Por favor ingresá tu nombre'); return; }
    const msgFinal = encodeURIComponent(`Hola Pucará Turismo! Me llamo ${nombre} y quiero consultar sobre el paquete: ${titulo} para ${personas} persona${personas > 1 ? 's' : ''}. Mi WhatsApp es ${tel || 'sin especificar'}.`);
    window.open(`https://wa.me/${WA}?text=${msgFinal}`, '_blank');
  });
</script>