---
import BaseLayout from '@/layouts/BaseLayout.astro';
import paquetesData from '@/data/paquetes.json';

export function getStaticPaths() {
  return paquetesData.paquetes.map((paquete) => ({
    params: { id: paquete.slug },
    props: { paquete },
  }));
}

const { paquete } = Astro.props;
const WA = "5491134952847";
---

<BaseLayout
  title={`${paquete.titulo} | Pucará Turismo`}
  description={paquete.descripcionCorta}
  image={paquete.imagenPrincipal}
>

<!-- Hero -->
<div class="relative w-full overflow-hidden" style="height:420px;">
  <img src={paquete.imagenPrincipal} alt={paquete.titulo} class="w-full h-full object-cover" />
  <div class="absolute inset-0" style="background:linear-gradient(to bottom,rgba(0,0,0,0.1) 0%,rgba(10,10,20,0.97) 100%);"></div>
  <div class="absolute inset-0 flex items-end" style="padding:2.5rem 3rem;">
    <div>
      <a href="/Pucara-Turismo/paquetes" style="color:#f97316; font-size:0.85rem; text-decoration:none; display:inline-flex; align-items:center; gap:0.4rem; margin-bottom:0.75rem; opacity:0.8;">
        ← Todos los paquetes
      </a>
      <h1 style="color:white; font-size:2.75rem; font-weight:900; margin:0 0 0.5rem 0; line-height:1.1;">{paquete.titulo}</h1>
      <div style="display:flex; gap:1.5rem; color:rgba(255,255,255,0.45); font-size:0.85rem;">
        <span>{paquete.duracionDias} días · {paquete.duracionNoches} noches</span>
        <span>·</span>
        <span>Salida desde Ituzaingó</span>
        <span>·</span>
        <span>Base doble</span>
      </div>
    </div>
  </div>
</div>

<!-- Body -->
<div style="background:#080808; min-height:100vh; padding:3rem 0 5rem 0;">
  <div class="container-gutter max-w-6xl mx-auto">
    <div style="display:grid; grid-template-columns:1fr 380px; gap:2rem; align-items:start;">

      <!-- Columna izquierda -->
      <div style="display:flex; flex-direction:column; gap:1.5rem;">

        <!-- Descripción -->
        <div style="border-bottom:1px solid rgba(255,255,255,0.07); padding-bottom:1.5rem;">
          <p style="color:rgba(255,255,255,0.55); line-height:1.8; font-size:1rem; margin:0;">{paquete.descripcionLarga}</p>
        </div>

        <!-- Incluye -->
        <div>
          <h2 style="color:white; font-size:1rem; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; margin:0 0 1rem 0; color:rgba(255,255,255,0.4);">Incluye</h2>
          <div style="display:flex; flex-wrap:wrap; gap:0.6rem;">
            {paquete.incluye.map((item: string) => (
              <span style="background:rgba(249,115,22,0.1); border:1px solid rgba(249,115,22,0.25); color:rgba(255,255,255,0.75); border-radius:6px; padding:0.35rem 0.85rem; font-size:0.82rem; text-transform:capitalize;">
                {item}
              </span>
            ))}
          </div>
        </div>

        <!-- Galería -->
        {paquete.imagenes && paquete.imagenes.length > 0 && (
          <div>
            <h2 style="color:rgba(255,255,255,0.4); font-size:1rem; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; margin:0 0 1rem 0;">Galería</h2>
            <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:0.75rem;">
              {paquete.imagenes.map((img: string, i: number) => (
                <div style="border-radius:10px; overflow:hidden; aspect-ratio:4/3; cursor:pointer;" onclick={`openGallery(${i})`}>
                  <img src={img} alt={`${paquete.titulo} ${i+1}`} style="width:100%; height:100%; object-fit:cover; transition:transform 0.3s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'" />
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Itinerario -->
        {paquete.itinerario && paquete.itinerario.length > 0 && (
          <div>
            <h2 style="color:rgba(255,255,255,0.4); font-size:1rem; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; margin:0 0 1rem 0;">Itinerario</h2>
            <div style="display:flex; flex-direction:column; gap:0; position:relative;">
              {paquete.itinerario.map((paso: string, i: number) => (
                <div style="display:flex; gap:1rem; align-items:flex-start; padding:0.75rem 0;">
                  <div style="display:flex; flex-direction:column; align-items:center; flex-shrink:0;">
                    <div style="width:28px; height:28px; background:#f97316; border-radius:50%; display:flex; align-items:center; justify-content:center; color:white; font-size:0.75rem; font-weight:700; z-index:1;">{i+1}</div>
                    {i < paquete.itinerario.length - 1 && <div style="width:1px; height:100%; min-height:20px; background:rgba(249,115,22,0.2); margin-top:4px;"></div>}
                  </div>
                  <p style="color:rgba(255,255,255,0.6); font-size:0.9rem; line-height:1.5; margin:4px 0 0 0;">{paso}</p>
                </div>
              ))}
            </div>
          </div>
        )}

      </div>

      <!-- Sidebar -->
      <div style="position:sticky; top:90px;">
        <div style="background:rgba(255,255,255,0.03); backdrop-filter:blur(20px); -webkit-backdrop-filter:blur(20px); border:1px solid rgba(255,255,255,0.07); border-radius:16px; overflow:hidden;">
          
          <!-- Precio -->
          <div style="padding:1.5rem; border-bottom:1px solid rgba(255,255,255,0.06);">
            <p style="color:rgba(255,255,255,0.35); font-size:0.75rem; margin:0 0 0.25rem 0; text-transform:uppercase; letter-spacing:0.1em;">Precio por persona</p>
            <div id="precio-display" style="font-size:2.75rem; font-weight:900; color:#f97316; line-height:1;"></div>
            <p style="color:rgba(255,255,255,0.25); font-size:0.75rem; margin:0.35rem 0 0 0;">+ ${paquete.gastosAdmin.toLocaleString('es-AR')} gastos adm. por persona</p>
            <div id="nota-single" style="display:none; margin-top:0.5rem; background:rgba(249,115,22,0.1); border-radius:6px; padding:0.4rem 0.6rem;">
              <p style="color:#f97316; font-size:0.72rem; margin:0;">* Suplemento viajero solo: +50%</p>
            </div>
          </div>

          <!-- Personas -->
          <div style="padding:1.25rem 1.5rem; border-bottom:1px solid rgba(255,255,255,0.06);">
            <p style="color:rgba(255,255,255,0.4); font-size:0.78rem; margin:0 0 0.75rem 0; text-transform:uppercase; letter-spacing:0.08em;">Cantidad de personas</p>
            <div style="display:flex; align-items:center; gap:1rem;">
              <button id="btn-menos" style="width:36px; height:36px; background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1); border-radius:8px; color:white; font-size:1.25rem; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:all 0.2s;">−</button>
              <span id="cant-personas" style="color:white; font-size:1.5rem; font-weight:700; min-width:2rem; text-align:center;">1</span>
              <button id="btn-mas" style="width:36px; height:36px; background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1); border-radius:8px; color:white; font-size:1.25rem; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:all 0.2s;">+</button>
            </div>
            <div style="margin-top:0.75rem; padding-top:0.75rem; border-top:1px solid rgba(255,255,255,0.05);">
              <div style="display:flex; justify-content:space-between; align-items:center;">
                <span style="color:rgba(255,255,255,0.4); font-size:0.82rem;">Total a pagar</span>
                <span id="total-grupo" style="color:white; font-weight:700; font-size:1.1rem;"></span>
              </div>
            </div>
          </div>

          <!-- Info -->
          <div style="padding:1.25rem 1.5rem; border-bottom:1px solid rgba(255,255,255,0.06); display:flex; flex-direction:column; gap:0.6rem;">
            <div style="display:flex; justify-content:space-between; font-size:0.83rem;">
              <span style="color:rgba(255,255,255,0.35);">Próxima salida</span>
              <span style="color:white; font-weight:600;">
                {new Date(paquete.proximaSalida + 'T12:00:00').toLocaleDateString('es-AR', {day:'numeric', month:'long'})}
              </span>
            </div>
            <div style="display:flex; justify-content:space-between; font-size:0.83rem;">
              <span style="color:rgba(255,255,255,0.35);">Cupos</span>
              <span style="color:#f97316; font-weight:600;">{paquete.cuposPorSalida} lugares</span>
            </div>
          </div>

          <!-- Formulario -->
          <div style="padding:1.25rem 1.5rem; border-bottom:1px solid rgba(255,255,255,0.06); display:flex; flex-direction:column; gap:0.6rem;">
            <p style="color:rgba(255,255,255,0.4); font-size:0.78rem; text-transform:uppercase; letter-spacing:0.08em; margin:0 0 0.25rem 0;">Tus datos</p>
            <input id="f-nombre" type="text" placeholder="Tu nombre" style="background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1); border-radius:8px; padding:0.65rem 0.9rem; color:white; font-size:0.85rem; width:100%; outline:none; box-sizing:border-box;" />
            <input id="f-tel" type="tel" placeholder="Tu WhatsApp" style="background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1); border-radius:8px; padding:0.65rem 0.9rem; color:white; font-size:0.85rem; width:100%; outline:none; box-sizing:border-box;" />
          </div>

          <!-- Botón -->
          <div style="padding:1.25rem 1.5rem;">
            <button id="btn-reservar" style="width:100%; background:#f97316; color:white; font-weight:700; border:none; border-radius:10px; padding:1rem; font-size:1rem; cursor:pointer; transition:background 0.2s; display:flex; align-items:center; justify-content:center; gap:0.5rem;">
              💬 Reservar
            </button>
            <p style="color:rgba(255,255,255,0.2); font-size:0.72rem; text-align:center; margin:0.6rem 0 0 0;">Respondemos en minutos por WhatsApp</p>
          </div>

        </div>
      </div>

    </div>
  </div>
</div>

<!-- Lightbox galería -->
<div id="lightbox" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.95); z-index:1000; align-items:center; justify-content:center;">
  <button onclick="closeGallery()" style="position:absolute; top:1.5rem; right:1.5rem; background:none; border:none; color:white; font-size:2rem; cursor:pointer; opacity:0.6;">✕</button>
  <button onclick="prevImg()" style="position:absolute; left:1.5rem; background:none; border:none; color:white; font-size:2.5rem; cursor:pointer; opacity:0.6;">‹</button>
  <img id="lightbox-img" src="" alt="" style="max-width:90vw; max-height:90vh; border-radius:8px; object-fit:contain;" />
  <button onclick="nextImg()" style="position:absolute; right:1.5rem; background:none; border:none; color:white; font-size:2.5rem; cursor:pointer; opacity:0.6;">›</button>
</div>

</BaseLayout>

<script define:vars={{ precioBase: paquete.precioBase, gastosAdmin: paquete.gastosAdmin, titulo: paquete.titulo, imagenes: paquete.imagenes || [] }}>
  const WA = "5491134952847";
  let personas = 1;
  let galleryIndex = 0;

  function calcularPrecio(n) {
    if (n === 1) {
      return Math.round(precioBase * 1.5);
    }
    return precioBase;
  }

  function calcularTotal(n) {
    const precioPP = calcularPrecio(n);
    return (precioPP + gastosAdmin) * n;
  }

  function formatARS(n) {
    return '$' + n.toLocaleString('es-AR');
  }

  function actualizar() {
    const precioPP = calcularPrecio(personas);
    const total = calcularTotal(personas);
    
    document.getElementById('precio-display').textContent = formatARS(precioPP);
    document.getElementById('cant-personas').textContent = personas;
    document.getElementById('total-grupo').textContent = formatARS(total);
    document.getElementById('nota-single').style.display = personas === 1 ? 'block' : 'none';
  }

  document.getElementById('btn-menos').addEventListener('click', () => {
    if (personas > 1) { personas--; actualizar(); }
  });

  document.getElementById('btn-mas').addEventListener('click', () => {
    if (personas < 20) { personas++; actualizar(); }
  });

  document.getElementById('btn-reservar').addEventListener('click', () => {
    const nombre = document.getElementById('f-nombre').value.trim();
    const tel = document.getElementById('f-tel').value.trim();
    const precioPP = calcularPrecio(personas);
    const total = calcularTotal(personas);
    const msg = encodeURIComponent(
      `Hola Pucará Turismo! Me llamo ${nombre || 'sin nombre'} y quiero reservar:\n` +
      `📦 Paquete: ${titulo}\n` +
      `👥 Personas: ${personas}\n` +
      `💰 Total: ${formatARS(total)}\n` +
      `📱 Mi WhatsApp: ${tel || 'sin especificar'}`
    );
    window.open(`https://wa.me/${WA}?text=${msg}`, '_blank');
  });

  // Galería lightbox
  window.openGallery = function(i) {
    galleryIndex = i;
    document.getElementById('lightbox-img').src = imagenes[i];
    document.getElementById('lightbox').style.display = 'flex';
  };

  window.closeGallery = function() {
    document.getElementById('lightbox').style.display = 'none';
  };

  window.prevImg = function() {
    galleryIndex = (galleryIndex - 1 + imagenes.length) % imagenes.length;
    document.getElementById('lightbox-img').src = imagenes[galleryIndex];
  };

  window.nextImg = function() {
    galleryIndex = (galleryIndex + 1) % imagenes.length;
    document.getElementById('lightbox-img').src = imagenes[galleryIndex];
  };

  document.getElementById('lightbox').addEventListener('click', function(e) {
    if (e.target === this) closeGallery();
  });

  actualizar();
</script>
