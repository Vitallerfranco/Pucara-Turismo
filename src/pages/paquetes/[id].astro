---
import BaseLayout from '@/layouts/BaseLayout.astro';
import paquetesData from '@/data/paquetes.json';

// 1. Astro ejecuta esto en el servidor para generar todas las rutas posibles
export function getStaticPaths() {
  const paquetes = paquetesData.paquetes;

  // Retornamos un array con los params (para la URL) y los props (los datos de la página)
  return paquetes.map((paquete) => ({
    // IMPORTANTE: 'id' tiene que coincidir con el nombre de tu archivo [id].astro
    // Si en tu JSON el identificador "colon-termas-finde" se llama "slug", cambialo a paquete.slug
    params: { id: paquete.slug }, 
    props: { paquete }, // Le pasamos toda la info del paquete a la página
  }));
}

// 2. Extraemos el paquete de los props que pasamos arriba
const { paquete } = Astro.props;
---

<BaseLayout 
  title={`${paquete.nombre} | Pucará Turismo`}
  description={paquete.descripcionBreve}
>
  <section class="pk-detalle-container" style="padding-top: 120px; color: white;">
    <h1>{paquete.nombre}</h1>
    <p>Precio: ${paquete.precioBase}</p>
    <p>Duración: {paquete.duracionDias} días</p>
    
    <a href="/paquetes" style="color: #e8622a; margin-top: 20px; display: inline-block;">
      ← Volver a todos los paquetes
    </a>
  </section>

</BaseLayout>
