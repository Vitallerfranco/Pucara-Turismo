---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FormReserva from '@/components/FormReserva.jsx';
import paquetesData from '@/data/paquetes.json';
import extrasData from '@/data/extras.json';
import { formatPrice } from '@/lib/utils';

interface Props {
  params: {
    id: string;
  };
}

export function getStaticPaths() {
  return paquetesData.paquetes.map((paquete) => ({
    params: { id: paquete.slug },
    props: { paquete },
  }));
}

const { paquete } = Astro.props;

if (!paquete) {
  return Astro.redirect('/paquetes');
}

const extrasAplicables = extrasData.extras.filter((e) =>
  e.aplicableA.includes(paquete.id)
);

const totalPrice = paquete.precioBase + paquete.gastosAdmin;
---

<BaseLayout
  title={paquete.titulo}
  description={paquete.descripcionCorta}
  image={paquete.imagenPrincipal}
  type="article"
>

  {/* Hero */}
  <section class="relative w-full h-80 md:h-[520px] overflow-hidden">
    <img
      src={paquete.imagenPrincipal}
      alt={paquete.titulo}
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(14,14,14,0.85) 0%, rgba(14,14,14,0.3) 50%, transparent 100%);"></div>

    <div class="absolute bottom-0 left-0 right-0 p-6 md:p-10">
      <div class="container-gutter max-w-5xl mx-auto">
        <div class="flex flex-wrap gap-2 mb-4">
          {paquete.tags.map((tag) => (
            <span key={tag} class="px-3 py-1 text-xs font-semibold tracking-wide bg-orange-500 text-white rounded-md uppercase">
              {tag}
            </span>
          ))}
        </div>
        <h1 class="text-3xl md:text-5xl font-bold text-white mb-5" style="letter-spacing:-0.5px">{paquete.titulo}</h1>
        <div class="flex flex-wrap gap-6 text-sm text-white/60">
          <div class="flex items-center gap-2">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
            {paquete.duracionDias}d / {paquete.duracionNoches}n
          </div>
          <div class="flex items-center gap-2">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
            {paquete.rating} ({paquete.reviews} reseñas)
          </div>
          <div class="flex items-center gap-2 text-orange-400 font-semibold">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>
            </svg>
            {formatPrice(totalPrice)} por persona
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Main content */}
  <section class="section-space bg-[#0e0e0e]">
    <div class="container-gutter max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-10">

      {/* Left column */}
      <div class="lg:col-span-2 space-y-14">

        {/* Descripción */}
        <div>
          <span class="inline-block text-xs font-medium text-white/30 uppercase tracking-widest mb-3">Descripción</span>
          <h2 class="text-2xl font-bold text-white mb-4">Sobre este viaje</h2>
          <p class="text-white/45 leading-relaxed">{paquete.descripcionLarga}</p>
        </div>

        {/* Itinerario */}
        <div>
          <span class="inline-block text-xs font-medium text-white/30 uppercase tracking-widest mb-3">Itinerario</span>
          <h2 class="text-2xl font-bold text-white mb-6">Día a día</h2>
          <div class="space-y-3">
            {paquete.itinerario.map((dia, idx) => (
              <div key={idx} class="flex gap-4 p-5 border border-white/7 rounded-xl hover:bg-white/2 transition-colors duration-200">
                <div class="flex-shrink-0 w-8 h-8 rounded-lg border border-orange-500/30 bg-orange-500/10 flex items-center justify-center text-orange-400 text-xs font-bold">
                  {idx + 1}
                </div>
                <p class="text-white/55 text-sm leading-relaxed pt-1">{dia}</p>
              </div>
            ))}
          </div>
        </div>

        {/* Qué incluye */}
        <div>
          <span class="inline-block text-xs font-medium text-white/30 uppercase tracking-widest mb-3">Incluido</span>
          <h2 class="text-2xl font-bold text-white mb-6">¿Qué incluye?</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            {paquete.incluye.map((item) => (
              <div key={item} class="flex items-center gap-3 p-4 border border-white/7 rounded-xl">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-orange-400 flex-shrink-0">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                <span class="text-white/65 text-sm capitalize">{item}</span>
              </div>
            ))}
          </div>
        </div>

        {/* Galería */}
        {paquete.imagenes && paquete.imagenes.length > 0 && (
          <div>
            <span class="inline-block text-xs font-medium text-white/30 uppercase tracking-widest mb-3">Fotos</span>
            <h2 class="text-2xl font-bold text-white mb-6">Galería</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
              {paquete.imagenes.map((img, idx) => (
                <img
                  key={idx}
                  src={img}
                  alt={`${paquete.titulo} - Foto ${idx + 1}`}
                  class="w-full h-56 object-cover rounded-xl border border-white/7"
                />
              ))}
            </div>
          </div>
        )}

        {/* FAQ */}
        <div>
          <span class="inline-block text-xs font-medium text-white/30 uppercase tracking-widest mb-3">FAQ</span>
          <h2 class="text-2xl font-bold text-white mb-6">Preguntas frecuentes</h2>
          <div class="divide-y divide-white/7 border border-white/7 rounded-xl overflow-hidden">

            <details class="group">
              <summary class="flex items-center justify-between px-5 py-4 cursor-pointer text-white/60 hover:text-white transition-colors duration-200 list-none text-sm font-medium">
                ¿Puedo cambiar de fecha?
                <svg class="w-4 h-4 text-white/25 group-open:rotate-180 transition-transform duration-200 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </summary>
              <div class="px-5 pb-4 text-white/35 text-sm leading-relaxed">
                Sí, sujeto a disponibilidad. Contactá con Sonia por WhatsApp para consultar opciones.
              </div>
            </details>

            <details class="group">
              <summary class="flex items-center justify-between px-5 py-4 cursor-pointer text-white/60 hover:text-white transition-colors duration-200 list-none text-sm font-medium">
                ¿Qué pasa si viajo con menores?
                <svg class="w-4 h-4 text-white/25 group-open:rotate-180 transition-transform duration-200 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </summary>
              <div class="px-5 pb-4 text-white/35 text-sm leading-relaxed">
                Aplicamos descuentos especiales para menores de 12 años. Consultá en WhatsApp.
              </div>
            </details>

            <details class="group">
              <summary class="flex items-center justify-between px-5 py-4 cursor-pointer text-white/60 hover:text-white transition-colors duration-200 list-none text-sm font-medium">
                ¿Se puede cancelar?
                <svg class="w-4 h-4 text-white/25 group-open:rotate-180 transition-transform duration-200 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </summary>
              <div class="px-5 pb-4 text-white/35 text-sm leading-relaxed">
                Sí. Hasta 30 días antes = reembolso completo. Consultá nuestra política de cancelación.
              </div>
            </details>

          </div>
        </div>
      </div>

      {/* Right column - sticky */}
      <div class="lg:col-span-1">
        <div class="sticky top-24 space-y-4">

          {/* Price card */}
          <div class="border border-white/8 rounded-xl p-6 bg-white/2">
            <p class="text-xs text-white/30 uppercase tracking-widest mb-2">Precio por persona</p>
            <div class="text-3xl font-bold text-white mb-5">{formatPrice(totalPrice)}</div>
            <div class="space-y-2 text-xs text-white/40 mb-4 pb-4 border-b border-white/7">
              <div class="flex justify-between">
                <span>Paquete base</span>
                <span class="text-white/60">{formatPrice(paquete.precioBase)}</span>
              </div>
              <div class="flex justify-between">
                <span>Gastos admin</span>
                <span class="text-white/60">{formatPrice(paquete.gastosAdmin)}</span>
              </div>
            </div>
            <div class="space-y-2">
              {[
                { icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z', label: 'Seguro incluido' },
                { icon: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z', label: 'Guía profesional' },
                { icon: 'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z', label: 'Coordinador WhatsApp' },
              ].map(({ icon, label }) => (
                <div class="flex items-center gap-2 text-xs text-white/40">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-orange-400 flex-shrink-0">
                    <path d={icon}/>
                  </svg>
                  {label}
                </div>
              ))}
            </div>
          </div>

          {/* Urgency */}
          <div class="border border-white/8 rounded-xl p-4">
            <div class="flex items-center gap-2 mb-1">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-orange-400">
                <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
              </svg>
              <p class="text-white/80 text-xs font-semibold">
                Últimas {paquete.cuposPorSalida - 5} plazas disponibles
              </p>
            </div>
            <p class="text-xs text-white/30 pl-5">
              Próxima salida: {new Date(paquete.proximaSalida).toLocaleDateString('es-AR')}
            </p>
          </div>

          {/* Booking form */}
          <FormReserva
            client:load
            paquete={paquete}
            extras={extrasAplicables}
            whatsappPhone="5491134952847"
          />

          {/* Alternative CTA */}
          <div class="pt-4 border-t border-white/7 text-center space-y-3">
            <p class="text-xs text-white/30">¿Preguntas? Consultá directamente:</p>
            <a
              href={`https://wa.me/5491134952847?text=Hola,%20me%20interesa%20el%20paquete%20${paquete.titulo}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 w-full px-4 py-2.5 border border-white/12 hover:border-white/25 text-white/50 hover:text-white text-sm font-medium rounded-lg transition-all duration-200"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
              </svg>
              Hablar por WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Related packages */}
  <section class="section-space bg-[#0e0e0e] border-t border-white/6">
    <div class="container-gutter max-w-5xl mx-auto text-center">
      <span class="inline-block text-xs font-medium text-white/30 uppercase tracking-widest mb-3">Seguí explorando</span>
      <h2 class="text-2xl font-bold text-white mb-8">Otros paquetes que te pueden interesar</h2>
    </div>
  </section>

</BaseLayout>