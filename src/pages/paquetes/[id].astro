---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PaqueteCard from '@/components/PaqueteCard.astro';
import paquetesData from '@/data/paquetes.json';
import { webpSrcset, formatPrice } from '@/lib/utils';
import { partesTitulo, duracionLabel, fechaLarga, transporte } from '@/lib/viaje';

export function getStaticPaths() {
  return paquetesData.paquetes.map((paquete) => ({
    params: { id: paquete.slug },
    props: { paquete },
  }));
}

const { paquete } = Astro.props;
const WA = '5491134952847';
const politicas = paquetesData.politicasGlobales;

const { titular, subtitulo, cuando } = partesTitulo(paquete.titulo);
const duracion = duracionLabel(paquete);
const comoViaja = transporte(paquete.incluye);
const precioTotal = paquete.precioBase + paquete.gastosAdmin;

const fotos = (paquete.imagenes?.length ? paquete.imagenes : [paquete.imagenPrincipal]).slice(0, 5);
const heroWebp = webpSrcset(paquete.imagenPrincipal);

const whatsappMsg = `Hola, me interesa este viaje:\n\n${paquete.titulo}\nSalida: ${fechaLarga(paquete.proximaSalida)}\nPrecio: ${formatPrice(paquete.precioBase)} + ${formatPrice(paquete.gastosAdmin)} de gastos por persona\n\n¿Me pasás disponibilidad?`;
const whatsappHref = `https://wa.me/${WA}?text=${encodeURIComponent(whatsappMsg)}`;

// Otras salidas: primero las del mismo destino, despues las mas proximas
const otras = paquetesData.paquetes
  .filter((p) => p.slug !== paquete.slug)
  .sort((a, b) => {
    const mismoA = a.destino === paquete.destino ? 0 : 1;
    const mismoB = b.destino === paquete.destino ? 0 : 1;
    if (mismoA !== mismoB) return mismoA - mismoB;
    return new Date(a.proximaSalida).getTime() - new Date(b.proximaSalida).getTime();
  })
  .slice(0, 3);

// Datos estructurados (rich results de Google: precio + estrellas + fecha)
const _imgAbs = paquete.imagenPrincipal.startsWith('http')
  ? paquete.imagenPrincipal
  : `https://pucaraturismo.com.ar${paquete.imagenPrincipal}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: paquete.titulo,
  description: paquete.descripcionCorta,
  image: _imgAbs,
  sku: paquete.id,
  brand: { '@type': 'Brand', name: 'Pucará Turismo' },
  offers: {
    '@type': 'Offer',
    url: `https://pucaraturismo.com.ar/paquetes/${paquete.slug}/`,
    priceCurrency: 'ARS',
    price: precioTotal,
    availability: 'https://schema.org/InStock',
    validThrough: paquete.proximaSalida,
    seller: { '@type': 'TravelAgency', name: 'Pucará Turismo' },
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: paquete.rating,
    reviewCount: paquete.reviews,
  },
};
---

<BaseLayout
  title={`${titular} · ${cuando || fechaLarga(paquete.proximaSalida)}`}
  description={paquete.descripcionCorta}
  image={paquete.imagenPrincipal}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="det-caja">
    <nav class="det-volver" aria-label="Migas">
      <a href="/paquetes/">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
        </svg>
        Todos los paquetes
      </a>
    </nav>

    <header class="det-encabezado">
      <div class="det-sellos">
        <span class="det-sello">{duracion}</span>
        {comoViaja && <span class="det-sello">{comoViaja}</span>}
        <span class="det-sello det-sello-fecha">Sale el {cuando ? cuando.toLowerCase() : fechaLarga(paquete.proximaSalida)}</span>
      </div>
      <h1>{titular}</h1>
      {subtitulo && <p class="det-subtitulo">{subtitulo}</p>}
    </header>
  </div>

  <div class="det-caja det-cuerpo">

    <div class="det-principal">
    <div class="det-galeria" data-galeria>
      <div class="det-foto-grande">
        <picture style="display:contents">
          {heroWebp && <source type="image/webp" srcset={heroWebp} sizes="(max-width: 980px) 100vw, 740px" />}
          <img
            src={paquete.imagenPrincipal}
            alt={titular}
            width="1200" height="800"
            fetchpriority="high"
            decoding="async"
            id="det-principal"
          />
        </picture>
      </div>

      {fotos.length > 1 && (
        <div class="det-miniaturas">
          {fotos.map((src, i) => (
            <button type="button" class={`det-mini ${i === 0 ? 'activa' : ''}`} data-src={src} aria-label={`Ver foto ${i + 1} de ${titular}`}>
              <img src={src} alt="" width="300" height="200" loading="lazy" decoding="async" />
            </button>
          ))}
        </div>
      )}
    </div>

      <section class="det-bloque">
        <h2>El viaje</h2>
        <p class="det-descripcion">{paquete.descripcionLarga || paquete.descripcionCorta}</p>
      </section>

      <section class="det-bloque">
        <h2>Qué incluye</h2>
        <ul class="det-lista det-lista-si">
          {paquete.incluye.map((item) => (
            <li>
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              {item}
            </li>
          ))}
        </ul>

        {paquete.noIncluye?.length > 0 && (
          <>
            <h3 class="det-no-incluye">No incluye</h3>
            <ul class="det-lista det-lista-no">
              {paquete.noIncluye.map((item) => (
                <li>
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </>
        )}
      </section>

      {paquete.itinerario?.length > 0 && (
        <section class="det-bloque">
          <h2>Cómo es el viaje, día por día</h2>
          <ol class="det-itinerario">
            {paquete.itinerario.map((paso, i) => (
              <li>
                <span class="det-paso-n">{i + 1}</span>
                <p>{paso}</p>
              </li>
            ))}
          </ol>
        </section>
      )}

      <section class="det-bloque">
        <h2>Letra chica</h2>
        <ul class="det-politicas">
          <li>{politicas.precioEnBaseDoble}</li>
          <li>{politicas.suplementoSingle}</li>
          <li>{politicas.menoresCuatroAnios}</li>
          <li>{politicas.cocheCama}</li>
          <li>{politicas.puntosDeSubida}</li>
        </ul>
      </section>
    </div>

    <aside class="det-lateral">
      <div class="det-precio-caja">
        <span class="det-precio-rotulo">Precio por persona</span>
        <strong class="det-precio-monto">{formatPrice(paquete.precioBase)}</strong>
        <p class="det-precio-gastos">+ {formatPrice(paquete.gastosAdmin)} de gastos administrativos</p>

        <dl class="det-datos">
          <div>
            <dt>Sale el</dt>
            <dd>{cuando ? cuando.toLowerCase() : fechaLarga(paquete.proximaSalida)}</dd>
          </div>
          <div>
            <dt>Duración</dt>
            <dd>{duracion}</dd>
          </div>
          <div>
            <dt>Total por persona</dt>
            <dd class="det-total">{formatPrice(precioTotal)}</dd>
          </div>
        </dl>

        <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg det-cta" data-ga="reservar_detalle">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3.1.8.8-3-.2-.3A8.2 8.2 0 1 1 12 20.2z"/>
            <path d="M17.5 14.4c-.3-.2-1.7-.9-2-1-.3-.1-.5-.1-.7.2-.2.3-.7 1-.9 1.1-.2.2-.3.2-.6.1-.3-.2-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.5c.1-.2.2-.3.3-.5 0-.2 0-.4 0-.5 0-.2-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.4s1.1 2.8 1.2 3c.2.2 2.1 3.2 5.1 4.4.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.7-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.3-.6-.4z"/>
          </svg>
          Consultar por WhatsApp
        </a>
        <p class="det-cta-nota">Te contestamos de lunes a viernes, de 9 a 19 hs.</p>
      </div>
    </aside>
  </div>

  {otras.length > 0 && (
    <section class="section-space franja">
      <div class="det-caja">
        <div class="cabecera-seccion">
          <div>
            <h2>Otras salidas</h2>
            <p>Por si esta fecha no te sirve.</p>
          </div>
          <a href="/paquetes/" class="btn btn-secondary">Ver todas</a>
        </div>
        <div class="det-otras">
          {otras.map((p) => <PaqueteCard paquete={p} whatsappPhone={WA} />)}
        </div>
      </div>
    </section>
  )}

  <div class="det-barra-movil">
    <div>
      <span>desde</span>
      <strong>{formatPrice(paquete.precioBase)}</strong>
    </div>
    <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Consultar</a>
  </div>

</BaseLayout>

<style>
  .det-caja { max-width: 1180px; margin: 0 auto; padding: 0 1.25rem; }
  @media (min-width: 768px) { .det-caja { padding: 0 2rem; } }

  .det-volver { padding-top: 6rem; }
  @media (min-width: 768px) { .det-volver { padding-top: 7.5rem; } }
  .det-volver a {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-size: 0.875rem; color: var(--tinta-2); font-weight: 500;
  }
  .det-volver a:hover { color: var(--naranja-tinta); }

  .det-encabezado { padding: 1.1rem 0 1.5rem; }
  .det-sellos { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.8rem; }
  .det-sello {
    font-size: 0.78rem; font-weight: 600;
    padding: 0.25rem 0.65rem;
    border-radius: 100px;
    background: var(--fondo);
    border: 1px solid var(--linea);
    color: var(--tinta-2);
  }
  .det-sello-fecha { background: var(--naranja-suave); border-color: #f8dcc6; color: var(--naranja-tinta); }
  .det-encabezado h1 { margin-bottom: 0.3rem; }
  .det-subtitulo { font-size: 1.1rem; color: var(--tinta-2); margin: 0; }

  /* ── Galería ── */
  .det-galeria { margin-bottom: 2rem; }
  .det-foto-grande {
    border-radius: var(--radio);
    overflow: hidden;
    aspect-ratio: 3 / 2;
    background: var(--fondo);
  }
  .det-foto-grande img { width: 100%; height: 100%; object-fit: cover; }

  .det-miniaturas { display: flex; gap: 0.6rem; margin-top: 0.6rem; overflow-x: auto; scrollbar-width: none; }
  .det-miniaturas::-webkit-scrollbar { display: none; }
  .det-mini {
    flex: 0 0 110px;
    height: 74px;
    padding: 0;
    border: 1px solid var(--linea);
    border-radius: var(--radio-ch);
    overflow: hidden;
    background: none;
    cursor: pointer;
    transition: border-color 0.15s ease, opacity 0.15s ease;
    opacity: 0.75;
  }
  .det-mini img { width: 100%; height: 100%; object-fit: cover; }
  .det-mini:hover { opacity: 1; }
  .det-mini.activa { border-color: var(--tinta); opacity: 1; }

  /* ── Cuerpo ── */
  .det-cuerpo {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-bottom: 3.5rem;
  }
  @media (min-width: 980px) {
    .det-cuerpo { grid-template-columns: minmax(0, 1fr) 340px; gap: 3rem; align-items: start; }
  }

  .det-bloque { padding-bottom: 2rem; margin-bottom: 2rem; border-bottom: 1px solid var(--linea); }
  .det-bloque:last-child { border-bottom: none; margin-bottom: 0; }
  .det-bloque h2 { font-size: 1.3rem; margin-bottom: 0.9rem; }
  .det-descripcion { font-size: 1rem; line-height: 1.7; margin: 0; }

  .det-lista { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.55rem; }
  @media (min-width: 640px) { .det-lista { grid-template-columns: 1fr 1fr; column-gap: 1.5rem; } }
  .det-lista li {
    display: flex; align-items: flex-start; gap: 0.55rem;
    font-size: 0.95rem; color: var(--tinta);
  }
  .det-lista svg { flex: none; margin-top: 0.18rem; }
  .det-lista-si svg { color: var(--verde); }
  .det-lista-no { margin-top: 0.5rem; }
  .det-lista-no li { color: var(--tinta-2); }
  .det-lista-no svg { color: var(--tinta-3); }
  .det-no-incluye { font-size: 1rem; margin: 1.5rem 0 0.4rem; color: var(--tinta-2); }

  .det-itinerario { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; }
  .det-itinerario li { display: flex; gap: 0.9rem; align-items: flex-start; }
  .det-paso-n {
    flex: none;
    width: 27px; height: 27px;
    border-radius: 50%;
    background: var(--fondo);
    border: 1px solid var(--linea);
    color: var(--tinta-2);
    display: grid; place-items: center;
    font-size: 0.8rem; font-weight: 650;
  }
  .det-itinerario p { margin: 0; font-size: 0.95rem; line-height: 1.6; padding-top: 0.15rem; }

  .det-politicas { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.7rem; }
  .det-politicas li {
    font-size: 0.9rem;
    color: var(--tinta-2);
    padding-left: 1.1rem;
    position: relative;
    max-width: 66ch;
  }
  .det-politicas li::before {
    content: '';
    position: absolute; left: 0; top: 0.6em;
    width: 5px; height: 5px; border-radius: 50%;
    background: var(--linea-fuerte);
  }

  /* ── Caja de precio ── */
  .det-lateral { position: static; }
  @media (min-width: 980px) { .det-lateral { position: sticky; top: 92px; } }

  .det-precio-caja {
    background: var(--papel);
    border: 1px solid var(--linea-fuerte);
    border-radius: var(--radio);
    padding: 1.4rem;
  }
  .det-precio-rotulo { display: block; font-size: 0.85rem; color: var(--tinta-2); }
  .det-precio-monto {
    display: block;
    font-size: 2.3rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: var(--tinta);
    margin-top: 0.1rem;
  }
  .det-precio-gastos { font-size: 0.85rem; color: var(--tinta-3); margin: 0.25rem 0 0; }

  .det-datos { margin: 1.25rem 0; padding: 1rem 0 0; border-top: 1px solid var(--linea); display: grid; gap: 0.6rem; }
  .det-datos > div { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; }
  .det-datos dt { font-size: 0.875rem; color: var(--tinta-2); }
  .det-datos dd { margin: 0; font-size: 0.9rem; font-weight: 600; color: var(--tinta); text-align: right; }
  .det-total { color: var(--naranja-tinta) !important; }

  .det-cta { width: 100%; }
  .det-cta-nota { font-size: 0.78rem; color: var(--tinta-3); margin: 0.6rem 0 0; text-align: center; }

  .det-otras { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; }

  /* ── Barra fija en el celular ── */
  .det-barra-movil {
    position: fixed;
    left: 0; right: 0; bottom: 0;
    z-index: 45;
    background: rgba(255,255,255,0.96);
    backdrop-filter: blur(12px);
    border-top: 1px solid var(--linea);
    padding: 0.7rem 1.1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  @media (min-width: 980px) { .det-barra-movil { display: none; } }
  /* La burbuja flotante taparia el boton de la barra: en el detalle sobra,
     porque la barra ya tiene su propio CTA de WhatsApp */
  @media (max-width: 979px) {
    :global(#wa-float) { display: none !important; }
    /* Que la barra fija no tape el final del pie */
    :global(body) { padding-bottom: 76px; }
  }
  .det-barra-movil span { display: block; font-size: 0.75rem; color: var(--tinta-3); line-height: 1; }
  .det-barra-movil strong { font-size: 1.25rem; font-weight: 700; letter-spacing: -0.03em; }
  .det-barra-movil .btn { flex: none; }
</style>

<script>
  const galeria = document.querySelector('[data-galeria]');
  if (galeria) {
    const principal = galeria.querySelector<HTMLImageElement>('#det-principal');
    const minis = galeria.querySelectorAll<HTMLButtonElement>('.det-mini');

    minis.forEach((mini) => {
      mini.addEventListener('click', () => {
        const src = mini.dataset.src;
        if (!src || !principal) return;
        // La foto grande puede venir de un <source> webp: lo sacamos para que
        // el cambio de src se vea de verdad.
        principal.closest('picture')?.querySelector('source')?.remove();
        principal.src = src;
        galeria.querySelector('.det-mini.activa')?.classList.remove('activa');
        mini.classList.add('activa');
      });
    });
  }
</script>
