---
import BaseLayout from '@/layouts/BaseLayout.astro';
import destinosData from '@/data/destinos.json';

const destinos = destinosData.destinos;
---

<BaseLayout 
  title="Destinos turísticos del norte argentino"
  description="Explora los mejores destinos del norte argentino: Salinas Grandes, Iguazú, Mendoza, Córdoba y más."
>
  {/* Header section */}
  <section class="bg-gradient-to-b from-slate-900 to-slate-800 text-white pt-24 pb-12">
    <div class="container-gutter">
      <h1 class="mb-4">Nuestros Destinos</h1>
      <p class="text-xl text-slate-100 max-w-2xl">
        Conoce los lugares más hermosos del norte argentino. Desde montañas hasta cataratas.
      </p>
    </div>
  </section>

  {/* Destinations grid */}
  <section class="section-space bg-white">
    <div class="container-gutter">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {destinos.map((destino) => (
          <a 
            href={`/destinos/${destino.slug}`}
            class="group card overflow-hidden hover:shadow-xl transition-all duration-300 flex flex-col h-full"
          >
            {/* Image */}
            <div class="relative overflow-hidden aspect-video bg-slate-200">
              <img 
                src={destino.imagen}
                alt={destino.nombre}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
            </div>

            {/* Content */}
            <div class="flex-1 p-6 flex flex-col">
              <div class="mb-2">
                <p class="text-sm text-orange-600 font-semibold uppercase">{destino.provincia}</p>
                <h3 class="text-2xl font-bold text-slate-900 group-hover:text-orange-500 transition-colors">
                  {destino.nombre}
                </h3>
              </div>

              <p class="text-slate-600 mb-4 flex-1">
                {destino.descripcionCorta}
              </p>

              {/* Climate */}
              <div class="bg-slate-50 rounded-lg p-3 mb-4 border border-slate-200">
                <p class="text-xs text-slate-600 mb-2 font-semibold">CLIMA</p>
                <div class="flex items-center justify-between">
                  <div>
                    <p class="text-sm text-slate-500">Min:</p>
                    <p class="font-bold text-slate-900">{destino.clima.tempMin}°C</p>
                  </div>
                  <div class="text-center">
                    <p class="text-2xl">🌡️</p>
                  </div>
                  <div>
                    <p class="text-sm text-slate-500">Max:</p>
                    <p class="font-bold text-slate-900">{destino.clima.tempMax}°C</p>
                  </div>
                </div>
              </div>

              {/* Attractions count */}
              <div class="flex items-center gap-2 text-sm text-slate-600">
                <span>📍 {destino.atractivos.length} atractivos</span>
              </div>

              {/* CTA */}
              <div class="mt-4 pt-4 border-t border-slate-200">
                <span class="inline-flex items-center text-orange-600 font-semibold group-hover:gap-2 transition-all">
                  Explorar
                  <span class="ml-2">→</span>
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* CTA section */}
  <section class="section-space bg-orange-50">
    <div class="container-gutter max-w-3xl mx-auto text-center">
      <h2 class="mb-4">¿No sabes cuál elegir?</h2>
      <p class="text-lg text-slate-700 mb-8">
        Usa nuestro recomendador para encontrar tu destino perfecto.
      </p>
      <a 
        href="/Pucara-Turismo/#recomendador"
        class="btn btn-primary btn-lg"
      >
        🎯 Ir al recomendador
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .card {
    animation: fadeIn 0.4s ease-out forwards;
  }
</style>

