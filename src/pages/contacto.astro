---
import BaseLayout from '@/layouts/BaseLayout.astro';

const WA = '5491134952847';
const WA_LINDO = '+54 9 11 3495-2847';
const EMAIL = 'info@pucaraturismo.com.ar';
const INSTAGRAM = 'https://www.instagram.com/pucaraturismo.ok/';
const FACEBOOK = 'https://www.facebook.com/Pucaraturismo';
const DIRECCION = 'Cnel. Pablo Zufriategui 830, Ituzaingó, Buenos Aires';
const MAPS_URL = 'https://www.google.com/maps/place/Pucara+Turismo/@-34.6587,-58.6667,17z';
const MAPS_EMBED = 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3278.933!2d-58.669!3d-34.6587!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x95bcbfbb0b2d0731%3A0xf982c6a695aecca4!2sPucara%20Turismo!5e0!3m2!1ses-419!2sar!4v1717000000000';
const RESENA_URL = 'https://g.page/r/CaTMrpWmxoL5EBM/review';

const waHref = `https://wa.me/${WA}?text=${encodeURIComponent('Hola Pucará Turismo, quiero consultar sobre un viaje.')}`;

const horarios = [
  { dia: 'Lunes a viernes', hora: '9:00 a 19:00 hs' },
  { dia: 'Sábado', hora: '9:00 a 13:00 hs' },
  { dia: 'Domingo', hora: 'Cerrado', cerrado: true },
];
---

<BaseLayout
  title="Contacto"
  description="Escribinos por WhatsApp y te respondemos en minutos. También podés visitarnos en Ituzaingó, Buenos Aires. Te asesoramos sin compromiso sobre cualquier paquete."
>

  {/* ── Encabezado + canal principal ───────────────────────────────── */}
  <section class="con-caja con-arriba">
    <div class="con-intro">
      <h1>Hablemos de tu próximo viaje</h1>
      <p>
        El camino más rápido es WhatsApp: te contesta una persona del equipo, no un robot.
        Contanos a dónde querés ir y cuántos son, y te pasamos disponibilidad y precio.
      </p>
    </div>

    <a href={waHref} target="_blank" rel="noopener noreferrer" class="con-wa">
      <span class="con-wa-icono">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3.1.8.8-3-.2-.3A8.2 8.2 0 1 1 12 20.2z"/>
          <path d="M17.5 14.4c-.3-.2-1.7-.9-2-1-.3-.1-.5-.1-.7.2-.2.3-.7 1-.9 1.1-.2.2-.3.2-.6.1-.3-.2-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.5c.1-.2.2-.3.3-.5 0-.2 0-.4 0-.5 0-.2-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.4s1.1 2.8 1.2 3c.2.2 2.1 3.2 5.1 4.4.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.7-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.3-.6-.4z"/>
        </svg>
      </span>
      <span class="con-wa-texto">
        <span class="con-wa-rotulo">Escribinos por WhatsApp</span>
        <strong class="con-wa-numero">{WA_LINDO}</strong>
      </span>
      <svg class="con-wa-flecha" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
      </svg>
    </a>
  </section>

  {/* ── Canales + dónde estamos ────────────────────────────────────── */}
  <section class="con-caja con-cuerpo">

    <div class="con-columna">
      <h2>Otros canales</h2>
      <ul class="con-canales">
        <li>
          <a href={INSTAGRAM} target="_blank" rel="noopener noreferrer">
            <span class="con-icono con-icono-ig">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/>
              </svg>
            </span>
            <span class="con-canal-texto">
              <strong>Instagram</strong>
              <span>@pucaraturismo.ok</span>
              <span class="con-canal-nota">Fotos y videos de cada salida</span>
            </span>
          </a>
        </li>
        <li>
          <a href={FACEBOOK} target="_blank" rel="noopener noreferrer">
            <span class="con-icono con-icono-fb">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
              </svg>
            </span>
            <span class="con-canal-texto">
              <strong>Facebook</strong>
              <span>Pucará Turismo</span>
              <span class="con-canal-nota">Novedades y promociones</span>
            </span>
          </a>
        </li>
        <li>
          <a href={`mailto:${EMAIL}`}>
            <span class="con-icono con-icono-mail">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="4" width="20" height="16" rx="2"/><polyline points="22,6 12,13 2,6"/>
              </svg>
            </span>
            <span class="con-canal-texto">
              <strong>Email</strong>
              <span>{EMAIL}</span>
              <span class="con-canal-nota">Para consultas más largas</span>
            </span>
          </a>
        </li>
      </ul>

      <h2 class="con-h2-separado">Horarios de atención</h2>
      <ul class="con-horarios">
        {horarios.map((h) => (
          <li class={h.cerrado ? 'cerrado' : ''}>
            <span>{h.dia}</span>
            <span>{h.hora}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="con-columna">
      <h2>Dónde estamos</h2>

      <div class="con-direccion">
        <span class="con-icono con-icono-mapa">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
          </svg>
        </span>
        <div>
          <p class="con-direccion-texto">{DIRECCION}</p>
          <a href={MAPS_URL} target="_blank" rel="noopener noreferrer" class="con-enlace">
            Abrir en Google Maps
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
            </svg>
          </a>
        </div>
      </div>

      <div class="con-mapa">
        <iframe
          src={MAPS_EMBED}
          title="Mapa con la ubicación de Pucará Turismo en Ituzaingó"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>

      <p class="con-aviso">
        Los viajes no salen de la oficina: tenemos varios puntos de subida en el Gran Buenos Aires
        y coordinamos el tuyo cuando reservás.
      </p>
    </div>
  </section>

  {/* ── Reseñas ────────────────────────────────────────────────────── */}
  <section class="section-space franja">
    <div class="con-caja">
      <div class="con-resena">
        <div class="con-resena-texto">
          <span class="antetitulo">¿Ya viajaste con nosotros?</span>
          <h2>Contanos cómo te fue</h2>
          <p>
            Las reseñas son lo que hace que alguien que no nos conoce se anime a subirse al bus.
            Si viajaste con Pucará, dejanos tu opinión en Google: te lleva dos minutos y nos ayuda muchísimo.
          </p>
          <div class="con-resena-acciones">
            <a href={RESENA_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
              Dejar mi reseña en Google
            </a>
            <a href="/resenas/" class="btn btn-secondary btn-lg">Ver lo que dicen otros</a>
          </div>
          <p class="con-resena-dato">
            <span class="con-estrellas" aria-hidden="true">
              {Array(5).fill(0).map(() => (
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              ))}
            </span>
            <strong>4,8</strong> sobre más de 480 reseñas
          </p>
        </div>

        <figure class="con-qr">
          <div class="con-qr-marco">
            <img src="/qr-resenas.svg" alt="Código QR para dejar una reseña de Pucará Turismo en Google" width="200" height="200" loading="lazy" />
          </div>
          <figcaption>Escaneá con la cámara del celular</figcaption>
        </figure>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .con-caja { max-width: 1180px; margin: 0 auto; padding: 0 1.25rem; }
  @media (min-width: 768px) { .con-caja { padding: 0 2rem; } }

  /* ── Arriba ── */
  .con-arriba {
    padding-top: 7rem;
    padding-bottom: 2.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 768px) { .con-arriba { padding-top: 8.5rem; } }
  @media (min-width: 940px) { .con-arriba { grid-template-columns: 1fr 420px; gap: 3rem; } }

  .con-intro h1 { margin-bottom: 0.8rem; }
  .con-intro p { font-size: 1.02rem; max-width: 52ch; margin: 0; }

  /* El canal principal se ve como lo que es: el boton mas importante */
  .con-wa {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: #157f3d;
    color: #fff;
    border-radius: var(--radio);
    padding: 1.15rem 1.3rem;
    transition: background-color 0.16s ease;
  }
  .con-wa:hover { background: #11682f; }
  .con-wa-icono {
    width: 50px; height: 50px;
    flex: none;
    border-radius: 50%;
    background: rgba(255,255,255,0.18);
    display: grid; place-items: center;
  }
  .con-wa-texto { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .con-wa-rotulo { font-size: 0.82rem; color: rgba(255,255,255,0.95); }
  .con-wa-numero { font-size: 1.22rem; font-weight: 700; letter-spacing: -0.02em; }
  .con-wa-flecha { flex: none; opacity: 0.9; }

  /* ── Cuerpo ── */
  .con-cuerpo {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-bottom: 3.5rem;
  }
  @media (min-width: 880px) { .con-cuerpo { grid-template-columns: 1fr 1fr; gap: 3rem; } }

  .con-columna h2 { font-size: 1.15rem; margin-bottom: 1rem; }
  .con-h2-separado { margin-top: 2.25rem; }

  .con-canales { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.6rem; }
  .con-canales a {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--linea);
    border-radius: var(--radio-ch);
    background: var(--papel);
    transition: border-color 0.16s ease;
  }
  .con-canales a:hover { border-color: var(--tinta-3); }

  .con-icono {
    width: 40px; height: 40px;
    flex: none;
    border-radius: 10px;
    display: grid; place-items: center;
    border: 1px solid transparent;
  }
  .con-icono-ig { background: #fdf0f6; border-color: #f7dbe9; color: #c13584; }
  .con-icono-fb { background: #eef3fd; border-color: #d9e4fa; color: #1877f2; }
  .con-icono-mail { background: var(--naranja-suave); border-color: #f8dcc6; color: var(--naranja-fuerte); }
  .con-icono-mapa { background: var(--naranja-suave); border-color: #f8dcc6; color: var(--naranja-fuerte); }

  .con-canal-texto { display: flex; flex-direction: column; min-width: 0; }
  .con-canal-texto strong { font-size: 0.95rem; font-weight: 650; color: var(--tinta); }
  .con-canal-texto > span { font-size: 0.9rem; color: var(--tinta-2); overflow: hidden; text-overflow: ellipsis; }
  .con-canal-nota { font-size: 0.8rem !important; color: var(--tinta-3) !important; }

  .con-horarios {
    list-style: none; padding: 0; margin: 0;
    border: 1px solid var(--linea);
    border-radius: var(--radio-ch);
    background: var(--papel);
    overflow: hidden;
  }
  .con-horarios li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 1rem;
    font-size: 0.92rem;
    border-top: 1px solid var(--linea);
  }
  .con-horarios li:first-child { border-top: none; }
  .con-horarios li span:first-child { color: var(--tinta-2); }
  .con-horarios li span:last-child { font-weight: 600; color: var(--tinta); }
  .con-horarios li.cerrado span:last-child { color: var(--tinta-3); font-weight: 400; }

  /* ── Dónde estamos ── */
  .con-direccion {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    padding: 1rem;
    border: 1px solid var(--linea);
    border-radius: var(--radio-ch);
    background: var(--papel);
    margin-bottom: 0.8rem;
  }
  .con-direccion-texto { font-size: 0.95rem; color: var(--tinta); margin: 0 0 0.3rem; }
  .con-enlace {
    display: inline-flex; align-items: center; gap: 0.3rem;
    font-size: 0.88rem; font-weight: 600; color: var(--naranja-tinta);
  }
  .con-enlace:hover { text-decoration: underline; }

  .con-mapa {
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--fondo);
  }
  .con-mapa iframe { width: 100%; height: 100%; border: 0; display: block; }

  .con-aviso { font-size: 0.85rem; color: var(--tinta-3); margin: 0.8rem 0 0; }

  /* ── Reseñas ── */
  .con-resena {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 820px) { .con-resena { grid-template-columns: 1fr 260px; gap: 3rem; } }

  .con-resena-texto h2 { margin-bottom: 0.6rem; }
  .con-resena-texto p { font-size: 1rem; max-width: 56ch; }
  .con-resena-acciones { display: flex; gap: 0.75rem; flex-wrap: wrap; margin: 1.4rem 0 1.1rem; }
  @media (max-width: 420px) { .con-resena-acciones .btn { width: 100%; } }

  .con-resena-dato {
    display: flex; align-items: center; gap: 0.45rem; flex-wrap: wrap;
    font-size: 0.9rem; margin: 0; color: var(--tinta-2);
  }
  .con-estrellas { display: inline-flex; gap: 1px; color: var(--naranja); }
  .con-resena-dato strong { color: var(--tinta); }

  .con-qr { margin: 0; text-align: center; }
  .con-qr-marco {
    background: var(--papel);
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    padding: 1.1rem;
    display: inline-block;
    color: var(--tinta);
  }
  .con-qr img { width: 200px; height: 200px; display: block; }
  .con-qr figcaption { font-size: 0.82rem; color: var(--tinta-3); margin-top: 0.6rem; }
</style>
