---
import BaseLayout from '@layouts/BaseLayout.astro';
import CTASection from '@components/CTASection.astro';

const faqs = [
  {
    categoria: 'Reservas',
    preguntas: [
      {
        pregunta: '¿Cómo hago una reserva?',
        respuesta: 'Puedes reservar directamente desde nuestro sitio web usando el botón "Reservar" en cualquier paquete. Completa el formulario y ¡listo! Te contactaremos para confirmar.'
      },
      {
        pregunta: '¿Necesito depósito?',
        respuesta: 'Sí, solicitamos una seña del 30% para confirmar tu reserva. El resto se paga 15 días antes del viaje.'
      },
      {
        pregunta: '¿Puedo cambiar las fechas de mi viaje?',
        respuesta: 'Claro, sin problema. Contáctanos con al menos 2 semanas de anticipación y buscaremos una solución.'
      }
    ]
  },
  {
    categoria: 'Pagos',
    preguntas: [
      {
        pregunta: '¿Qué métodos de pago aceptan?',
        respuesta: 'Aceptamos transferencia bancaria, tarjeta de crédito/débito, efectivo en Argentina y MercadoPago.'
      },
      {
        pregunta: '¿Es seguro pagar en línea?',
        respuesta: 'Totalmente seguro. Usamos encriptación SSL y processadores de pago certificados.'
      },
      {
        pregunta: '¿Hay cuotas disponibles?',
        respuesta: 'Sí, ofrecemos hasta 12 cuotas sin interés con tarjetas de crédito seleccionadas.'
      }
    ]
  },
  {
    categoria: 'Viajes',
    preguntas: [
      {
        pregunta: '¿Qué incluye el precio?',
        respuesta: 'Nuestros precios incluyen transporte, alojamiento, desayunos, guía profesional y seguro. Algunos extras son opcionales.'
      },
      {
        pregunta: '¿Necesito visa?',
        respuesta: 'No, todos nuestros viajes son dentro de Argentina. Solo necesitas DNI/Pasaporte.'
      },
      {
        pregunta: '¿Es seguro viajar ahora?',
        respuesta: 'Absolutamente. Seguimos todos los protocolos de seguridad vigentes y nuestros destinos son totalmente seguros.'
      }
    ]
  },
  {
    categoria: 'Cancelaciones',
    preguntas: [
      {
        pregunta: '¿Puedo cancelar mi reserva?',
        respuesta: 'Sí, con más de 30 días de anticipación devolvemos tu depósito completo. Entre 15-30 días: 50%. Menos de 15 días: sin devolución.'
      },
      {
        pregunta: '¿Qué pasa si se cancela el viaje?',
        respuesta: 'En caso de cancelación por nuestra parte, devolvemos el 100% o reprogramamos a otra fecha sin costo.'
      },
      {
        pregunta: '¿Hay seguro de viaje?',
        respuesta: 'Sí, incluimos un seguro básico. Puedes contratar un seguro adicional por $8.000 por persona.'
      }
    ]
  },
  {
    categoria: 'Menores',
    preguntas: [
      {
        pregunta: '¿Pueden ir menores de edad?',
        respuesta: 'Claro, tenemos paquetes familiares. Menores de 12 años tienen descuento del 20% acompañados de adulto.'
      },
      {
        pregunta: '¿Hay actividades para niños?',
        respuesta: 'Sí, seleccionamos destinos y actividades aptas para todas las edades. Consúltanos sobre opciones.'
      }
    ]
  }
];
---

<BaseLayout 
  title="Preguntas Frecuentes - Pucará Turismo"
  description="Respuestas a las preguntas más comunes sobre nuestros viajes, reservas y políticas"
>
  <!-- Hero -->
  <section class="pt-32 pb-20 px-6 bg-gradient-to-b from-orange-50 to-white">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-slate-900 mb-6">Preguntas Frecuentes</h1>
      <p class="text-lg md:text-xl text-slate-600 leading-relaxed">
        Encuentra respuestas rápidas a las preguntas más comunes
      </p>
    </div>
  </section>

  <!-- FAQs por Categoría -->
  <section class="py-20 px-6 max-w-4xl mx-auto">
    {faqs.map(categoria => (
      <div class="mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-8 flex items-center gap-3">
          <span class="w-10 h-10 rounded-full bg-orange-500 text-white flex items-center justify-center text-sm font-bold shadow-md">
            {categoria.categoria[0]}
          </span>
          {categoria.categoria}
        </h2>

        <div class="space-y-3.5">
          {categoria.preguntas.map(item => (
            <details class="faq-item">
              <summary class="faq-pregunta">
                {item.pregunta}
              </summary>
              <div class="faq-respuesta">
                {item.respuesta}
              </div>
            </details>
          ))}
        </div>
      </div>
    ))}
  </section>

  <!-- Contacto Extra -->
  <section class="py-20 px-6 bg-gradient-to-b from-white to-slate-50">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl font-bold text-slate-900 mb-6">¿No encuentras respuesta?</h2>
      <p class="text-lg text-slate-600 mb-8 leading-relaxed">
        Contáctanos directamente y resolveremos tu duda en menos de 2 horas
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/Pucara-Turismo/contacto"
          class="px-8 py-3.5 bg-orange-500 hover:bg-orange-600 text-white font-semibold rounded-lg transition-all duration-300 hover:shadow-lg hover:scale-105"
        >
          Enviar Mensaje
        </a>
        <a
          href="https://wa.me/5491150000000?text=Tengo%20una%20pregunta%20sobre%20sus%20viajes"
          class="px-8 py-3.5 bg-white border-2 border-orange-500 text-orange-600 hover:bg-orange-50 hover:shadow-lg hover:scale-105 font-semibold rounded-lg transition-all duration-300"
        >
          WhatsApp 💬
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTASection
    titulo="Ahora que tienes tus respuestas..."
    descripcion="Está listo para el viaje que siempre soñaste"
    boton="Explorar Paquetes"
    enlace="/paquetes"
    tipo="gradient"
  />
</BaseLayout>

<style>
  @reference "../styles/globals.css";
  .faq-item {
    @apply border border-slate-200 rounded-lg overflow-hidden hover:border-orange-400 hover:shadow-md transition-all duration-300;
  }

  .faq-item[open] {
    @apply border-orange-400 bg-orange-50 shadow-md;
  }

  .faq-pregunta {
    @apply block w-full px-6 py-4 font-semibold text-slate-900 cursor-pointer hover:text-orange-600 transition-all duration-300 flex items-center gap-2;
  }

  .faq-pregunta::-webkit-details-marker {
    display: none;
  }

  .faq-pregunta::before {
    content: '+';
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    background: #ff9800;
    color: white;
    border-radius: 50%;
    font-weight: bold;
    font-size: 14px;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .faq-item[open] .faq-pregunta::before {
    content: '−';
    transform: rotate(180deg);
  }

  .faq-respuesta {
    padding: 1.5rem;
    color: #334155;
    border-top: 1px solid #e2e8f0;
    line-height: 1.75;
    animation: slideDown 0.3s ease-out;
    font-size: 0.95rem;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-slideDown {
    animation: slideDown 0.3s ease-out;
  }
</style>







