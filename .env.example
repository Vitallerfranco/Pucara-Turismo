# Supabase
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# WhatsApp (for integration with meta business)
WHATSAPP_BUSINESS_PHONE_ID=
WHATSAPP_BUSINESS_ACCESS_TOKEN=

# Stripe (if using for payments)
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Email (SendGrid or similar)
SENDGRID_API_KEY=

# Analytics (optional)
GOOGLE_ANALYTICS_ID=
HOTJAR_ID=

# Dashboard de viajes en el hosting (DonWeb)
# De donde el build baja los paquetes cargados desde el panel
PUCARA_API_URL=https://pucaraturismo.com.ar/api/paquetes.php
# Tiene que ser EXACTAMENTE el mismo valor que 'token_build' en dashboard/admin/config.php
PUCARA_API_TOKEN=
